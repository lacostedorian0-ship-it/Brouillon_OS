+void attach() {
+  s_attached = true;
+  s_launch = k_noItem;
+  s.now = s.last = clockMs();
+  g_boil = s.now / 120;
+  buildApps();
+  s.userBrightness =
+      GlobalPreferences::SharedGlobalPreferences()->brightnessLevel();
+  s.brightness = s.userBrightness;
+  bool first = !s.initialized;
+  if (first) {
+    s.initialized = true;
+    s.random = 0x9E3779B9u ^ Ion::random();
+    if (s.random == 0) {
+      s.random = 1;
+    }
+    s.ledOn = s.kevinTalks = true;
+    s.page = 0;
+    s.selected = 0;
+    s.selectStart = s.now;
+    s.lastLaunched = -1;
+    s.lastInput = s.now;
+    s.foodSeen = Food::produced();
+    s.planeBest = 0;
+    setMode(Mode::Cover);
+    Kev::reset();
+    s.k.x = 400;  // he jumps in after the cover
+  } else {
+    // Back from an app
+    s.lastInput = s.now;
+    s.turning = false;
+    if (s.page >= s.numberOfPages) {
+      s.page = 0;
+      s.selected = 0;
+    }
+    int last = s.lastLaunched;
+    if (last == -2) {
+      // after the panic button: the page is smoothed out again
+      setMode(Mode::Page);
+      s.returnStart = s.now;
+      Kev::goToSlot(s.selected, false);
+      Kev::say("Il est parti ? On a eu chaud.", 2600);
+    } else if (last >= 0 && last < s_numberOfApps) {
+      setMode(Mode::Page);
+      s.page = pageOfApp(last);
+      s.selected = slotOfApp(last);
+      s.selectStart = s.now;
+      Kev::comeBack(last);
+    } else {
+      setMode(Mode::Page);
+    }
+    if (Food::produced() != s.foodSeen) {
+      collectComments();
+      setMode(Mode::Copie);
+      s.copieStart = s.now;
+    }
+  }
+  Shell::frame();
+#if !PLATFORM_DEVICE
+  const char* shots = getenv("BROUILLON_SHOTS");
+  if (shots && first) {
+    s_shotDir = shots;
+    photoSession();
+    exit(0);
+  }
+#endif
+}
+
+void detach() {
+  s.detachTime = clockMs();
+  restoreLed();
+  if (s.brightness != s.userBrightness && !s_fake) {
+    Ion::Backlight::setBrightness(s.userBrightness);
+  }
+  s.brightness = s.userBrightness;
+  s_attached = false;
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+int framePeriod() {
+  if (s.mode == Mode::Trousse || s.mode == Mode::Reglages) {
+    return 60;
+  }
+  return 30;
+}
+
+bool frame() {
+  if (!s_attached) {
+    return false;
+  }
+  s.now = clockMs();
+  g_boil = s.now / 120;
+  float dt = (s.now - s.last) / 1000.f;
+  if (dt > 0.1f) {
+    dt = 0.1f;
+  }
+  s.last = s.now;
+  if (s.mode == Mode::Cover && s.now - s.modeStart > k_coverDuration) {
+    setMode(Mode::Page);
+    s.turnFrom = -1;
+    s.turnTo = 0;
+    s.turnStart = s.now;
+    s.turning = true;
+    s.k.st = KState::Idle;
+    s.k.x = 330;
+    s.k.y = 140;
+    Kev::goToSlot(0, true);
+    toast("OK : ouvrir une appli\nBo\xC3\xAEte \xC3\xA0 outils : la trousse\n"
+          "Effacer : PANIQUE (le prof arrive)",
+          4500);
+  }
+  if (s.turning && s.now - s.turnStart > k_turnDuration) {
+    s.turning = false;
+    if (s.k.st == KState::Hang) {
+      float edge = s.turnTo > s.turnFrom ? 8 : 312;
+      s.k.x = edge;
+      s.k.y = 140;
+      s.k.st = KState::Idle;
+      Kev::goToSlot(s.selected, true);
+    }
+  }
+  if (s.mode >= Mode::Cocotte) {
+    Trousse::update(dt);
+  }
+  Kev::update(dt);
+  updateParticles(dt);
+  updateLed();
+  updateBacklight();
+  return true;
+}
+
+void render(Band& band) {
+  Rect area = band.area();
+  if (s.crumpling) {
+    float k = static_cast<float>(s.now - s.crumpleStart) / k_crumpleDuration;
+    renderCrumple(band, k > 1 ? 1 : k);
+    return;
+  }
+  int shakeY = 0;
+  if (s.now < s.shakeUntil) {
+    shakeY = static_cast<int>(hash(s.now / 30) % 7) - 3;
+  }
+  if (shakeY != 0) {
+    band.begin({area.x, area.y + shakeY, area.w, area.h});
+  }
+  switch (s.mode) {
+    case Mode::Cover:
+      renderCover(band, s.now - s.modeStart);
+      break;
+    case Mode::Copie:
+      renderCopie(band);
+      hand(band, "OK : r\xC3\xA9\x63up\xC3\xA9rer ma copie", 300, 226,
+           rgb(0x9AA4C0), Small, 3, Align::Right, -1,
+           (s.now - s.copieStart) > 12000 ? 256 : 0);
+      break;
+    case Mode::Page:
+    case Mode::Trousse:
+    case Mode::Reglages:
+      if (s.turning) {
+        renderTurn(band);
+      } else {
+        drawPageContent(band, s.page, s.mode == Mode::Page);
+        Kev::renderGag(band);
+      }
+      drawParticles(band);
+      if (s.mode == Mode::Trousse || s.mode == Mode::Reglages) {
+        Trousse::renderMenu(band);
+      }
+      break;
+    default:
+      Trousse::render(band);
+      drawParticles(band);
+      break;
+  }
+  if (shakeY != 0) {
+    // the band was drawn shifted: put it back where it belongs
+    band.begin(area);
+  }
+  // Un-crumpling after the panic button
+  if (s.mode == Mode::Page && s.lastLaunched == -2 &&
+      s.now - s.returnStart < k_uncrumpleDuration) {
+    float k = 1 - static_cast<float>(s.now - s.returnStart) / k_uncrumpleDuration;
+    for (int i = 0; i < 10; i++) {
+      float a = i * 0.63f + 0.2f;
+      pen(band, 160, 120, 160 + cosf(a) * 260, 120 + sinf(a) * 260, 1,
+          rgb(0xB8B2A0), 700 + i, 3.f, static_cast<int>(200 * k));
+    }
+  }
+  // The ink flood that opens an app
+  if (s.flooding) {
+    Rect r = cellRect(s.selected);
+    float k = static_cast<float>(s.now - s.floodStart) / k_floodDuration;
+    if (k > 1) {
+      k = 1;
+    }
+    float radius = 6 + 420 * k * k;
+    blob(band, r.x + r.w / 2, r.y + 46, radius, 0.25f, rgb(k_ink), 800);
+    blob(band, r.x + r.w / 2 - 6, r.y + 40, radius * 0.6f, 0.3f,
+         rgb(0x15296E), 801);
+  }
+  if (s.now < s.toastUntil && !s.flooding) {
+    uint32_t t = s.now - s.toastStart;
+    int alpha = t < 150 ? static_cast<int>(t * 256 / 150) : 256;
+    if (s.toastUntil - s.now < 300) {
+      alpha = static_cast<int>((s.toastUntil - s.now) * 256 / 300);
+    }
+    stickyNote(band, s.toast, alpha);
+  }
+}
+
+bool handleEvent(Event e) {
+  if (!s_attached) {
+    return false;
+  }
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Shift || e == Events::Alpha || e == Events::AlphaCaps) {
+    return false;
+  }
+  s.now = clockMs();
+  s.lastInput = s.now;
+  if (s.flooding || s.crumpling) {
+    return true;
+  }
+  if (s.k.st == KState::Sleep) {
+    s.k.st = KState::Idle;
+    s.k.t0 = s.now;
+    Kev::say("Hein ? Quoi ? Je dormais pas.", 2000);
+  }
+  if (e == Events::Backspace && s.mode != Mode::Dessin) {
+    panic();
+    return true;
+  }
+  if (e == Events::Plus || e == Events::Minus) {
+    if (s.mode != Mode::Dessin && s.mode != Mode::Masque) {
+      brightness(e == Events::Plus ? 1 : -1);
+      return true;
+    }
+  }
+  if (s.mode == Mode::Cover) {
+    if (s.now - s.modeStart > 400) {
+      s.modeStart = s.now - k_coverDuration;
+    }
+    return true;
+  }
+  if (s.mode == Mode::Copie) {
+    if (e == Events::OK || e == Events::EXE || e == Events::Back ||
+        e == Events::Home) {
+      setMode(Mode::Page);
+      if (s.k.gag != -1) {
+        s.k.gagStart = s.now + 300;
+      }
+    }
+    return true;
+  }
+  if (s.mode == Mode::Trousse || s.mode == Mode::Reglages) {
+    return Trousse::handleMenu(e);
+  }
+  if (s.mode >= Mode::Cocotte) {
+    return Trousse::handleEvent(e);
+  }
+  // The page
+  if (s.turning) {
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right || e == Events::Up ||
+      e == Events::Down) {
+    move(e == Events::Left ? -1 : (e == Events::Right ? 1 : 0),
+         e == Events::Up ? -1 : (e == Events::Down ? 1 : 0));
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    int app = appAtSlot(s.page, s.selected);
+    if (app >= 0) {
+      diveAndLaunch(app);
+    }
+    return true;
+  }
+  if (e == Events::Toolbox) {
+    setMode(Mode::Trousse);
+    return true;
+  }
+  if (e == Events::XNT) {
+    Kev::poke();
+    return true;
+  }
+  if (e == Events::Var) {
+    Kev::erase();
+    return true;
+  }
+  if (e == Events::Ans) {
+    if (!Kev::busy()) {
+      s.k.st = KState::Dance;
+      s.k.t0 = s.now;
+      Kev::say("Ans = Ambiance Nocturne Sp\xC3\xA9\x63iale !", 2400);
+    }
+    return true;
+  }
+  if (e == Events::Back || e == Events::Home) {
+    if (s.page != 0) {
+      turnTo(0, 0);
+    } else if (!Kev::busy()) {
+      select(0);
+      Kev::say("On est d\xC3\xA9j\xC3\xA0 au d\xC3\xA9\x62ut, chef.", 1800);
+    }
+    return true;
+  }
+  const char* t = e.text();
+  if (t && t[0] >= '1' && t[0] <= '9' && t[1] == 0) {
+    int page = t[0] - '1';
+    if (page < s.numberOfPages) {
+      turnTo(page, 0);
+    }
+    return true;
+  }
+  if (e == Events::Zero) {
+    // the selected doodle's nickname, by Kevin
+    int app = appAtSlot(s.page, s.selected);
+    if (app >= 0 && !Kev::busy()) {
+      Kev::say(appNickname(s_apps[app].name), 2800);
+    }
+    return true;
+  }
+  return false;
+}
+
