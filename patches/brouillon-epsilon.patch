+#pragma once
+
+#include <stdint.h>
+
+/* BROUILLON eats your calculations: the Calculation app pushes every new
+ * result here, and the creature of the home screen eats them when you come
+ * back. A small ring: only the last results are kept, as text. */
+
+namespace Home {
+namespace Doodle {
+namespace Food {
+
+constexpr int k_textSize = 28;
+constexpr int k_ringSize = 8;
+
+struct Entry {
+  char input[k_textSize];
+  char output[k_textSize];
+};
+
+void push(const char* input, const char* output);
+// Number of results pushed since the calculator started
+uint32_t produced();
+// Entry number `index`, nullptr if it is not kept anymore
+const Entry* at(uint32_t index);
+
+}  // namespace Food
+}  // namespace Doodle
+}  // namespace Home
diff --git a/epsilon/apps/home/doodle/gfx.cpp b/epsilon/apps/home/doodle/gfx.cpp
new file mode 100644
index 0000000000..76b5bdaeb0
--- /dev/null
+++ b/epsilon/apps/home/doodle/gfx.cpp
@@ -0,0 +1,983 @@
+#include "gfx.h"
+
+#include <kandinsky/context.h>
+#include <math.h>
+#include <omg/memory.h>
+#include <string.h>
+
+namespace Home {
+namespace Doodle {
+
+namespace {
+
+KDColor s_band[k_screenWidth * Band::k_maxHeight];
+
+/* Text is rasterized white on black in this buffer; the green channel is
+ * then the glyph coverage. The buffer also receives decompressed .nwa
+ * icons (never at the same time). */
+constexpr int k_textBufferWidth = 320;
+constexpr int k_textBufferHeight = 18;
+KDColor s_textBuffer[k_textBufferWidth * k_textBufferHeight];
+
+constexpr int k_nwaIconWidth = 55;
+constexpr int k_nwaIconHeight = 56;
+static_assert(k_nwaIconWidth * k_nwaIconHeight <=
+                  k_textBufferWidth * k_textBufferHeight,
+              "The text buffer must be able to hold a .nwa icon");
+
+class TextContext : public KDContext {
+ public:
+  TextContext()
+      : KDContext(KDPointZero,
+                  KDRect(0, 0, k_textBufferWidth, k_textBufferHeight)) {}
+
+ protected:
+  void pushRect(KDRect rect, const KDColor* pixels) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      memcpy(s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x(),
+             pixels + j * rect.width(), rect.width() * sizeof(KDColor));
+    }
+  }
+  void pushRectUniform(KDRect rect, KDColor color) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      KDColor* r = s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x();
+      for (KDCoordinate i = 0; i < rect.width(); i++) {
+        r[i] = color;
+      }
+    }
+  }
+  void pullRect(KDRect rect, KDColor* pixels) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      memcpy(pixels + j * rect.width(),
+             s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x(),
+             rect.width() * sizeof(KDColor));
+    }
+  }
+};
+
+/* Epsilon's fonts draw accented letters as a base letter followed by a
+ * combining mark (the translations are stored that way). The BROUILLON texts
+ * are written with precomposed letters: decompose them on the fly. */
+const char* decompose(const char* s, char* buffer, int size) {
+  // Base letter and combining mark (second byte after 0xCC) for C3 80..9F
+  static constexpr char k_base[32] = {
+      'A', 'A', 'A', 0,   'A', 0,   0,   'C', 'E', 'E', 'E', 'E', 'I', 'I',
+      'I', 'I', 0,   0,   'O', 'O', 'O', 0,   'O', 0,   0,   'U', 'U', 'U',
+      'U', 0,   0,   0};
+  static constexpr uint8_t k_mark[32] = {
+      0x80, 0x81, 0x82, 0,    0x88, 0,    0,    0xA7, 0x80, 0x81, 0x82,
+      0x88, 0x80, 0x81, 0x82, 0x88, 0,    0,    0x80, 0x81, 0x82, 0,
+      0x88, 0,    0,    0x80, 0x81, 0x82, 0x88, 0,    0,    0};
+  bool needed = false;
+  for (const char* p = s; *p; p++) {
+    if (static_cast<uint8_t>(*p) == 0xC3) {
+      needed = true;
+      break;
+    }
+  }
+  if (!needed) {
+    return s;
+  }
+  int n = 0;
+  for (const char* p = s; *p && n < size - 4; p++) {
+    uint8_t c = static_cast<uint8_t>(*p);
+    uint8_t next = static_cast<uint8_t>(p[1]);
+    if (c == 0xC3 && next >= 0x80 && next <= 0xBF) {
+      int i = next >= 0xA0 ? next - 0xA0 : next - 0x80;
+      if (k_base[i]) {
+        char base = k_base[i];
+        if (next >= 0xA0) {
+          base = base - 'A' + 'a';
+        }
+        buffer[n++] = base;
+        buffer[n++] = static_cast<char>(0xCC);
+        buffer[n++] = static_cast<char>(k_mark[i]);
+        p++;
+        continue;
+      }
+    }
+    buffer[n++] = *p;
+  }
+  buffer[n] = 0;
+  return buffer;
+}
+
+// Renders s into the text buffer; returns its size
+KDSize rasterize(const char* s, KDFont::Size font) {
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  int h = size.height() < k_textBufferHeight ? size.height()
+                                             : k_textBufferHeight;
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite,
+                  .backgroundColor = KDBlack,
+                  .font = font});
+  return KDSize(w, h);
+}
+
+/* Coverage (0..256) of the pixel (px, py) of a rounded rectangle, 0 outside.
+ * Only the corners are curved; they are antialiased on one pixel. */
+int roundCoverage(const Rect& r, int radius, int px, int py) {
+  int cx, cy;
+  if (px < r.x + radius) {
+    cx = r.x + radius;
+  } else if (px >= r.right() - radius) {
+    cx = r.right() - radius - 1;
+  } else {
+    return 256;
+  }
+  if (py < r.y + radius) {
+    cy = r.y + radius;
+  } else if (py >= r.bottom() - radius) {
+    cy = r.bottom() - radius - 1;
+  } else {
+    return 256;
+  }
+  float dx = (px - cx) + (px < cx ? 0.5f : -0.5f);
+  float dy = (py - cy) + (py < cy ? 0.5f : -0.5f);
+  float d = sqrtf(dx * dx + dy * dy);
+  float edge = radius + 0.5f - d;
+  if (edge >= 1.f) {
+    return 256;
+  }
+  if (edge <= 0.f) {
+    return 0;
+  }
+  return static_cast<int>(edge * 256);
+}
+
+}  // namespace
+
+/* ------------------------------------------------------------------ rect */
+
+Rect Rect::intersection(const Rect& o) const {
+  int x0 = x > o.x ? x : o.x;
+  int y0 = y > o.y ? y : o.y;
+  int x1 = right() < o.right() ? right() : o.right();
+  int y1 = bottom() < o.bottom() ? bottom() : o.bottom();
+  return {x0, y0, x1 - x0, y1 - y0};
+}
+
+/* ------------------------------------------------------------------ band */
+
+void Band::begin(Rect area) {
+  m_area = area;
+  m_clip = area;
+}
+
+bool Band::setClip(Rect r) {
+  m_clip = r.intersection(m_area);
+  return !m_clip.isEmpty();
+}
+
+KDColor* Band::row(int y) const {
+  return s_band + (y - m_area.y) * m_area.w - m_area.x;
+}
+
+const KDColor* Band::pixels() const { return s_band; }
+
+/* ---------------------------------------------------------------- colors */
+
+KDColor mix(KDColor a, KDColor b, int t) {
+  if (t <= 0) {
+    return a;
+  }
+  if (t >= 256) {
+    return b;
+  }
+  return KDColor::Blend(b, a, static_cast<uint8_t>(t > 255 ? 255 : t));
+}
+
+KDColor hsv(int hue, int sat, int val) {
+  hue %= 360;
+  if (hue < 0) {
+    hue += 360;
+  }
+  int region = hue / 60;
+  int rem = (hue - region * 60) * 255 / 60;
+  int p = (val * (255 - sat)) >> 8;
+  int q = (val * (255 - ((sat * rem) >> 8))) >> 8;
+  int t = (val * (255 - ((sat * (255 - rem)) >> 8))) >> 8;
+  int r, g, b;
+  switch (region) {
+    case 0: r = val; g = t; b = p; break;
+    case 1: r = q; g = val; b = p; break;
+    case 2: r = p; g = val; b = t; break;
+    case 3: r = p; g = q; b = val; break;
+    case 4: r = t; g = p; b = val; break;
+    default: r = val; g = p; b = q; break;
+  }
+  return KDColor::RGB888(r, g, b);
+}
+
+/* ------------------------------------------------------------ primitives */
+
+void fill(Band& b, Rect r, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    if (alpha >= 256) {
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = c;
+      }
+    } else {
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = KDColor::Blend(c, row[x], static_cast<uint8_t>(alpha));
+      }
+    }
+  }
+}
+
+void frame(Band& b, Rect r, KDColor c, int alpha) {
+  fill(b, {r.x, r.y, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.bottom() - 1, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.y + 1, 1, r.h - 2}, c, alpha);
+  fill(b, {r.right() - 1, r.y + 1, 1, r.h - 2}, c, alpha);
+}
+
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  if (radius <= 0) {
+    return fill(b, r, c, alpha);
+  }
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    bool cornerRow = y < r.y + radius || y >= r.bottom() - radius;
+    for (int x = z.x; x < z.right(); x++) {
+      int a = alpha;
+      if (cornerRow) {
+        int cov = roundCoverage(r, radius, x, y);
+        if (cov == 0) {
+          continue;
+        }
+        a = (alpha * cov) >> 8;
+      }
+      blendPixel(row + x, c, a);
+    }
+  }
+}
+
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  Rect inner = {r.x + 1, r.y + 1, r.w - 2, r.h - 2};
+  int innerRadius = radius > 1 ? radius - 1 : 0;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      int outer = roundCoverage(r, radius, x, y);
+      if (outer == 0) {
+        continue;
+      }
+      int in = inner.contains(x, y) ? roundCoverage(inner, innerRadius, x, y)
+                                    : 0;
+      int cov = outer - in;
+      if (cov > 0) {
+        blendPixel(row + x, c, (alpha * cov) >> 8);
+      }
+    }
+  }
+}
+
+void disc(Band& b, int cx, int cy, int radius, KDColor c, int alpha) {
+  roundFill(b, {cx - radius, cy - radius, 2 * radius + 1, 2 * radius + 1},
+            radius, c, alpha);
+}
+
+void ellipse(Band& b, float cx, float cy, float rx, float ry, KDColor c,
+             int alpha) {
+  if (rx <= 0.2f || ry <= 0.2f || alpha <= 0) {
+    return;
+  }
+  Rect r = {static_cast<int>(floorf(cx - rx - 1)),
+            static_cast<int>(floorf(cy - ry - 1)),
+            static_cast<int>(2 * rx + 3), static_cast<int>(2 * ry + 3)};
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  float irx = 1.f / rx, iry = 1.f / ry;
+  float minR = rx < ry ? rx : ry;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    float dy = (y + 0.5f - cy) * iry;
+    for (int x = z.x; x < z.right(); x++) {
+      float dx = (x + 0.5f - cx) * irx;
+      float d = dx * dx + dy * dy;
+      if (d >= 1.3f) {
+        continue;
+      }
+      // Distance to the edge, in pixels (approximately)
+      float edge = (1.f - sqrtf(d)) * minR + 0.5f;
+      if (edge <= 0.f) {
+        continue;
+      }
+      int a = edge >= 1.f ? alpha : static_cast<int>(alpha * edge);
+      blendPixel(row + x, c, a);
+    }
+  }
+}
+
+void line(Band& b, float x0, float y0, float x1, float y1, float thickness,
+          KDColor c, int alpha) {
+  float r = thickness * 0.5f;
+  float minX = (x0 < x1 ? x0 : x1) - r - 1, maxX = (x0 > x1 ? x0 : x1) + r + 1;
+  float minY = (y0 < y1 ? y0 : y1) - r - 1, maxY = (y0 > y1 ? y0 : y1) + r + 1;
+  Rect z = Rect{static_cast<int>(floorf(minX)), static_cast<int>(floorf(minY)),
+                static_cast<int>(maxX - minX) + 2,
+                static_cast<int>(maxY - minY) + 2}
+               .intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  float dx = x1 - x0, dy = y1 - y0;
+  float len2 = dx * dx + dy * dy;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    float py = y + 0.5f;
+    for (int x = z.x; x < z.right(); x++) {
+      float px = x + 0.5f;
+      float t = len2 > 0 ? ((px - x0) * dx + (py - y0) * dy) / len2 : 0;
+      t = t < 0 ? 0 : (t > 1 ? 1 : t);
+      float ex = x0 + t * dx - px, ey = y0 + t * dy - py;
+      float d = sqrtf(ex * ex + ey * ey);
+      float edge = r + 0.5f - d;
+      if (edge <= 0) {
+        continue;
+      }
+      blendPixel(row + x, c, edge >= 1 ? alpha : static_cast<int>(alpha * edge));
+    }
+  }
+}
+
+void arc(Band& b, float cx, float cy, float r, float thickness, int half,
+         KDColor c, int alpha) {
+  float outer = r + thickness * 0.5f;
+  Rect z = Rect{static_cast<int>(floorf(cx - outer - 1)),
+                static_cast<int>(floorf(cy - outer - 1)),
+                static_cast<int>(2 * outer + 3),
+                static_cast<int>(2 * outer + 3)}
+               .intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    float py = y + 0.5f - cy;
+    if ((half == 1 && py > 0.5f) || (half == 2 && py < -0.5f)) {
+      continue;
+    }
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      float px = x + 0.5f - cx;
+      float d = sqrtf(px * px + py * py);
+      float edge = thickness * 0.5f + 0.5f - fabsf(d - r);
+      if (edge <= 0) {
+        continue;
+      }
+      blendPixel(row + x, c, edge >= 1 ? alpha : static_cast<int>(alpha * edge));
+    }
+  }
+}
+
+int polygonCrossings(const float* xs, const float* ys, int n, float y,
+                     float* out, int max) {
+  int count = 0;
+  for (int i = 0, j = n - 1; i < n; j = i++) {
+    float yi = ys[i], yj = ys[j];
+    if ((yi <= y && yj > y) || (yj <= y && yi > y)) {
+      float x = xs[i] + (y - yi) * (xs[j] - xs[i]) / (yj - yi);
+      if (count < max) {
+        // Insertion sort
+        int k = count++;
+        while (k > 0 && out[k - 1] > x) {
+          out[k] = out[k - 1];
+          k--;
+        }
+        out[k] = x;
+      }
+    }
+  }
+  return count & ~1;
+}
+
+void polygon(Band& b, const float* xs, const float* ys, int n, KDColor c,
+             int alpha) {
+  const Rect& clip = b.clip();
+  float crossings[16];
+  for (int y = clip.y; y < clip.bottom(); y++) {
+    int k = polygonCrossings(xs, ys, n, y + 0.5f, crossings, 16);
+    KDColor* row = b.row(y);
+    for (int i = 0; i < k; i += 2) {
+      int x0 = static_cast<int>(crossings[i] + 0.5f);
+      int x1 = static_cast<int>(crossings[i + 1] + 0.5f);
+      x0 = x0 < clip.x ? clip.x : x0;
+      x1 = x1 > clip.right() ? clip.right() : x1;
+      for (int x = x0; x < x1; x++) {
+        blendPixel(row + x, c, alpha);
+      }
+    }
+  }
+}
+
+void heart(Band& b, int x, int y, int scale, KDColor c, int alpha) {
+  static constexpr uint16_t k_heart[8] = {
+      0b0110001100000000, 0b1111011110000000, 0b1111111110000000,
+      0b1111111110000000, 0b0111111100000000, 0b0011111000000000,
+      0b0001110000000000, 0b0000100000000000};
+  bitmap(b, k_heart, 9, 8, x, y, scale, c, alpha);
+}
+
+void bitmap(Band& b, const uint16_t* rows, int w, int h, int x, int y,
+            int scale, KDColor c, int alpha) {
+  Rect z = Rect{x, y, w * scale, h * scale}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    uint16_t bits = rows[(yy - y) / scale];
+    KDColor* row = b.row(yy);
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int bx = (xx - x) / scale;
+      if (bits & (0x8000 >> bx)) {
+        blendPixel(row + xx, c, alpha);
+      }
+    }
+  }
+}
+
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size) {
+  Rect z = Rect{x, y, size, size}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  const uint8_t* data = app.iconData();
+  uint32_t dataSize = app.iconSize();
+  if (data == nullptr || dataSize == 0) {
+    roundFill(b, {x, y, size, size}, size / 5, rgb(0x7B2FF7));
+    return;
+  }
+  OMG::Memory::Decompress(data, reinterpret_cast<uint8_t*>(s_textBuffer),
+                          dataSize,
+                          k_nwaIconWidth * k_nwaIconHeight * sizeof(KDColor));
+  Rect r = {x, y, size, size};
+  int radius = size / 5;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src =
+        s_textBuffer + ((yy - y) * k_nwaIconHeight / size) * k_nwaIconWidth;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int cov = roundCoverage(r, radius, xx, yy);
+      if (cov) {
+        blendPixel(row + xx, src[(xx - x) * k_nwaIconWidth / size], cov);
+      }
+    }
+  }
+}
+
+bool gameIconTexture(const Ion::ExternalApps::App& app, uint16_t* out, int w,
+                     int h) {
+  const uint8_t* data = app.iconData();
+  uint32_t dataSize = app.iconSize();
+  if (data == nullptr || dataSize == 0) {
+    return false;
+  }
+  OMG::Memory::Decompress(data, reinterpret_cast<uint8_t*>(s_textBuffer),
+                          dataSize,
+                          k_nwaIconWidth * k_nwaIconHeight * sizeof(KDColor));
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      out[y * w + x] = s_textBuffer[(y * k_nwaIconHeight / h) * k_nwaIconWidth +
+                                    x * k_nwaIconWidth / w];
+    }
+  }
+  return true;
+}
+
+/* ------------------------------------------------------------------ text */
+
+int glyphWidth(KDFont::Size font) { return KDFont::GlyphMaxWidth(font); }
+int glyphHeight(KDFont::Size font) { return KDFont::GlyphHeight(font); }
+
+int textWidth(const char* s, KDFont::Size font) {
+  char buffer[160];
+  s = decompose(s, buffer, sizeof(buffer));
+  return KDFont::Font(font)->stringSize(s).width();
+}
+
+void text(Band& b, const char* s, int x, int y, KDColor c, KDFont::Size font,
+          Align align, int maxWidth, int alpha) {
+  if (s == nullptr || s[0] == 0 || alpha <= 0) {
+    return;
+  }
+  char decomposed[160];
+  s = decompose(s, decomposed, sizeof(decomposed));
+  int h = glyphHeight(font);
+  if (y >= b.clip().bottom() || y + h <= b.clip().y) {
+    return;
+  }
+  /* Keep only the glyphs that fit (combining marks and UTF-8 continuation
+   * bytes take no room) */
+  constexpr int k_maxBytes = 120;
+  char buffer[k_maxBytes + 4];
+  int gw = glyphWidth(font);
+  int limit =
+      (maxWidth < k_textBufferWidth ? maxWidth : k_textBufferWidth) / gw;
+  if (limit <= 0) {
+    return;
+  }
+  {
+    int glyphs = 0;
+    int i = 0;
+    const uint8_t* u = reinterpret_cast<const uint8_t*>(s);
+    while (u[i]) {
+      bool mark = (u[i] == 0xCC) || (u[i] == 0xCD && u[i + 1] < 0xB0);
+      if ((u[i] & 0xC0) != 0x80 && !mark) {
+        if (glyphs == limit || i >= k_maxBytes - 4) {
+          break;
+        }
+        glyphs++;
+      }
+      i++;
+    }
+    if (u[i]) {
+      memcpy(buffer, s, i);
+      buffer[i] = 0;
+      s = buffer;
+    }
+  }
+  int w = KDFont::Font(font)->stringSize(s).width();
+  if (w > k_textBufferWidth) {
+    w = k_textBufferWidth;
+  }
+  if (align == Align::Center) {
+    x -= w / 2;
+  } else if (align == Align::Right) {
+    x -= w;
+  }
+  Rect z = Rect{x, y, w, h}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  rasterize(s, font);
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src = s_textBuffer + (yy - y) * k_textBufferWidth - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[xx].green();
+      if (a) {
+        a = a >= 252 ? 256 : a;
+        blendPixel(row + xx, c, (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void outlinedText(Band& b, const char* s, int x, int y, KDColor c,
+                  KDFont::Size font, Align align) {
+  KDColor dark = rgb(0x0A0614);
+  text(b, s, x - 1, y, dark, font, align, k_screenWidth, 200);
+  text(b, s, x + 1, y, dark, font, align, k_screenWidth, 200);
+  text(b, s, x, y - 1, dark, font, align, k_screenWidth, 200);
+  text(b, s, x, y + 1, dark, font, align, k_screenWidth, 200);
+  text(b, s, x, y, c, font, align);
+}
+
+void bigText(Band& b, const char* s, int x, int y, int scale, KDColor c,
+             Align align, int alpha) {
+  if (s == nullptr || s[0] == 0 || alpha <= 0) {
+    return;
+  }
+  char decomposed[96];
+  s = decompose(s, decomposed, sizeof(decomposed));
+  KDSize size = KDFont::Font(KDFont::Size::Large)->stringSize(s);
+  int w = (size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth);
+  int h = size.height() < k_textBufferHeight ? size.height()
+                                             : k_textBufferHeight;
+  if (align == Align::Center) {
+    x -= w * scale / 2;
+  } else if (align == Align::Right) {
+    x -= w * scale;
+  }
+  Rect z = Rect{x, y, w * scale, h * scale}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  rasterize(s, KDFont::Size::Large);
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src = s_textBuffer + ((yy - y) / scale) * k_textBufferWidth;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[(xx - x) / scale].green();
+      if (a) {
+        a = a >= 252 ? 256 : a;
+        blendPixel(row + xx, c, (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void glyphMask(const char* s, uint32_t* mask) {
+  for (int i = 0; i < 32; i++) {
+    mask[i] = 0;
+  }
+  if (s == nullptr || s[0] == 0) {
+    return;
+  }
+  char decomposed[48];
+  s = decompose(s, decomposed, sizeof(decomposed));
+  KDSize size = rasterize(s, KDFont::Size::Large);
+  int w = size.width(), h = size.height();
+  if (w <= 0 || h <= 0) {
+    return;
+  }
+  // Fit in 26 x 22 texels, centred, keeping the aspect ratio
+  float scale = 26.f / w;
+  if (22.f / h < scale) {
+    scale = 22.f / h;
+  }
+  int dw = static_cast<int>(w * scale), dh = static_cast<int>(h * scale);
+  int ox = (32 - dw) / 2, oy = (32 - dh) / 2 + 1;
+  for (int y = 0; y < dh; y++) {
+    int sy0 = static_cast<int>(y / scale), sy1 = static_cast<int>((y + 1) / scale);
+    for (int x = 0; x < dw; x++) {
+      int sx0 = static_cast<int>(x / scale), sx1 = static_cast<int>((x + 1) / scale);
+      int best = 0;
+      for (int sy = sy0; sy <= sy1 && sy < h; sy++) {
+        for (int sx = sx0; sx <= sx1 && sx < w; sx++) {
+          int g = s_textBuffer[sy * k_textBufferWidth + sx].green();
+          best = g > best ? g : best;
+        }
+      }
+      if (best > 140) {
+        mask[oy + y] |= 0x80000000u >> (ox + x);
+      }
+    }
+  }
+}
+
+
+/* ------------------------------------------------------------ hand-drawn */
+
+uint32_t g_boil = 0;
+
+namespace {
+uint32_t mixHash(uint32_t x) {
+  x ^= x >> 16;
+  x *= 0x7feb352dU;
+  x ^= x >> 15;
+  x *= 0x846ca68bU;
+  x ^= x >> 16;
+  return x;
+}
+float unit(uint32_t h) { return (h & 0xFFFF) / 32767.5f - 1.f; }
+}  // namespace
+
+float wobble(uint32_t seed) { return unit(mixHash(seed * 0x9E3779B1u + g_boil * 0x85EBCA77u)); }
+
+void pen(Band& b, float x0, float y0, float x1, float y1, float thickness,
+         KDColor c, uint32_t seed, float shake, int alpha) {
+  float r = thickness * 0.5f + shake * 2.f + 2.f;
+  float minY = (y0 < y1 ? y0 : y1) - r, maxY = (y0 > y1 ? y0 : y1) + r;
+  float minX = (x0 < x1 ? x0 : x1) - r, maxX = (x0 > x1 ? x0 : x1) + r;
+  const Rect& clip = b.clip();
+  if (maxY < clip.y || minY > clip.bottom() || maxX < clip.x ||
+      minX > clip.right()) {
+    return;
+  }
+  float ax = x0 + shake * wobble(seed * 4 + 1);
+  float ay = y0 + shake * wobble(seed * 4 + 2);
+  float bx = x1 + shake * wobble(seed * 4 + 3);
+  float by = y1 + shake * wobble(seed * 4 + 4);
+  float dx = bx - ax, dy = by - ay;
+  float len = sqrtf(dx * dx + dy * dy);
+  if (len < 6.f) {
+    line(b, ax, ay, bx, by, thickness, c, alpha);
+    return;
+  }
+  // A hand never draws straight: bend the stroke a little in its middle
+  float bend = shake * 0.9f * wobble(seed * 4 + 5) * (len < 40 ? len / 40 : 1);
+  float mx = (ax + bx) * 0.5f - dy / len * bend;
+  float my = (ay + by) * 0.5f + dx / len * bend;
+  line(b, ax, ay, mx, my, thickness, c, alpha);
+  line(b, mx, my, bx, by, thickness, c, alpha);
+}
+
+void penPath(Band& b, const float* xs, const float* ys, int n, bool closed,
+             float thickness, KDColor c, uint32_t seed, float shake,
+             float progress, int alpha) {
+  if (n < 2 || progress <= 0) {
+    return;
+  }
+  int segments = closed ? n : n - 1;
+  float total = 0;
+  for (int i = 0; i < segments; i++) {
+    int j = (i + 1) % n;
+    total += sqrtf((xs[j] - xs[i]) * (xs[j] - xs[i]) +
+                   (ys[j] - ys[i]) * (ys[j] - ys[i]));
+  }
+  float budget = total * (progress > 1 ? 1 : progress);
+  for (int i = 0; i < segments && budget > 0; i++) {
+    int j = (i + 1) % n;
+    float l = sqrtf((xs[j] - xs[i]) * (xs[j] - xs[i]) +
+                    (ys[j] - ys[i]) * (ys[j] - ys[i]));
+    float k = l > budget ? budget / l : 1.f;
+    // Shared vertices shake together: the path stays connected
+    float sx0 = shake * wobble(seed * 64 + i * 2);
+    float sy0 = shake * wobble(seed * 64 + i * 2 + 1);
+    float sx1 = shake * wobble(seed * 64 + j * 2);
+    float sy1 = shake * wobble(seed * 64 + j * 2 + 1);
+    float x1 = xs[i] + (xs[j] - xs[i]) * k, y1 = ys[i] + (ys[j] - ys[i]) * k;
+    line(b, xs[i] + sx0, ys[i] + sy0, x1 + sx1 * k, y1 + sy1 * k, thickness, c,
+         alpha);
+    budget -= l;
+  }
+}
+
+void penCircle(Band& b, float cx, float cy, float rx, float ry,
+               float thickness, KDColor c, uint32_t seed, float progress,
+               float shake, int alpha) {
+  float pad = thickness + shake * 3 + rx * 0.2f + 3;
+  const Rect& clip = b.clip();
+  if (cy + ry + pad < clip.y || cy - ry - pad > clip.bottom() ||
+      cx + rx + pad < clip.x || cx - rx - pad > clip.right()) {
+    return;
+  }
+  constexpr int k_n = 28;
+  // 1.12 turns: the pen overshoots its start, and the radius drifts
+  float turns = 1.12f * (progress > 1 ? 1 : progress);
+  int steps = static_cast<int>(k_n * turns) + 1;
+  float start = unit(mixHash(seed)) * 3.14159f;
+  float drift = 0.10f * unit(mixHash(seed + 7));
+  float px = 0, py = 0;
+  for (int i = 0; i <= steps; i++) {
+    float t = static_cast<float>(i) / k_n;
+    if (t > turns) {
+      t = turns;
+    }
+    float a = start + t * 6.28318f;
+    float k = 1.f + drift * t + 0.035f * shake * wobble(seed * 32 + i);
+    float x = cx + cosf(a) * rx * k, y = cy + sinf(a) * ry * k;
+    if (i > 0) {
+      line(b, px, py, x, y, thickness, c, alpha);
+    }
+    px = x;
+    py = y;
+  }
+}
+
+void blob(Band& b, float cx, float cy, float r, float roughness, KDColor c,
+          uint32_t seed, int alpha) {
+  const Rect& clip = b.clip();
+  float big = r * (1 + roughness * 1.3f) + 2;
+  if (cy + big < clip.y || cy - big > clip.bottom() || cx + big < clip.x ||
+      cx - big > clip.right()) {
+    return;
+  }
+  constexpr int k_n = 40;
+  float xs[k_n], ys[k_n];
+  float p1 = unit(mixHash(seed)) * 3, p2 = unit(mixHash(seed + 1)) * 3,
+        p3 = unit(mixHash(seed + 2)) * 3;
+  for (int i = 0; i < k_n; i++) {
+    float a = i * 6.28318f / k_n;
+    float k = 1 + roughness * (0.55f * sinf(3 * a + p1) +
+                               0.35f * sinf(5 * a + p2) +
+                               0.22f * sinf(11 * a + p3));
+    xs[i] = cx + cosf(a) * r * k;
+    ys[i] = cy + sinf(a) * r * k;
+  }
+  polygon(b, xs, ys, k_n, c, alpha);
+}
+
+void hatch(Band& b, Rect r, int spacing, KDColor c, uint32_t seed, int alpha) {
+  Rect saved = b.clip();
+  if (!b.setClip(r.intersection(saved))) {
+    b.setClip(saved);
+    return;
+  }
+  for (int k = -r.h; k < r.w; k += spacing) {
+    float x0 = r.x + k, y0 = r.bottom();
+    pen(b, x0, y0, x0 + r.h, r.y, 1.f, c, seed + k, 0.6f, alpha);
+  }
+  b.setClip(saved);
+}
+
+namespace {
+// Byte length of the glyph cluster starting at s (letter + combining marks)
+int clusterLength(const char* s) {
+  const uint8_t* u = reinterpret_cast<const uint8_t*>(s);
+  if (!u[0]) {
+    return 0;
+  }
+  int n = 1;
+  while ((u[n] & 0xC0) == 0x80) {
+    n++;
+  }
+  // Combining marks (U+0300..U+036F: CC 80 .. CD AF) stay with the letter
+  while ((u[n] == 0xCC) || (u[n] == 0xCD && u[n + 1] < 0xB0)) {
+    n += 2;
+  }
+  return n;
+}
+}  // namespace
+
+int glyphCount(const char* s) {
+  char decomposed[200];
+  s = decompose(s, decomposed, sizeof(decomposed));
+  int n = 0;
+  while (*s) {
+    s += clusterLength(s);
+    n++;
+  }
+  return n;
+}
+
+int hand(Band& b, const char* s, int x, int y, KDColor c, KDFont::Size font,
+         uint32_t seed, Align align, int count, int alpha) {
+  if (s == nullptr || s[0] == 0) {
+    return 0;
+  }
+  char decomposed[200];
+  s = decompose(s, decomposed, sizeof(decomposed));
+  int gw = glyphWidth(font), gh = glyphHeight(font);
+  int total = 0;
+  for (const char* p = s; *p; p += clusterLength(p)) {
+    total++;
+  }
+  int w = total * gw;
+  if (align == Align::Center) {
+    x -= w / 2;
+  } else if (align == Align::Right) {
+    x -= w;
+  }
+  if (y - 2 >= b.clip().bottom() || y + gh + 2 <= b.clip().y) {
+    return w;
+  }
+  int i = 0;
+  char glyph[12];
+  for (const char* p = s; *p && (count < 0 || i < count); i++) {
+    int n = clusterLength(p);
+    if (n > 10) {
+      n = 10;
+    }
+    memcpy(glyph, p, n);
+    glyph[n] = 0;
+    p += n;
+    if (glyph[0] == ' ') {
+      continue;
+    }
+    uint32_t h = mixHash(seed * 131 + i * 7);
+    int dy = static_cast<int>(h % 3) - 1;
+    int dx = (h >> 8) % 5 == 0 ? 1 : 0;
+    text(b, glyph, x + i * gw + dx, y + dy, c, font, Align::Left, k_screenWidth,
+         alpha);
+  }
+  return w;
+}
+
+int bigHand(Band& b, const char* s, int x, int y, int scale, KDColor c,
+            uint32_t seed, Align align, int count, int alpha) {
+  if (s == nullptr || s[0] == 0) {
+    return 0;
+  }
+  char decomposed[120];
+  s = decompose(s, decomposed, sizeof(decomposed));
+  int gw = glyphWidth(KDFont::Size::Large) * scale;
+  int gh = glyphHeight(KDFont::Size::Large) * scale;
+  int total = 0;
+  for (const char* p = s; *p; p += clusterLength(p)) {
+    total++;
+  }
+  int w = total * gw;
+  if (align == Align::Center) {
+    x -= w / 2;
+  } else if (align == Align::Right) {
+    x -= w;
+  }
+  if (y - 2 * scale >= b.clip().bottom() || y + gh + 2 * scale <= b.clip().y) {
+    return w;
+  }
+  int i = 0;
+  char glyph[12];
+  for (const char* p = s; *p && (count < 0 || i < count); i++) {
+    int n = clusterLength(p);
+    if (n > 10) {
+      n = 10;
+    }
+    memcpy(glyph, p, n);
+    glyph[n] = 0;
+    p += n;
+    if (glyph[0] == ' ') {
+      continue;
+    }
+    uint32_t h = mixHash(seed * 131 + i * 7);
+    int dy = (static_cast<int>(h % 3) - 1) * scale;
+    bigText(b, glyph, x + i * gw, y + dy, scale, c, Align::Left, alpha);
+  }
+  return w;
+}
+
+void gameSticker(Band& b, const Ion::ExternalApps::App& app, float cx,
+                 float cy, int size, float angle) {
+  constexpr int k_border = 3;
+  float half = size * 0.5f + k_border;
+  float reach = half * 1.42f + 3;
+  Rect z = Rect{static_cast<int>(cx - reach), static_cast<int>(cy - reach),
+                static_cast<int>(2 * reach) + 1, static_cast<int>(2 * reach) + 1}
+               .intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  const uint8_t* data = app.iconData();
+  uint32_t dataSize = app.iconSize();
+  bool hasIcon = data != nullptr && dataSize != 0;
+  if (hasIcon) {
+    OMG::Memory::Decompress(data, reinterpret_cast<uint8_t*>(s_textBuffer),
+                            dataSize,
+                            k_nwaIconWidth * k_nwaIconHeight * sizeof(KDColor));
+  }
+  float ca = cosf(angle), sa = sinf(angle);
+  KDColor shadow = rgb(0x000000);
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    for (int xx = z.x; xx < z.right(); xx++) {
+      float dx = xx + 0.5f - cx, dy = yy + 0.5f - cy;
+      // inverse rotation
+      float u = dx * ca + dy * sa, v = -dx * sa + dy * ca;
+      // drop shadow, offset by (2, 2)
+      float su = (dx - 2) * ca + (dy - 2) * sa, sv = -(dx - 2) * sa + (dy - 2) * ca;
+      bool inSticker = u > -half && u < half && v > -half && v < half;
+      if (!inSticker) {
+        if (su > -half && su < half && sv > -half && sv < half) {
+          blendPixel(row + xx, shadow, 40);
+        }
+        continue;
+      }
+      float iu = u + size * 0.5f, iv = v + size * 0.5f;
+      if (iu < 0 || iv < 0 || iu >= size || iv >= size) {
+        row[xx] = rgb(0xFFFFFF);
+        continue;
+      }
+      if (!hasIcon) {
+        row[xx] = hsv(static_cast<int>(iu * 6 + iv * 2) % 360, 160, 230);
+        continue;
+      }
+      int sx = static_cast<int>(iu * k_nwaIconWidth / size);
+      int sy = static_cast<int>(iv * k_nwaIconHeight / size);
+      row[xx] = s_textBuffer[sy * k_nwaIconWidth + sx];
+    }
+  }
+}
