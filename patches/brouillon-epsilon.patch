+void setLed(KDColor c) {
+  if (!s.ledSet || static_cast<uint16_t>(c) != s.ledLast) {
+    if (!s_fake) {
+      Ion::LED::setColor(c);
+    }
+    s.ledLast = static_cast<uint16_t>(c);
+    s.ledSet = true;
+  }
+}
+
+void restoreLed() {
+  if (s.ledSet) {
+    if (!s_fake) {
+      Ion::LED::updateColorWithPlugAndCharge();
+    }
+    s.ledSet = false;
+  }
+}
+
+void updateLed() {
+  if (!s.ledOn || examMode() || !s_attached) {
+    restoreLed();
+    return;
+  }
+  KDColor c = KDBlack;
+  int k = 0;
+  if (s.flooding) {
+    c = rgb(k_ink);
+    k = 255;
+  } else if (s.mode == Mode::Copie) {
+    c = rgb(k_red);
+    k = 60 + static_cast<int>(40 * sinf(s.now / 150.f));
+  } else if (s.mode >= Mode::Cocotte) {
+    uint16_t c16 = Trousse::ledColor(&k);
+    c = KDColor::RGB16(c16);
+  } else if (s.k.st == KState::Sleep) {
+    c = rgb(0x4060FF);
+    k = 20 + static_cast<int>(20 * sinf(s.now / 900.f));
+  }
+  if (k <= 0) {
+    restoreLed();
+    return;
+  }
+  if (k > 255) {
+    k = 255;
+  }
+  setLed(KDColor::RGB888(c.red() * k / 255, c.green() * k / 255,
+                         c.blue() * k / 255));
+}
