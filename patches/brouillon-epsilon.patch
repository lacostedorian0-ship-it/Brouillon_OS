+#include <apps/apps_container.h>
+#include <math.h>
+#include <string.h>
+
+#include "brouillon.h"
+
+/* The pencil case (Toolbox): nine things to do in class with the notebook.
+ *
+ *   Cocotte    the paper fortune teller: pick a colour, a number, a flap
+ *   Masque     hold the calculator in front of your mouth: it talks with
+ *              you (any key held opens the mouth, the arrows move the eyes,
+ *              the digits change the face)
+ *   Fissure    prank: the screen cracks and leaks in your neighbour's hands
