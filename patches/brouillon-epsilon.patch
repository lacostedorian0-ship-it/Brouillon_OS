+void renderMenu(Band& b) {
+  float t = sec();
+  float k = clampf(t / 0.22f, 0, 1);
+  int y0 = static_cast<int>(240 - 222 * (1 - (1 - k) * (1 - k)));
+  // A zipped fabric pencil case
+  Rect r = {14, y0, 292, 212};
+  if (r.y > b.clip().bottom()) {
+    return;
+  }
+  fill(b, b.clip(), rgb(0x000000), 70);
+  roundFill(b, {r.x + 3, r.y + 4, r.w, r.h}, 14, rgb(0x000000), 60);
+  roundFill(b, r, 14, rgb(0x2E3A66));
+  // fabric weave
+  for (int yy = r.y + 4; yy < r.bottom() - 4; yy += 4) {
+    fill(b, {r.x + 8, yy, r.w - 16, 1}, rgb(0x34427A), 120);
+  }
+  // zip
+  fill(b, {r.x + 10, r.y + 10, r.w - 20, 6}, rgb(0x9098B0));
+  for (int x = r.x + 12; x < r.right() - 12; x += 4) {
+    fill(b, {x, r.y + 9, 2, 8}, rgb(0x60687E));
+  }
+  roundFill(b, {r.x + r.w - 46, r.y + 6, 10, 16}, 3, rgb(0xC8CCD8));
+  // the paper inside
+  Rect inner = {r.x + 10, r.y + 22, r.w - 20, r.h - 30};
+  roundFill(b, inner, 6, rgb(k_paper));
+  if (s.mode == Mode::Reglages) {
+    renderSettings(b, inner);
+    hand(b, "Retour : refermer", inner.x + inner.w / 2, inner.bottom() - 18,
+         rgb(0x9AA4C0), Small, 3, Align::Center);
+    return;
+  }
+  for (int i = 0; i < k_numberOfTools; i++) {
+    int col = i % 3, row = i / 3;
+    float cx = inner.x + 46 + col * 90, cy = inner.y + 20 + row * 40;
+    bool sel = i == s.tool;
+    if (sel) {
+      float xs[4] = {cx - 42, cx + 42, cx + 40, cx - 44};
+      float ys[4] = {cy - 19, cy - 21, cy + 21, cy + 19};
+      polygon(b, xs, ys, 4, rgb(k_fluo), 170);
+      cy -= 2 + sinf(t * 6);
+    }
+    toolIcon(b, i, cx - 24, cy, t, sel);
+    hand(b, k_toolNames[i], static_cast<int>(cx - 6), static_cast<int>(cy - 7),
+         rgb(k_ink), Small, 200 + i);
+  }
+  wrapped(b, k_toolHelp[s.tool], inner.x + 8, inner.bottom() - 46,
+          inner.w - 16, rgb(k_graphite), Small, 14, Align::Center, 3,
+          300 + s.tool);
+}
+
+bool handleMenu(Event e) {
+  if (s.mode == Mode::Reglages) {
+    if (e == Events::One) {
+      s.ledOn = !s.ledOn;
+    } else if (e == Events::Two) {
+      s.kevinTalks = !s.kevinTalks;
+    } else if (e == Events::Three) {
+      s.graffitiCount = 0;
+      toast("Graffitis gomm\xC3\xA9s. Kevin est vex\xC3\xA9.", 1800);
+    } else if (e == Events::Back || e == Events::Toolbox ||
+               e == Events::Home || e == Events::OK || e == Events::EXE) {
+      setMode(Mode::Trousse);
+    }
+    return true;
+  }
+  int col = s.tool % 3, row = s.tool / 3;
+  if (e == Events::Left) {
+    col = (col + 2) % 3;
+  } else if (e == Events::Right) {
+    col = (col + 1) % 3;
+  } else if (e == Events::Up) {
+    row = (row + 2) % 3;
+  } else if (e == Events::Down) {
+    row = (row + 1) % 3;
+  } else if (e == Events::OK || e == Events::EXE) {
+    static constexpr Mode k_modes[k_numberOfTools] = {
+        Mode::Cocotte, Mode::Masque,  Mode::Fissure,
+        Mode::Duel,    Mode::Punition, Mode::Dessin,
+        Mode::Avion,   Mode::Morpion, Mode::Reglages};
+    enter(k_modes[s.tool]);
+    return true;
+  } else if (e == Events::Back || e == Events::Toolbox || e == Events::Home) {
+    setMode(Mode::Page);
+    return true;
+  } else {
+    const char* t = e.text();
+    if (t && t[0] >= '1' && t[0] <= '9' && t[1] == 0) {
+      s.tool = t[0] - '1';
+      return handleMenu(Events::OK);
+    }
+    return true;
+  }
+  s.tool = row * 3 + col;
+  s.modeStart = s.now - 300;
+  return true;
+}
