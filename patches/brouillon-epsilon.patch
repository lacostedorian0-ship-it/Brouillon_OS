+/* ============================================================ dispatch */
+
+void enter(Mode m) {
+  setMode(m);
+  s.k.sayUntil = 0;
+  switch (m) {
+    case Mode::Cocotte:
+      s.cocPhase = 0;
+      s.cocChoice = 0;
+      cocottePick();
+      break;
+    case Mode::Masque:
+      s.maskStyle = 1 + rnd() % 9;
+      s.mouth = 0;
+      s.blinkAt = s.now + 1200;
+      break;
+    case Mode::Fissure:
+      s.crackCount = 0;
+      s.backPresses = 0;
+      s.leakSeed = rnd() & 0xFFFF;
+      break;
+    case Mode::Duel:
+      s.duelPhase = 0;
+      s.duelScore[0] = s.duelScore[1] = 0;
+      s.duelAt = 0;
+      break;
+    case Mode::Punition:
+      s.punRunning = false;
+      s.punDone = 0;
+      s.punProgress = 0;
+      break;
+    case Mode::Dessin:
+      s.curX = 160;
+      s.curY = 140;
+      s.penDown = true;
+      s.eraser = false;
+      s.k.x = 160;
+      s.k.y = 60;
+      s.k.vy = 0;
+      s.k.grounded = false;
+      s.k.dir = 1;
+      break;
+    case Mode::Avion:
+      planeReset();
+      break;
+    case Mode::Morpion:
+      ttReset();
+      break;
+    default:
+      break;
+  }
+}
+
+bool handleEvent(Event e) {
+  if (e == Events::Home ||
+      (e == Events::Back && s.mode != Mode::Fissure)) {
+    setMode(Mode::Trousse);
+    s.modeStart = s.now - 300;
+    // Kevin goes back to his doodle
+    s.k.st = KState::Idle;
+    s.k.gag = -1;
+    s.k.x = Kev::slotX(s.selected);
+    s.k.y = Kev::slotY(s.selected);
+    return true;
+  }
+  switch (s.mode) {
+    case Mode::Cocotte:
+      return cocotteEvent(e);
+    case Mode::Masque: {
+      const char* t = e.text();
+      if (t && t[0] >= '0' && t[0] <= '9' && t[1] == 0) {
+        int d = t[0] - '0';
+        s.maskStyle = d == 0 ? 1 + rnd() % 9 : d;
+        s.modeStart = s.now;
+      }
+      return true;
+    }
+    case Mode::Fissure:
+      if (e == Events::Back) {
+        if (s.now - s.lastBack > 2000) {
+          s.backPresses = 0;
+        }
+        s.backPresses++;
+        s.lastBack = s.now;
+        if (s.backPresses >= 3) {
+          setMode(Mode::Page);
+          toast("R\xC3\xA9par\xC3\xA9 ! (C'\xC3\xA9tait une blague. "
+                "Respire.)",
+                3000);
+          Kev::say("Ta t\xC3\xAAte, MDR.", 2500);
+        }
+        return true;
+      }
+      if (s.crackCount > 0) {
+        const char* t = e.text();
+        if (t && t[0] >= '1' && t[0] <= '9' && t[1] == 0 &&
+            s.crackCount < k_maxCracks - 20) {
+          impact(30 + frnd() * 260, 30 + frnd() * 180);
+        } else {
+          shake(200);  // it gets worse when they touch it
+        }
+      }
+      return true;
+    case Mode::Duel:
+      return duelEvent(e);
+    case Mode::Punition:
+      if (!s.punRunning && s.punDone == 0) {
+        if (e == Events::Up) {
+          s.punSentence = (s.punSentence + k_numberOfSentences - 1) % k_numberOfSentences;
+        } else if (e == Events::Down) {
+          s.punSentence = (s.punSentence + 1) % k_numberOfSentences;
+        } else if (e == Events::OK || e == Events::EXE) {
+          s.punRunning = true;
+          s.punStart = s.now;
+          s.punProgress = 0;
+        }
+      } else if (!s.punRunning && (e == Events::OK || e == Events::EXE)) {
+        s.punDone = 0;
+        s.punProgress = 0;
+      }
+      return true;
+    case Mode::Dessin:
+      if (e == Events::OK || e == Events::EXE) {
+        s.penDown = !s.penDown;
+        s.eraser = false;
+        if (s.penDown) {
+          brush(s.curX, s.curY, true);
+        }
+      } else if (e == Events::Var || e == Events::XNT) {
+        s.eraser = !s.eraser;
+      } else if (e == Events::Zero || e == Events::Backspace) {
+        memset(s.canvas, 0, sizeof(s.canvas));
+        Kev::say("Tout effac\xC3\xA9. Je tombe.", 1500);
+      }
+      return true;
+    case Mode::Avion:
+      if (s.planeDead && (e == Events::OK || e == Events::EXE) &&
+          s.now - s.planeDeadAt > 600) {
+        planeReset();
+      }
+      return true;
+    case Mode::Morpion:
+      return morpionEvent(e);
+    default:
+      return true;
+  }
+}
+
+void update(float dt) {
+  switch (s.mode) {
+    case Mode::Cocotte:
+      cocotteUpdate();
+      break;
+    case Mode::Masque:
+      maskUpdate(dt);
+      break;
+    case Mode::Fissure:
+      if (s.crackCount == 0 && s.now - s.modeStart > 6000) {
+        impact(90 + frnd() * 140, 70 + frnd() * 90);
+      }
+      break;
+    case Mode::Duel:
+      duelUpdate();
+      break;
+    case Mode::Punition:
+      punitionUpdate(dt);
+      break;
+    case Mode::Dessin:
+      dessinUpdate(dt);
+      break;
+    case Mode::Avion:
+      avionUpdate(dt);
+      break;
+    case Mode::Morpion:
+      morpionUpdate();
+      break;
+    default:
+      break;
+  }
+}
+
+void render(Band& b) {
+  switch (s.mode) {
+    case Mode::Cocotte:
+      renderCocotte(b);
+      break;
+    case Mode::Masque:
+      renderMask(b);
+      break;
+    case Mode::Fissure:
+      renderFissure(b);
+      break;
+    case Mode::Duel:
+      renderDuel(b);
+      break;
+    case Mode::Punition:
+      renderPunition(b);
+      break;
+    case Mode::Dessin:
+      renderDessin(b);
+      break;
+    case Mode::Avion:
+      renderAvion(b);
+      break;
+    case Mode::Morpion:
+      renderMorpion(b);
+      break;
+    default:
+      break;
+  }
+}
+
+uint16_t ledColor(int* intensity) {
+  *intensity = 0;
+  switch (s.mode) {
+    case Mode::Masque:
+      if (s.maskStyle == 3) {
+        *intensity = 40 + static_cast<int>(200 * s.mouth);
+        return static_cast<uint16_t>(rgb(0xFF0000));
+      }
+      if (s.maskStyle == 6) {
+        *intensity = 40 + static_cast<int>(200 * s.mouth);
+        return static_cast<uint16_t>(rgb(0x00FFFF));
+      }
+      *intensity = static_cast<int>(120 * s.mouth);
+      return static_cast<uint16_t>(rgb(0xFF8040));
+    case Mode::Duel:
+      if (s.duelPhase == 3) {
+        *intensity = 255;
+        return static_cast<uint16_t>(rgb(0xFFFFFF));
+      }
+      if (s.duelPhase == 4 && s.now - s.duelAt < 400) {
+        *intensity = 255;
+        return static_cast<uint16_t>(rgb(0xFF2000));
+      }
+      return 0;
+    case Mode::Fissure:
+      if (s.crackCount > 0 && s.now - s.impactAt < 250) {
+        *intensity = 255;
+        return static_cast<uint16_t>(rgb(0xFFFFFF));
+      }
+      return 0;
+    case Mode::Avion:
+      if (s.planeDead && s.now - s.planeDeadAt < 300) {
+        *intensity = 255;
+        return static_cast<uint16_t>(rgb(0xFF2000));
+      }
+      return 0;
+    case Mode::Morpion:
+      if (s.ttPhase == 3) {
+        *intensity = 200;
+        return static_cast<uint16_t>(rgb(0xFF2000));
+      }
+      return 0;
+    default:
+      return 0;
+  }
+}
+
+bool fullScreen() { return s.mode >= Mode::Cocotte; }
