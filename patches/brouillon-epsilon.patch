+}
+
+/* Open amounts of the fortune teller along x and y (0 closed .. 1 open) */
+void cocOpening(float* ox, float* oy) {
+  *ox = *oy = 0;
+  if (s.cocPhase == 1 || s.cocPhase == 3) {
+    uint32_t t = s.now - s.cocStepStart;
+    int stepIndex = static_cast<int>(t / k_cocStep);
+    float f = (t % k_cocStep) / static_cast<float>(k_cocStep);
+    float amount = sinf(f * 3.14159f);
+    if (stepIndex & 1) {
+      *oy = amount;
+    } else {
+      *ox = amount;
+    }
+  } else if (s.cocPhase == 2 || s.cocPhase == 4) {
+    *ox = *oy = 0.85f;
+  } else if (s.cocPhase == 5) {
+    *ox = *oy = 0.85f;
+  }
+}
+
+void renderCocotte(Band& b) {
+  paper(b, 4);
+  KDColor ink = rgb(k_ink);
+  hand(b, "La cocotte", 44, 4, ink, Large, 1);
+  float cx = 176, cy = 128;
+  float ox, oy;
+  cocOpening(&ox, &oy);
+  float gx = ox * 24, gy = oy * 24;
+  constexpr float S = 58;
+  // The inside: four triangles with numbers, visible where it opens
+  if (gx > 0.5f || gy > 0.5f) {
+    float xs[4] = {cx, cx + gx + 26, cx, cx - gx - 26};
+    float ys[4] = {cy - gy - 26, cy, cy + gy + 26, cy};
+    polygon(b, xs, ys, 4, rgb(0xF4F0E4));
+    penPath(b, xs, ys, 4, true, 1, rgb(0x9A9488), 30);
+    pen(b, xs[0], ys[0], xs[2], ys[2], 1, rgb(0xC8C0B0), 31);
+    pen(b, xs[1], ys[1], xs[3], ys[3], 1, rgb(0xC8C0B0), 32);
+    float nx[4] = {cx, cx + 10 + gx * 0.6f, cx, cx - 10 - gx * 0.6f};
+    float ny[4] = {cy - 16 - gy * 0.5f, cy - 7, cy + 4 + gy * 0.5f, cy - 7};
+    for (int i = 0; i < 4; i++) {
+      bool visible = (i == 0 || i == 2) ? gy > 6 : gx > 6;
+      if (s.cocPhase == 2 || s.cocPhase == 4 || s.cocPhase == 5) {
+        visible = true;
+      }
+      if (!visible) {
+        continue;
+      }
+      char n[4];
+      Str ns(n, sizeof(n));
+      ns.addInt(s.cocNumbers[i]);
+      bool sel = (s.cocPhase == 2 || s.cocPhase == 4) && s.cocChoice == i;
+      if (sel) {
+        penCircle(b, nx[i], ny[i] + 7, 9, 9, 1.4f, rgb(k_red), 40 + i);
+      }
+      hand(b, n, static_cast<int>(nx[i]), static_cast<int>(ny[i]), ink, Small,
+           50 + i, Align::Center);
+    }
+  }
+  // The four coloured squares, which pivot around the centre
+  for (int q = 0; q < 4; q++) {
+    int sx = (q == 1 || q == 2) ? 1 : -1;  // 0 TL, 1 TR, 2 BR, 3 BL
+    int sy = (q >= 2) ? 1 : -1;
+    // colour quadrant order: top (TL), right (TR), bottom (BR), left (BL)
+    float inner = 1.0f, side = 0.55f, outer = 0.25f;
+    float px[4], py[4];
+    // corners: inner (at centre), horizontal neighbour, outer, vertical
+    float bx[4] = {0, static_cast<float>(sx) * S, static_cast<float>(sx) * S, 0};
+    float by[4] = {0, 0, static_cast<float>(sy) * S, static_cast<float>(sy) * S};
+    float w[4] = {inner, side, outer, side};
+    for (int c = 0; c < 4; c++) {
+      px[c] = cx + bx[c] + sx * gx * w[c];
+      py[c] = cy + by[c] + sy * gy * w[c];
+    }
+    KDColor col = rgb(k_cocColors[q]);
+    bool highlighted = s.cocPhase == 0 && s.cocChoice == q;
+    polygon(b, px, py, 4, highlighted ? mix(col, rgb(0xFFFFFF), 90) : col);
+    // fold line and shade of the pyramid
+    float mx = (px[0] + px[2]) / 2, my = (py[0] + py[2]) / 2;
+    float tx[3] = {px[0], px[1], px[2]}, ty[3] = {py[0], py[1], py[2]};
+    polygon(b, tx, ty, 3, rgb(0x000000), 28);
+    pen(b, px[0], py[0], px[2], py[2], 1, rgb(0x000000), 60 + q, 0.4f, 90);
+    penPath(b, px, py, 4, true, 1.4f, ink, 70 + q, 0.5f);
+    if (gx < 4 && gy < 4) {
+      hand(b, k_cocNames[q], static_cast<int>(mx), static_cast<int>(my - 7),
+           rgb(0xFFFFFF), Small, 80 + q, Align::Center);
+    }
+  }
+  // Fingers (four little pencil circles at the outer corners)
+  // Captions
+  const char* caption = nullptr;
+  char buffer[64];
+  switch (s.cocPhase) {
+    case 0:
+      caption = "Choisis une couleur (fl\xC3\xA8\x63hes), puis OK.";
+      break;
+    case 1:
+    case 3: {
+      int done = static_cast<int>((s.now - s.cocStepStart) / k_cocStep) + 1;
+      if (done > s.cocCount) {
+        done = s.cocCount;
+      }
+      Str m(buffer, sizeof(buffer));
+      if (s.cocPhase == 1) {
+        const char* name = k_cocNames[s.cocChoice];
+        for (int i = 0; i < done; i++) {
+          char l[2] = {name[i], 0};
+          m.add(l);
+          if (i < done - 1) {
+            m.add("-");
+          }
+        }
+      } else {
+        for (int i = 1; i <= done; i++) {
+          m.addInt(i);
+          if (i < done) {
+            m.add("... ");
+          }
+        }
+      }
+      caption = buffer;
+      break;
+    }
+    case 2:
+      caption = "Choisis un nombre (fl\xC3\xA8\x63hes), puis OK.";
+      break;
+    case 4:
+      caption = "Dernier nombre : on soul\xC3\xA8ve le rabat !";
+      break;
+    default:
+      break;
+  }
+  if (caption) {
+    hand(b, caption, 176, 214, ink, Small, 90, Align::Center);
+  }
+  if (s.cocPhase == 5) {
+    float k = clampf((s.now - s.cocStepStart) / 500.f, 0, 1);
+    float e = 1 - (1 - k) * (1 - k);
+    Rect card = {static_cast<int>(176 - 130 * e), static_cast<int>(128 - 58 * e),
+                 static_cast<int>(260 * e), static_cast<int>(116 * e)};
+    if (card.w > 4) {
+      fill(b, {card.x + 3, card.y + 4, card.w, card.h}, rgb(0x000000), 50);
+      fill(b, card, rgb(0xFFFDF6));
+      pen(b, card.x, card.y + card.h / 2, card.right(), card.y + card.h / 2, 1,
+          rgb(0xDDD6C4), 95);
+      pen(b, card.x + card.w / 2, card.y, card.x + card.w / 2, card.bottom(), 1,
+          rgb(0xDDD6C4), 96);
+      roundFrame(b, card, 2, rgb(0x9A9488));
+    }
+    if (k >= 1) {
+      int count = static_cast<int>((s.now - s.cocStepStart - 500) / 40);
+      char text[120];
+      strlcpy(text, k_fortunes[s.cocFortune], sizeof(text));
+      // write it progressively
+      int glyphs = 0;
+      int i = 0;
+      while (text[i] && glyphs < count) {
+        if ((static_cast<uint8_t>(text[i]) & 0xC0) != 0x80) {
+          glyphs++;
+        }
+        i++;
+      }
+      while ((static_cast<uint8_t>(text[i]) & 0xC0) == 0x80) {
+        i++;
+      }
+      text[i] = 0;
+      wrapped(b, text, card.x + 14, card.y + 26, card.w - 28, rgb(k_red),
+              Small, 18, Align::Center, 4, 97);
+      hand(b, "OK : rejouer", 176, 214, ink, Small, 98, Align::Center);
+    }
+  }
+}
+
+void cocottePick() {
+  for (int i = 0; i < 4; i++) {
+    bool again;
+    do {
+      s.cocNumbers[i] = 1 + rnd() % 8;
+      again = false;
+      for (int j = 0; j < i; j++) {
+        if (s.cocNumbers[j] == s.cocNumbers[i]) {
+          again = true;
+        }
+      }
+    } while (again);
+  }
+}
+
+bool cocotteEvent(Event e) {
+  int d = cocDirection(e);
+  bool ok = e == Events::OK || e == Events::EXE;
+  switch (s.cocPhase) {
+    case 0:
+      if (d >= 0) {
+        s.cocChoice = d;
+      } else if (ok) {
+        cocStartCount(k_cocLetters[s.cocChoice]);
+      }
+      return true;
+    case 2:
+    case 4:
+      if (d >= 0) {
+        s.cocChoice = d;
+      } else if (ok) {
+        if (s.cocPhase == 2) {
+          cocStartCount(s.cocNumbers[s.cocChoice]);
+        } else {
+          s.cocPhase = 5;
+          s.cocStepStart = s.now;
+          s.cocFortune = (s.cocNumbers[s.cocChoice] * 7 + rnd()) % k_numberOfFortunes;
+        }
+      }
+      return true;
+    case 5:
+      if (ok) {
+        s.cocPhase = 0;
+        s.cocChoice = 0;
+        cocottePick();
+      }
+      return true;
+    default:
+      return true;
+  }
+}
+
+void cocotteUpdate() {
+  if ((s.cocPhase == 1 || s.cocPhase == 3) &&
+      s.now - s.cocStepStart >= static_cast<uint32_t>(s.cocCount) * k_cocStep) {
+    s.cocPhase++;
+    s.cocChoice = 0;
+  }
+}
