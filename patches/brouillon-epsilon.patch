+#include <apps/i18n.h>
+#include <math.h>
+
+#include "brouillon.h"
+
+/* The doodle of every calculator app, drawn with the blue pen in the margin
+ * of a scrap notebook. Coordinates are in a 56 x 56 box centred on (cx, cy)
+ * and scaled to `size`. `anim` (seconds) makes the selected doodle move. */
+
+namespace Home {
+namespace Doodle {
+
+namespace {
+
+struct Pen {
+  Band& b;
+  float cx, cy, u;
+  uint32_t seed;
+  KDColor c;
+  float th;
+  int n = 0;
+  float X(float x) const { return cx + x * u; }
+  float Y(float y) const { return cy + y * u; }
+  void l(float x0, float y0, float x1, float y1) {
+    pen(b, X(x0), Y(y0), X(x1), Y(y1), th, c, seed * 97 + (n++), 0.7f);
+  }
+  void circle(float x, float y, float r, float progress = 1.f) {
+    penCircle(b, X(x), Y(y), r * u, r * u, th, c, seed * 97 + (n++),
+              progress, 0.6f);
+  }
+  void ellipse(float x, float y, float rx, float ry, float angle) {
+    constexpr int k = 20;
+    float xs[k], ys[k];
+    float ca = cosf(angle), sa = sinf(angle);
+    for (int i = 0; i < k; i++) {
+      float a = i * 6.28318f / k;
+      float ex = cosf(a) * rx, ey = sinf(a) * ry;
+      xs[i] = X(x + ex * ca - ey * sa);
+      ys[i] = Y(y + ex * sa + ey * ca);
+    }
+    penPath(b, xs, ys, k, true, th, c, seed * 97 + (n++), 0.5f);
+  }
+  void path(const float* pts, int count, bool closed = false) {
+    float xs[24], ys[24];
+    for (int i = 0; i < count && i < 24; i++) {
+      xs[i] = X(pts[2 * i]);
+      ys[i] = Y(pts[2 * i + 1]);
+    }
+    penPath(b, xs, ys, count < 24 ? count : 24, closed, th, c,
+            seed * 97 + (n++), 0.6f);
+  }
+  void dot(float x, float y, float r) {
+    Home::Doodle::ellipse(b, X(x), Y(y), r * u, r * u, c);
+  }
+  void label(const char* s, float x, float y, KDFont::Size f = KDFont::Size::Small) {
+    hand(b, s, static_cast<int>(X(x)), static_cast<int>(Y(y)), c, f,
+         seed + 5, Align::Center);
+  }
+};
+
+#define MSG(x) static_cast<int>(I18n::Message::x)
+
+void calculator(Pen& p, float t, bool sel) {
+  p.l(-17, -24, 17, -24);
+  p.l(17, -24, 18, 25);
+  p.l(18, 25, -17, 25);
+  p.l(-17, 25, -17, -24);
+  // its screen shows... a calculator. Recursion.
+  p.l(-12, -19, 12, -19);
+  p.l(12, -19, 12, -7);
+  p.l(12, -7, -12, -7);
+  p.l(-12, -7, -12, -19);
+  p.label(sel && (static_cast<int>(t * 2) & 1) ? "=2" : "1+1", 0, -20);
+  for (int r = 0; r < 3; r++) {
+    for (int c = 0; c < 3; c++) {
+      p.dot(-9 + c * 9, -1 + r * 8.5f, 1.6f);
+    }
+  }
+}
+
+void grapher(Pen& p, float t, bool sel) {
+  p.l(-24, 18, 25, 18);
+  p.l(25, 18, 20, 15);
+  p.l(25, 18, 20, 21);
+  p.l(-20, 24, -20, -24);
+  p.l(-20, -24, -23, -19);
+  p.l(-20, -24, -17, -19);
+  float pts[32];
+  float phase = sel ? t * 3 : 0;
+  for (int i = 0; i < 16; i++) {
+    float x = -18 + i * 2.8f;
+    pts[2 * i] = x;
+    pts[2 * i + 1] = 2 - 14 * sinf(x * 0.16f + phase);
+  }
+  p.path(pts, 16);
+}
+
+void solver(Pen& p, float t, bool sel) {
+  p.label("x = ?", 0, -10, KDFont::Size::Large);
+  p.circle(-21, -1, 8, sel ? fmodf(t, 1.6f) / 1.0f : 1.f);
+  p.label("?", 16, 8);
+  p.label("?", 24, 2);
+  p.l(-24, 14, 24, 13);
+  p.l(-22, 17, 22, 17);
+}
+
+void stats(Pen& p, float t, bool sel) {
+  p.l(-24, 22, 24, 22);
+  float h[4] = {18, 32, 12, 40};
+  for (int i = 0; i < 4; i++) {
+    float x = -20 + i * 11;
+    float hh = h[i] * (sel ? 0.75f + 0.25f * sinf(t * 4 + i) : 1.f);
+    p.l(x, 22, x, 22 - hh);
+    p.l(x, 22 - hh, x + 8, 22 - hh);
+    p.l(x + 8, 22 - hh, x + 8, 22);
+    if (i & 1) {
+      hatch(p.b, {static_cast<int>(p.X(x)), static_cast<int>(p.Y(22 - hh)),
+                  static_cast<int>(8 * p.u), static_cast<int>(hh * p.u)},
+            4, p.c, p.seed + i);
+    }
+  }
+}
+
+void distributions(Pen& p, float t, bool sel) {
+  p.l(-25, 20, 25, 20);
+  float pts[40];
+  for (int i = 0; i < 20; i++) {
+    float x = -24 + i * 48.f / 19;
+    pts[2 * i] = x;
+    pts[2 * i + 1] = 20 - 36 * expf(-x * x / 120.f);
+  }
+  p.path(pts, 20);
+  float limit = sel ? -8 + 10 * sinf(t * 2) : 4;
+  Rect r = {static_cast<int>(p.X(-24)), static_cast<int>(p.Y(-18)),
+            static_cast<int>((limit + 24) * p.u), static_cast<int>(38 * p.u)};
+  // Hatch under the curve only: clip row by row would be costly, hatch a
+  // slice under the left part instead
+  Rect saved = p.b.clip();
+  for (int i = 0; i < 6; i++) {
+    float x0 = -24 + i * (limit + 24) / 6, x1 = x0 + (limit + 24) / 6;
+    float yTop = 20 - 36 * expf(-x1 * x1 / 120.f);
+    if (x0 < 0 && x1 < 0) {
+      yTop = 20 - 36 * expf(-x0 * x0 / 120.f);
+      yTop = 20 - 36 * expf(-x1 * x1 / 120.f) > yTop
+                 ? yTop
+                 : 20 - 36 * expf(-x1 * x1 / 120.f);
+    }
+    Rect slice = {static_cast<int>(p.X(x0)), static_cast<int>(p.Y(yTop + 2)),
+                  static_cast<int>((x1 - x0) * p.u) + 1,
+                  static_cast<int>((20 - yTop - 2) * p.u)};
+    hatch(p.b, slice.intersection(r), 4, p.c, p.seed + 40);
+  }
+  p.b.setClip(saved);
+  p.l(limit, 22, limit, -16);
+}
+
+void sequence(Pen& p, float t, bool sel) {
+  float ys[5] = {18, 10, 2, -8, -20};
+  int shown = sel ? 1 + static_cast<int>(t * 3) % 6 : 5;
+  for (int i = 0; i < 5 && i < shown; i++) {
+    float x = -22 + i * 11;
+    p.dot(x, ys[i], 2.2f);
+    if (i > 0) {
+      float pts[6] = {x - 10, ys[i - 1] - 3, x - 5.5f, ys[i] - 9, x - 1,
+                      ys[i] - 3};
+      p.path(pts, 3);
+    }
+  }
+  p.label("u(n)", -10, -22);
+}
+
+void regression(Pen& p, float t, bool sel) {
+  float pts[16] = {-20, 14, -14, 15, -10, 6, -4, 8,
+                   2,   -2, 8,   0,  13,  -10, 19, -8};
+  for (int i = 0; i < 8; i++) {
+    float j = sel ? 1.5f * sinf(t * 5 + i * 2) : 0;
+    p.l(pts[2 * i] - 2, pts[2 * i + 1] - 2 + j, pts[2 * i] + 2,
+        pts[2 * i + 1] + 2 + j);
+    p.l(pts[2 * i] + 2, pts[2 * i + 1] - 2 + j, pts[2 * i] - 2,
+        pts[2 * i + 1] + 2 + j);
+  }
+  p.l(-25, 20, 25, -16);
+}
+
+void inference(Pen& p, float t, bool sel) {
+  float tilt = sel ? 0.25f * sinf(t * 3) : 0.15f;
+  p.l(0, -20, 0, 20);
+  p.l(-12, 22, 12, 22);
+  float lx = -20, rx = 20;
+  float ly = -14 - tilt * 20, ry = -14 + tilt * 20;
+  p.l(lx, ly, rx, ry);
+  p.l(lx, ly, lx - 6, ly + 14);
+  p.l(lx, ly, lx + 6, ly + 14);
+  p.l(lx - 8, ly + 14, lx + 8, ly + 14);
+  p.l(rx, ry, rx - 6, ry + 14);
+  p.l(rx, ry, rx + 6, ry + 14);
+  p.l(rx - 8, ry + 14, rx + 8, ry + 14);
+  p.label("H0", lx, ly + 15);
+  p.label("H1", rx, ry + 15);
+}
+
+void finance(Pen& p, float t, bool sel) {
+  float pts[20] = {-6, -16, -16, -2, -18, 12, -10, 22, 10, 22,
+                   18, 12,  16,  -2, 6,   -16, 0,  -14, -6, -16};
+  p.path(pts, 10, true);
+  p.l(-8, -20, 8, -20);
+  p.l(-8, -20, -5, -15);
+  p.l(8, -20, 5, -15);
+  p.label("%", 0, -1, KDFont::Size::Large);
+  if (sel) {
+    float y = -26 + fmodf(t * 30, 24);
+    p.circle(20, y, 4);
+  }
+}
+
+void code(Pen& p, float t, bool sel) {
+  float pts[40];
+  float wiggle = sel ? t * 6 : 0;
+  for (int i = 0; i < 18; i++) {
+    float x = -24 + i * 2.6f;
+    pts[2 * i] = x;
+    pts[2 * i + 1] = 10 + 8 * sinf(i * 0.6f + wiggle) * (0.4f + i / 30.f);
+  }
+  p.path(pts, 18);
+  for (int i = 0; i < 18; i++) {
+    pts[2 * i + 1] -= 6;
+  }
+  p.path(pts, 18);
+  // head
+  float hx = pts[34] + 4, hy = pts[35] + 3;
+  p.circle(hx, hy, 5);
+  p.dot(hx + 1.5f, hy - 1.5f, 1.2f);
+  // tongue
+  p.l(hx + 5, hy + 1, hx + 10, hy + 1);
+  p.l(hx + 10, hy + 1, hx + 13, hy - 2);
+  p.l(hx + 10, hy + 1, hx + 13, hy + 3);
+  p.label(">>>", -6, -24);
+}
+
+void elements(Pen& p, float t, bool sel) {
+  float spin = sel ? t * 1.5f : 0;
+  p.ellipse(0, 0, 24, 8, 0 + spin);
+  p.ellipse(0, 0, 24, 8, 1.05f + spin);
+  p.ellipse(0, 0, 24, 8, 2.1f + spin);
+  p.dot(0, 0, 4);
+  float a = t * 4;
+  p.dot(cosf(a) * 24 * cosf(spin) - sinf(a) * 8 * sinf(spin),
+        cosf(a) * 24 * sinf(spin) + sinf(a) * 8 * cosf(spin), 1.8f);
+}
+
+void settings(Pen& p, float t, bool sel) {
+  constexpr int k = 8;
+  float pts[k * 4 * 2];
+  float rot = sel ? t * 1.2f : 0.2f;
+  for (int i = 0; i < k; i++) {
+    float a0 = rot + i * 6.28318f / k;
+    float d = 6.28318f / k;
+    float r1 = 15, r2 = 21;
+    float as[4] = {a0, a0 + d * 0.15f, a0 + d * 0.45f, a0 + d * 0.6f};
+    float rs[4] = {r1, r2, r2, r1};
+    for (int j = 0; j < 4; j++) {
+      pts[(i * 4 + j) * 2] = cosf(as[j]) * rs[j];
+      pts[(i * 4 + j) * 2 + 1] = sinf(as[j]) * rs[j];
+    }
+  }
+  // penPath takes at most 24 points: draw the gear in two halves
+  p.path(pts, 17);
+  p.path(pts + 32, 16);
+  float closing[4] = {pts[62], pts[63], pts[0], pts[1]};
+  p.path(closing, 2);
+  p.circle(0, 0, 7);
+}
+
+void unknown(Pen& p, float t, bool sel) {
+  p.circle(0, 0, 20);
+  p.label("?", 0, -9, KDFont::Size::Large);
+}
