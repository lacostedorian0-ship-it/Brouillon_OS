+#include "food.h"
+
+#include <string.h>
+
+namespace Home {
+namespace Doodle {
+namespace Food {
+
+namespace {
+Entry s_ring[k_ringSize];
+uint32_t s_produced = 0;
+
+void copy(char* dst, const char* src) {
+  int n = 0;
+  if (src) {
+    while (src[n] && n < k_textSize - 1) {
+      dst[n] = src[n];
+      n++;
+    }
+    if (src[n] != 0) {
+      // Cut: never cut a UTF-8 character in two
+      while (n > 0 && (static_cast<uint8_t>(dst[n - 1]) & 0xC0) == 0x80) {
+        n--;
+      }
+      if (n > 0 && (static_cast<uint8_t>(dst[n - 1]) & 0xC0) == 0xC0) {
+        n--;
+      }
+    }
+  }
+  dst[n] = 0;
+}
+}  // namespace
+
+void push(const char* input, const char* output) {
+  if (output == nullptr || output[0] == 0) {
+    return;
+  }
+  Entry& e = s_ring[s_produced % k_ringSize];
+  copy(e.input, input);
+  copy(e.output, output);
+  s_produced++;
+}
+
+uint32_t produced() { return s_produced; }
+
+const Entry* at(uint32_t index) {
+  if (index >= s_produced || s_produced - index > k_ringSize) {
+    return nullptr;
+  }
+  return &s_ring[index % k_ringSize];
+}
+
+}  // namespace Food
+}  // namespace Doodle
+}  // namespace Home
