+
+void drawPageContent(Band& b, int page, bool live) {
+  paper(b, page);
+  if (b.clip().y < 26) {
+    char title[48];
+    Str t(title, sizeof(title));
+    t.add(pageTitle(page));
+    hand(b, title, 44, 4, rgb(k_ink), Large, 11 + page);
+    char num[12];
+    Str n(num, sizeof(num));
+    n.add("p. ").addInt(page + 1).add("/").addInt(s.numberOfPages);
+    hand(b, num, 250, 6, rgb(k_ink), Small, 3 + page, Align::Right);
+    pencilBattery(b, 306, 9);
+    pen(b, 44, 23, 44 + glyphCount(title) * 10, 22, 1.2f, rgb(k_ink), 30 + page, 0.8f);
+  }
+  if (page == 1) {
+    coffeeStain(b, 20, 232);
+  }
+  Kev::render(b, page);
+  float anim = s.now / 1000.f;
+  int count = 0;
+  for (int slot = 0; slot < k_perPage; slot++) {
+    int app = appAtSlot(page, slot);
+    if (app < 0) {
+      break;
+    }
+    count++;
+    Rect r = cellRect(slot);
+    if (r.y > b.clip().bottom() || r.bottom() < b.clip().y) {
+      continue;
+    }
+    bool selected = live && slot == s.selected && !s.turning;
+    float cx = r.x + r.w / 2, cy = r.y + 46;
+    const char* name = appName(app);
+    char label[16];
+    strlcpy(label, name, sizeof(label));
+    int ly = r.y + 80;
+    if (selected) {
+      // highlighter swipe behind the name
+      float k = (s.now - s.selectStart) / 180.f;
+      if (k > 1) {
+        k = 1;
+      }
+      int w = textWidth(label) + 10;
+      float x0 = cx - w / 2;
+      float xs[4] = {x0, x0 + w * k, x0 + w * k - 3, x0 - 2};
+      float ys[4] = {static_cast<float>(ly + 1), static_cast<float>(ly),
+                     static_cast<float>(ly + 15), static_cast<float>(ly + 16)};
+      polygon(b, xs, ys, 4, rgb(k_fluo), 200);
+    }
+    if (s_apps[app].item.kind == Item::Kind::External) {
+      float angle = 0.18f * (static_cast<int>(hash(app * 7 + 3) % 200) - 100) / 100.f;
+      if (selected) {
+        angle += 0.05f * sinf(anim * 5);
+      }
+      AppsContainer* container = AppsContainer::sharedAppsContainer();
+      gameSticker(b, container->externalAppAtIndex(s_apps[app].item.index),
+                  cx, cy, 42, angle);
+      tape(b, cx + sinf(angle) * 20, cy - 24, angle);
+    } else {
+      drawAppDoodle(b, s_apps[app].name, cx, cy, 52, 100 + app, anim,
+                    selected);
+    }
+    hand(b, label, static_cast<int>(cx), ly, rgb(k_ink), Small, 40 + app,
+         Align::Center);
+    if (selected) {
+      float k = (s.now - s.selectStart) / 380.f;
+      penCircle(b, cx, cy + 2, 38, 37, 1.8f, rgb(k_ink),
+                500 + s.selected + page * 7, k > 1 ? 1 : k, 1.f);
+    }
+  }
+  if (count == 0) {
+    hand(b, "Pas encore de jeux ici.", 176, 80, rgb(k_ink), Small, 3,
+         Align::Center);
+    hand(b, "Colle des .nwa avec l'installateur :", 176, 104, rgb(k_ink),
+         Small, 4, Align::Center);
+    hand(b, "ils appara\xC3\xAEtront en autocollants.", 176, 120,
+         rgb(k_ink), Small, 5, Align::Center);
+  }
+}
