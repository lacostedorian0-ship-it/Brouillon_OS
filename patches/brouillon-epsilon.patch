+/* ================================================================= apps */
+
+namespace {
+
+void buildApps() {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfApps = 0;
+  s_calculationIndex = -1;
+  for (int appIndex = 1;
+       appIndex < builtin && s_numberOfApps < k_maxBuiltin; appIndex++) {
+    I18n::Message name =
+        container->appSnapshotAtIndex(PermutedAppSnapshotIndex(appIndex))
+            ->descriptor()
+            ->name();
+    AppSlot& a = s_apps[s_numberOfApps];
+    a.item = {Item::Kind::Builtin, static_cast<int16_t>(appIndex)};
+    a.name = static_cast<int>(name);
+    if (name == I18n::Message::CalculApp) {
+      s_calculationIndex = s_numberOfApps;
+    }
+    s_numberOfApps++;
+  }
+  s_numberOfBuiltin = s_numberOfApps;
+  int games = container->numberOfExternalApps();
+  for (int i = 0; i < games && s_numberOfApps < k_maxApps; i++) {
+    AppSlot& a = s_apps[s_numberOfApps++];
+    a.item = {Item::Kind::External, static_cast<int16_t>(i)};
+    a.name = -1;
+  }
+  s_builtinPages = (s_numberOfBuiltin + k_perPage - 1) / k_perPage;
+  if (s_builtinPages < 1) {
+    s_builtinPages = 1;
+  }
+  int gamePages =
+      (s_numberOfApps - s_numberOfBuiltin + k_perPage - 1) / k_perPage;
+  // An empty page of stickers says where the games go
+  s.numberOfPages = s_builtinPages + (gamePages > 0 ? gamePages : 1);
+}
+
+}  // namespace
+
+const char* appName(int i) {
+  if (i < 0 || i >= s_numberOfApps) {
+    return "";
+  }
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  if (s_apps[i].item.kind == Item::Kind::External) {
+    return container->externalAppAtIndex(s_apps[i].item.index).name();
+  }
+  return I18n::translate(container
+                             ->appSnapshotAtIndex(PermutedAppSnapshotIndex(
+                                 s_apps[i].item.index))
+                             ->descriptor()
+                             ->name());
+}
+
+int appAtSlot(int page, int slot) {
+  if (page < 0 || slot < 0 || slot >= k_perPage) {
+    return -1;
+  }
+  int i;
+  if (page < s_builtinPages) {
+    i = page * k_perPage + slot;
+    return i < s_numberOfBuiltin ? i : -1;
+  }
+  i = s_numberOfBuiltin + (page - s_builtinPages) * k_perPage + slot;
+  return i < s_numberOfApps ? i : -1;
+}
+
+int pageOfApp(int index) {
+  if (index < s_numberOfBuiltin) {
+    return index / k_perPage;
+  }
+  return s_builtinPages + (index - s_numberOfBuiltin) / k_perPage;
+}
+
+int slotOfApp(int index) {
+  if (index < s_numberOfBuiltin) {
+    return index % k_perPage;
+  }
+  return (index - s_numberOfBuiltin) % k_perPage;
+}
+
+Rect cellRect(int slot) {
+  int col = slot % 3, row = slot / 3;
+  return {40 + col * 93, 26 + row * 106, 93, 106};
+}
+
+namespace {
+int slotsOnPage(int page) {
+  int n = 0;
+  while (n < k_perPage && appAtSlot(page, n) >= 0) {
+    n++;
+  }
+  return n;
+}
+}  // namespace
+
+/* ================================================================ paper */
+
+void paper(Band& b, uint32_t seed, bool margin) {
+  const Rect& z = b.clip();
+  KDColor base = rgb(k_paper);
+  KDColor thin = rgb(0xC4D3EE);
+  KDColor thick = rgb(0x93AEDD);
+  KDColor vertical = rgb(0xE2DDF0);
+  KDColor red = rgb(k_margin);
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    // Seyes ruling: a thick line every 32 px, thin ones every 8 px
+    KDColor c = base;
+    int m = (y - 8) & 31;
+    if (m == 0) {
+      c = thick;
+    } else if ((m & 7) == 0) {
+      c = thin;
+    }
+    for (int x = z.x; x < z.right(); x++) {
+      row[x] = c;
+    }
+    if (c == base) {
+      for (int x = ((z.x + 31) & ~31) + 4; x < z.right(); x += 32) {
+        if (x >= z.x) {
+          row[x] = vertical;
+        }
+      }
+    }
+    if (margin && z.x <= 35 && z.right() > 33) {
+      row[33] = red;
+      if (z.right() > 35) {
+        row[35] = red;
+      }
+    }
+  }
+  if (margin) {
+    // Punched holes: the wooden desk shows through
+    for (int i = 0; i < 3; i++) {
+      int hy = 50 + i * 70;
+      disc(b, 13, hy + 1, 6, rgb(0xA88A64));
+      disc(b, 13, hy, 6, rgb(0xC7A57A));
+      arc(b, 13, hy, 6, 1, 1, rgb(0x8C6E4C), 160);
+    }
+  }
+  (void)seed;
+}
+
+namespace {
+
+void pencilBattery(Band& b, int x, int y) {
+  if (y + 8 < b.clip().y || y - 2 > b.clip().bottom()) {
+    return;
+  }
+  int level = static_cast<int>(Ion::Battery::level());
+  int len = 8 + level * 7;
+  // a pencil getting shorter with the battery
+  fill(b, {x - len, y, len, 6}, rgb(level <= 1 ? 0xE04030 : 0xF2B830));
+  fill(b, {x - len, y, len, 2}, rgb(0xF8D060));
+  fill(b, {x - len - 5, y, 5, 6}, rgb(0xF4A0B4));
+  fill(b, {x - len - 1, y, 1, 6}, rgb(0xB0B0B8));
+  float xs[3] = {static_cast<float>(x), static_cast<float>(x),
+                 static_cast<float>(x + 7)};
+  float ys[3] = {static_cast<float>(y), static_cast<float>(y + 6),
+                 static_cast<float>(y + 3)};
+  polygon(b, xs, ys, 3, rgb(0xE8C9A0));
+  line(b, x + 5, y + 3, x + 7, y + 3, 1.6f, rgb(0x303030));
+  if (Ion::Battery::isCharging()) {
+    pen(b, x - len / 2 + 2, y - 2, x - len / 2 - 2, y + 3, 1.2f, rgb(k_red), 3);
+    pen(b, x - len / 2 - 2, y + 3, x - len / 2 + 2, y + 3, 1.2f, rgb(k_red), 4);
+    pen(b, x - len / 2 + 2, y + 3, x - len / 2 - 2, y + 8, 1.2f, rgb(k_red), 5);
+  }
+}
+
+const char* pageTitle(int page) {
+  if (page < s_builtinPages) {
+    return page == 0 ? "Mes applis" : "La suite";
+  }
+  return "Mes jeux";
+}
+
+void coffeeStain(Band& b, float x, float y) {
+  blob(b, x, y, 22, 0.08f, rgb(0xB07A40), 20, 30);
+  penCircle(b, x, y, 21, 20, 2.5f, rgb(0x9A6430), 21, 1.f, 0.4f, 70);
+  penCircle(b, x + 1, y, 19, 18, 1.f, rgb(0x9A6430), 22, 1.f, 0.4f, 40);
+}
+
+void tape(Band& b, float cx, float cy, float angle) {
+  float ca = cosf(angle), sa = sinf(angle);
+  float hw = 15, hh = 5;
+  float xs[4] = {cx - hw * ca + hh * sa, cx + hw * ca + hh * sa,
+                 cx + hw * ca - hh * sa, cx - hw * ca - hh * sa};
+  float ys[4] = {cy - hw * sa - hh * ca, cy + hw * sa - hh * ca,
+                 cy + hw * sa + hh * ca, cy - hw * sa + hh * ca};
+  polygon(b, xs, ys, 4, rgb(0xF0E6C0), 170);
+}
