+/* ================================================================ poses */
+
+Pose pose(KState st, float t, int dir) {
+  Pose p;
+  p.lean = 0.04f;
+  p.armU[0] = 0.28f;
+  p.armU[1] = -0.28f;
+  p.armL[0] = 0.15f;
+  p.armL[1] = 0.1f;
+  p.legU[0] = 0.16f;
+  p.legU[1] = -0.16f;
+  p.legL[0] = 0;
+  p.legL[1] = 0;
+  p.headTilt = 0;
+  p.face = FaceNormal;
+  float breath = sinf(t * 2.6f);
+  switch (st) {
+    case KState::Idle:
+      p.armU[0] += 0.05f * breath;
+      p.armU[1] -= 0.05f * breath;
+      p.headTilt = 0.05f * sinf(t * 0.9f);
+      break;
+    case KState::Jump: {
+      // t is the jump progress 0..1
+      if (t < 0.15f) {  // crouch
+        p.legU[0] = 0.9f;
+        p.legL[0] = -1.6f;
+        p.legU[1] = 0.6f;
+        p.legL[1] = -1.4f;
+        p.armU[0] = -0.6f;
+        p.armU[1] = -0.8f;
+      } else if (t < 0.6f) {  // up, arms up, legs tucked
+        p.armU[0] = 2.6f;
+        p.armU[1] = 2.3f;
+        p.armL[0] = 0.3f;
+        p.armL[1] = 0.2f;
+        p.legU[0] = 1.0f;
+        p.legL[0] = -1.7f;
+        p.legU[1] = 0.4f;
+        p.legL[1] = -1.0f;
+        p.face = FaceHappy;
+      } else {  // landing, legs out
+        p.armU[0] = 1.6f;
+        p.armU[1] = 1.3f;
+        p.legU[0] = 0.4f;
+        p.legL[0] = -0.3f;
+        p.legU[1] = -0.3f;
+        p.legL[1] = -0.2f;
+      }
+      break;
+    }
+    case KState::Sit:
+      p.legU[0] = 1.45f;
+      p.legL[0] = -1.35f + 0.25f * sinf(t * 4);
+      p.legU[1] = 1.35f;
+      p.legL[1] = -1.25f + 0.25f * sinf(t * 4 + 2);
+      p.armU[0] = 0.5f;
+      p.armL[0] = 0.9f;
+      p.armU[1] = -0.5f;
+      p.armL[1] = 0.6f;
+      p.lean = -0.1f;
+      break;
+    case KState::Sleep:
+      p.legU[0] = 1.45f;
+      p.legL[0] = -1.4f;
+      p.legU[1] = 1.4f;
+      p.legL[1] = -1.4f;
+      p.armU[0] = 0.2f;
+      p.armU[1] = 0.1f;
+      p.lean = 0.15f + 0.03f * breath;
+      p.headTilt = 0.6f;
+      p.face = FaceSleep;
+      break;
+    case KState::Pushups: {
+      float up = 0.5f + 0.5f * sinf(t * 6);
+      p.lean = 1.35f;
+      p.armU[0] = 1.35f - 1.25f;
+      p.armL[0] = -0.2f - 1.0f * (1 - up);
+      p.armU[1] = p.armU[0];
+      p.armL[1] = p.armL[0];
+      p.legU[0] = -1.45f + 0.15f * up;
+      p.legU[1] = -1.45f + 0.15f * up;
+      p.face = up > 0.5f ? FaceAngry : FaceNormal;
+      break;
+    }
+    case KState::Dance: {
+      float b = sinf(t * 9);
+      p.lean = 0.25f * b;
+      p.armU[0] = 2.2f + 0.6f * b;
+      p.armL[0] = -0.8f;
+      p.armU[1] = -0.5f - 0.6f * b;
+      p.armL[1] = -1.2f;
+      p.legU[0] = 0.4f + 0.4f * (b > 0 ? b : 0);
+      p.legL[0] = -0.6f * (b > 0 ? b : 0);
+      p.legU[1] = -0.3f;
+      p.face = FaceCool;
+      break;
+    }
+    case KState::Doodling:
+      p.lean = 0.35f;
+      p.armU[0] = 1.0f + 0.3f * sinf(t * 14);
+      p.armL[0] = 0.4f;
+      p.armU[1] = -0.2f;
+      p.legU[0] = 0.4f;
+      p.legU[1] = -0.2f;
+      p.headTilt = 0.4f;
+      break;
+    case KState::Wave:
+      p.armU[0] = 2.7f;
+      p.armL[0] = 0.5f * sinf(t * 12);
+      p.face = FaceHappy;
+      break;
+    case KState::Read:
+      p.armU[0] = 0.9f;
+      p.armL[0] = 1.0f;
+      p.armU[1] = 0.7f;
+      p.armL[1] = 1.2f;
+      p.headTilt = 0.35f;
+      break;
+    case KState::Poked: {
+      float k = clampf(t / 0.25f, 0, 1);
+      p.lean = -0.7f * k + 0.3f * sinf(t * 30) * (1 - clampf(t, 0, 1));
+      p.armU[0] = 2.0f;
+      p.armU[1] = 2.4f;
+      p.legU[0] = 0.6f;
+      p.face = t < 0.8f ? FaceDizzy : FaceAngry;
+      break;
+    }
+    case KState::Hang:
+      p.armU[0] = 2.95f;
+      p.armU[1] = 2.85f;
+      p.armL[0] = 0.1f;
+      p.legU[0] = 0.2f + 0.2f * sinf(t * 7);
+      p.legU[1] = -0.1f + 0.2f * sinf(t * 7 + 1);
+      p.legL[0] = -0.2f;
+      p.face = FaceScared;
+      break;
+    default:
+      break;
+  }
+  return p;
+}
+
+/* ============================================================== drawing */
+
+void draw(Band& b, float x, float y, float scale, int dir, const Pose& p,
+          KDColor ink, bool upsideDown, float erase) {
+  float sc = scale;
+  if (y + 8 * sc < b.clip().y - 40 * sc && !upsideDown) {
+    return;
+  }
+  if (y - 46 * sc > b.clip().bottom() && !upsideDown) {
+    return;
+  }
+  // Legs first: the hip is placed so that the lowest foot touches y
+  float legDown[2];
+  float kneeX[2], kneeY[2], footX[2], footY[2];
+  for (int i = 0; i < 2; i++) {
+    float a1 = p.legU[i], a2 = p.legU[i] + p.legL[i];
+    kneeX[i] = sinf(a1) * k_legU * dir;
+    kneeY[i] = cosf(a1) * k_legU;
+    footX[i] = kneeX[i] + sinf(a2) * k_legL * dir;
+    footY[i] = kneeY[i] + cosf(a2) * k_legL;
+    legDown[i] = footY[i] > kneeY[i] ? footY[i] : kneeY[i];
+  }
+  float down = legDown[0] > legDown[1] ? legDown[0] : legDown[1];
+  if (down < 3) {
+    down = 3;
+  }
+  float hx = 0, hy = -down;
+  float nx = hx + sinf(p.lean) * k_body * dir, ny = hy - cosf(p.lean) * k_body;
+  float sx = hx + sinf(p.lean) * (k_body - 2) * dir,
+        sy = hy - cosf(p.lean) * (k_body - 2);
+  float ha = p.lean + p.headTilt;
+  float cx = nx + sinf(ha) * (k_head + 0.6f) * dir,
+        cy = ny - cosf(ha) * (k_head + 0.6f);
+  float elbowX[2], elbowY[2], handX[2], handY[2];
+  for (int i = 0; i < 2; i++) {
+    float a1 = p.armU[i] + p.lean * 0.5f, a2 = a1 + p.armL[i];
+    elbowX[i] = sx + sinf(a1) * k_armU * dir;
+    elbowY[i] = sy + cosf(a1) * k_armU;
+    handX[i] = elbowX[i] + sinf(a2) * k_armL * dir;
+    handY[i] = elbowY[i] + cosf(a2) * k_armL;
+  }
+  auto X = [&](float lx) { return x + lx * sc; };
+  auto Y = [&](float ly) { return upsideDown ? y - ly * sc : y + ly * sc; };
+  float th = 1.7f * sc;
+  float shake = 0.35f;
+  uint32_t seed = 77;
+  // Strokes in drawing order (head, body, arms, legs): erasing removes the
+  // last ones first, redrawing adds them in order
+  int total = 11;
+  int shown = static_cast<int>(erase * total + 0.999f);
+  int alpha = 256;
+  int i = 0;
+  if (shown > i++) {
+    penCircle(b, X(cx), Y(cy), k_head * sc, k_head * sc, th, ink, seed, 1.f,
+              0.3f, alpha);
+    // the face
+    float ex = X(cx + 1.6f * dir), ey = Y(cy - 0.6f);
+    float gap = 1.9f * sc;
+    switch (p.face) {
+      case FaceHappy:
+        arc(b, ex - gap, ey + 0.6f, 1.1f * sc, 0.9f, 1, ink);
+        arc(b, ex + gap, ey + 0.6f, 1.1f * sc, 0.9f, 1, ink);
+        arc(b, X(cx + 1.2f * dir), Y(cy + 1.4f), 1.8f * sc, 1.f, 2, ink);
+        break;
+      case FaceScared:
+        penCircle(b, ex - gap, ey, 1.2f * sc, 1.4f * sc, 0.8f, ink, seed + 3);
+        penCircle(b, ex + gap, ey, 1.2f * sc, 1.4f * sc, 0.8f, ink, seed + 4);
+        ellipse(b, X(cx + 1.2f * dir), Y(cy + 2.4f), 0.9f * sc, 1.2f * sc, ink);
+        break;
+      case FaceSleep:
+        line(b, ex - gap - 1, ey, ex - gap + 1.2f, ey, 0.9f, ink);
+        line(b, ex + gap - 1, ey, ex + gap + 1.2f, ey, 0.9f, ink);
+        break;
+      case FaceAngry:
+        ellipse(b, ex - gap, ey + 0.4f, 0.8f, 0.8f, ink);
+        ellipse(b, ex + gap, ey + 0.4f, 0.8f, 0.8f, ink);
+        line(b, ex - gap - 1.4f, ey - 2.2f, ex - gap + 1.2f, ey - 1.0f, 0.9f,
+             ink);
+        line(b, ex + gap + 1.4f, ey - 2.2f, ex + gap - 1.2f, ey - 1.0f, 0.9f,
+             ink);
+        line(b, X(cx), Y(cy + 2.6f), X(cx + 2.4f * dir), Y(cy + 2.2f), 0.9f,
+             ink);
+        break;
+      case FaceDizzy:
+        for (int e = -1; e <= 1; e += 2) {
+          float qx = ex + e * gap;
+          line(b, qx - 1, ey - 1, qx + 1, ey + 1, 0.8f, ink);
+          line(b, qx - 1, ey + 1, qx + 1, ey - 1, 0.8f, ink);
+        }
+        break;
+      case FaceCool:
+        line(b, ex - gap - 1.6f, ey, ex + gap + 1.6f, ey, 2.2f, ink);
+        arc(b, X(cx + 1.2f * dir), Y(cy + 1.4f), 1.8f * sc, 1.f, 2, ink);
+        break;
+      case FaceSad:
+        ellipse(b, ex - gap, ey, 0.8f, 0.8f, ink);
+        ellipse(b, ex + gap, ey, 0.8f, 0.8f, ink);
+        arc(b, X(cx + 1.2f * dir), Y(cy + 3.2f), 1.6f * sc, 0.9f, 1, ink);
+        break;
+      default:
+        ellipse(b, ex - gap, ey, 0.85f, 0.95f, ink);
+        ellipse(b, ex + gap, ey, 0.85f, 0.95f, ink);
+        line(b, X(cx + 0.4f * dir), Y(cy + 2.3f), X(cx + 2.4f * dir),
+             Y(cy + 2.1f), 0.9f, ink);
+        break;
+    }
+  }
+  if (shown > i++) {
+    pen(b, X(hx), Y(hy), X(nx), Y(ny), th, ink, seed + 10, shake, alpha);
+  }
+  for (int a = 0; a < 2; a++) {
+    if (shown > i++) {
+      pen(b, X(sx), Y(sy), X(elbowX[a]), Y(elbowY[a]), th, ink, seed + 20 + a,
+          shake, alpha);
+    }
+    if (shown > i++) {
+      pen(b, X(elbowX[a]), Y(elbowY[a]), X(handX[a]), Y(handY[a]), th, ink,
+          seed + 30 + a, shake, alpha);
+    }
+  }
+  for (int l = 0; l < 2; l++) {
+    if (shown > i++) {
+      pen(b, X(hx), Y(hy), X(kneeX[l]), Y(kneeY[l] - down), th, ink,
+          seed + 40 + l, shake, alpha);
+    }
+    if (shown > i++) {
+      pen(b, X(kneeX[l]), Y(kneeY[l] - down), X(footX[l]), Y(footY[l] - down),
+          th, ink, seed + 50 + l, shake, alpha);
+    }
+  }
+}
+
+/* =========================================================== behaviour */
+
+float slotX(int slot) {
+  Rect r = cellRect(slot);
+  return r.x + r.w / 2 + 16;
+}
+
+float slotY(int slot) {
+  Rect r = cellRect(slot);
+  return r.y + 21;
+}
+
+void reset() {
+  memset(&s.k, 0, sizeof(s.k));
+  s.k.dir = -1;
+  s.k.x = slotX(0);
+  s.k.y = slotY(0);
+  s.k.st = KState::Idle;
+  s.k.t0 = s.now;
+  s.k.gag = GagNone;
+  s.k.nextIdea = s.now + 7000;
+}
+
+void say(const char* text, int ms) {
+  if (!s.kevinTalks) {
+    return;
+  }
+  strlcpy(s.k.say, text, sizeof(s.k.say));
+  s.k.sayStart = s.now;
+  s.k.sayUntil = s.now + ms;
+}
+
+bool busy() {
+  return s.k.st == KState::Dive || s.k.st == KState::Emerge ||
+         s.k.st == KState::Erased || s.k.gag != GagNone;
+}
+
+void jumpTo(float x, float y, KState after) {
+  s.k.jx0 = s.k.x;
+  s.k.jy0 = s.k.y;
+  s.k.jx1 = x;
+  s.k.jy1 = y;
+  float d = sqrtf((x - s.k.x) * (x - s.k.x) + (y - s.k.y) * (y - s.k.y));
+  s.k.jdur = 300 + static_cast<uint32_t>(d * 1.6f);
+  s.k.jh = 14 + d * 0.18f;
+  if (fabsf(x - s.k.x) > 1) {
+    s.k.dir = x > s.k.x ? 1 : -1;
+  }
+  s.k.after = after;
+  setState(KState::Jump);
+}
+
+void goToSlot(int slot, bool jump) {
+  if (busy()) {
+    return;
+  }
+  float x = slotX(slot), y = slotY(slot);
+  if (!jump) {
+    s.k.x = x;
+    s.k.y = y;
+    setState(KState::Idle);
+    return;
+  }
+  jumpTo(x, y, KState::Idle);
+  s.k.nextIdea = s.now + 6000 + rnd() % 6000;
+}
+
+void poke() {
+  if (s.k.st == KState::Dive || s.k.st == KState::Erased ||
+      s.k.st == KState::Emerge) {
+    return;
+  }
+  s.pokes++;
+  setState(KState::Poked);
+  shake(250);
+  burst(s.k.x, s.k.y - 26, 6, k_graphite, 2);
+  say(k_pokeLines[rnd() % (sizeof(k_pokeLines) / sizeof(k_pokeLines[0]))],
+      2200);
+}
+
+void erase() {
+  if (s.k.st == KState::Dive || s.k.st == KState::Erased) {
+    return;
+  }
+  s.erasures++;
+  s.k.gag = GagNone;
+  s.k.upsideDown = false;
+  s.k.sayUntil = 0;
+  setState(KState::Erased);
+}
+
+void dive() {
+  s.k.gag = GagNone;
+  s.k.upsideDown = false;
+  s.k.sayUntil = 0;
+  s.dives++;
+  setState(KState::Dive);
+}
+
+void comeBack(int appIndex) {
+  int page = pageOfApp(appIndex);
+  int slot = slotOfApp(appIndex);
+  (void)page;
+  Rect r = cellRect(slot);
+  s.k.x = r.x + r.w / 2;
+  s.k.y = r.y + 46;
+  s.k.dir = 1;
+  s.k.upsideDown = false;
+  s.k.gag = gagForApp(appIndex);
+  s.k.gagStart = s.now + 650;
+  setState(KState::Emerge);
+}
+
+void pageTurned(int dir) {
+  if (s.k.gag != GagNone || s.k.st == KState::Erased) {
+    return;
+  }
+  setState(KState::Hang);
+  s.k.dir = -dir;
+}
+
+namespace {
+
+void addGraffiti() {
+  int i = s.graffitiCount < k_maxGraffiti ? s.graffitiCount++
+                                           : static_cast<int>(rnd() % k_maxGraffiti);
+  Graffiti& g = s.graffiti[i];
+  g.page = s.page;
+  g.kind = rnd() % 9;
+  g.x = clampi(static_cast<int>(s.k.x + s.k.dir * 16), 44, 300);
+  g.y = clampi(static_cast<int>(s.k.y - 6), 30, 228);
+  g.seed = rnd();
+}
+
+void idleIdea() {
+  uint32_t idle = s.now - s.lastInput;
+  if (idle > 45000) {
+    setState(KState::Sleep);
+    return;
+  }
+  int r = rnd() % 10;
+  if (r < 3 && s.kevinTalks) {
+    setState(KState::Wave);
+    say(k_idleLines[rnd() % k_numberOfIdleLines], 3800);
+  } else if (r == 3) {
+    setState(KState::Sit);
+  } else if (r == 4) {
+    setState(KState::Pushups);
+    say("Une... deux... je compte en binaire.", 2400);
+  } else if (r == 5) {
+    setState(KState::Dance);
+  } else if (r == 6 || r == 7) {
+    setState(KState::Doodling);
+  } else if (r == 8) {
+    setState(KState::Read);
+    say("Je lis le manuel de la calculatrice. Spoiler : 42.", 3000);
+  } else {
+    setState(KState::Sit);
+    say(k_idleLines[rnd() % k_numberOfIdleLines], 3600);
+  }
+}
+
+}  // namespace
+
+void update(float dt) {
+  Kevin& k = s.k;
+  uint32_t t = since(k.t0);
+  switch (k.st) {
+    case KState::Jump: {
+      float p = static_cast<float>(t) / k.jdur;
+      if (p >= 1) {
+        k.x = k.jx1;
+        k.y = k.jy1;
+        burst(k.x, k.y, 4, 0x8A8A90, 0);
+        setState(k.after);
+      } else {
+        float e = p * p * (3 - 2 * p);
+        k.x = k.jx0 + (k.jx1 - k.jx0) * e;
+        k.y = k.jy0 + (k.jy1 - k.jy0) * e - k.jh * 4 * p * (1 - p);
+      }
+      break;
+    }
+    case KState::Poked:
+      if (t > 1400) {
+        setState(KState::Idle);
+      }
+      break;
+    case KState::Hang:
+      break;
+    case KState::Erased:
+      if (t > 2600) {
+        say(k_eraseLines[rnd() % 4], 2600);
+        setState(KState::Idle);
+        k.nextIdea = s.now + 8000;
+      }
+      break;
+    case KState::Dive:
+      break;
+    case KState::Emerge:
+      if (t > 650) {
+        setState(KState::Idle);
+        k.gagStart = s.now;
+      }
+      break;
+    case KState::Doodling:
+      if (t > 2200) {
+        addGraffiti();
+        say("Voil\xC3\xA0. C'est de l'art.", 1800);
+        setState(KState::Idle);
+        k.nextIdea = s.now + 9000 + rnd() % 8000;
+      }
+      break;
+    case KState::Sleep:
+      if ((s.now / 700) != ((s.now - static_cast<uint32_t>(dt * 1000)) / 700)) {
+        burst(k.x + 6 * k.dir, k.y - 34, 1, k_graphite, 3);
+      }
+      break;
+    case KState::Idle:
+      if (k.gag == GagNone && s.mode == Mode::Page && !s.turning &&
+          s.now > k.nextIdea) {
+        idleIdea();
+        k.nextIdea = s.now + 9000 + rnd() % 9000;
+      }
+      break;
+    default:
+      // Sit, Pushups, Dance, Wave, Read: a few seconds, then back to idle
+      if (t > (k.st == KState::Sit ? 7000u : 3200u)) {
+        setState(KState::Idle);
+      }
+      break;
+  }
+  // The gag, then back to the selected doodle
+  if (k.gag != GagNone && s.now > k.gagStart &&
+      s.now - k.gagStart > k_gagDuration) {
+    k.gag = GagNone;
+    k.upsideDown = false;
+    goToSlot(s.selected, true);
+  }
+  // Coins of the finance gag, drops of the solver gag
+  if (k.gag == GagRich && s.now > k.gagStart &&
+      s.now - k.gagStart < k_gagDuration - 1500 && (rnd() & 3) == 0) {
+    Particle* p = nullptr;
+    for (Particle& q : s.particles) {
+      if (q.life == 0) {
+        p = &q;
+        break;
+      }
+    }
+    if (p) {
+      p->x = 40 + frnd() * 270;
+      p->y = -6;
+      p->vx = 0;
+      p->vy = 60 + frnd() * 60;
+      p->life = p->maxLife = 3000;
+      p->rgb565 = static_cast<uint16_t>(rgb(0xE0A800));
+      p->size = 4;
+      p->kind = 1;
+    }
+  }
+}
