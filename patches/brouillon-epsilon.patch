+
+void renderGag(Band& b) {
+  Kevin& k = s.k;
+  KDColor ink = rgb(k_graphite);
+  float t = (s.now - k.t0) / 1000.f;
+  // Kevin is drawn by the gag while it runs
+  if (k.gag != GagNone && s.now >= k.gagStart && k.st != KState::Emerge) {
+    float g = (s.now - k.gagStart) / 1000.f;
+    float end = k_gagDuration / 1000.f;
+    Pose p = pose(KState::Idle, g, k.dir);
+    switch (k.gag) {
+      case GagCalcul: {
+        const Food::Entry* e =
+            Food::produced() ? Food::at(Food::produced() - 1) : nullptr;
+        p.armU[0] = p.armU[1] = 2.9f;
+        p.armL[0] = p.armL[1] = 0;
+        p.face = FaceHappy;
+        draw(b, k.x, k.y, k_scale, k.dir, p, ink);
+        drawSign(b, k.x + 1, k.y - 40, e ? e->output : "rien ?");
+        break;
+      }
+      case GagGraph: {
+        float xs[24], ys[24];
+        for (int i = 0; i < 24; i++) {
+          xs[i] = 30 + i * 12.5f;
+          ys[i] = 175 + 28 * sinf(xs[i] * 0.035f + 0.6f);
+        }
+        penPath(b, xs, ys, 24, false, 2.f, rgb(k_ink), 900, 0.6f,
+                clampf(g * 2.5f, 0, 1));
+        float px = -20 + (g - 0.3f) * 80;
+        if (px > 20) {
+          float py = 175 + 28 * sinf(px * 0.035f + 0.6f);
+          float slope = 28 * 0.035f * cosf(px * 0.035f + 0.6f);
+          p.lean = atanf(slope) * 0.8f;
+          p.armU[0] = 1.6f;
+          p.armU[1] = -1.6f;
+          p.legU[0] = 0.5f;
+          p.legL[0] = -0.6f;
+          p.legU[1] = -0.4f;
+          p.face = FaceCool;
+          draw(b, px, py - 3, k_scale, 1, p, ink);
+          if (g < 1.2f) {
+            k.x = px;
+          }
+          pen(b, px - 9, py - 1, px + 9, py - 1 + slope * 9, 2, rgb(0xB0402A), 910);
+          if (g > 0.8f && g < 3.2f) {
+            bubble(b, "WOUHOU ! sin(x) !", static_cast<int>(px),
+                   static_cast<int>(py - 42), static_cast<int>(px),
+                   static_cast<int>(py - 34), 911);
+          }
+        }
+        k.x = px;
+        k.y = 175 + 28 * sinf(px * 0.035f + 0.6f) - 3;
+        k.dir = 1;
+        break;
+      }
+      case GagSolver: {
+        p.face = FaceSad;
+        p.armU[0] = 2.4f;
+        p.armL[0] = 1.6f;
+        draw(b, k.x, k.y, k_scale, k.dir, p, ink);
+        bigHand(b, "x", static_cast<int>(k.x + 2 * k.dir) - 6,
+                static_cast<int>(k.y - 54), 2, rgb(k_red), 4);
+        if ((s.now / 300) % 3 == 0) {
+          ellipse(b, k.x - 6 * k.dir, k.y - 36 + fmodf(g * 20, 10), 1.2f, 2.f,
+                  rgb(0x4AA0E0));
+        }
+        if (g < end - 1) {
+          bubble(b, "Pas trouv\xC3\xA9 x. Il \xC3\xA9tait o\xC3\xB9 ?",
+                 static_cast<int>(k.x), static_cast<int>(k.y - 58),
+                 static_cast<int>(k.x), static_cast<int>(k.y - 50), 920);
+        }
+        break;
+      }
+      case GagStats: {
+        float bars[4];
+        for (int i = 0; i < 4; i++) {
+          bars[i] = 20 + 34 * (0.5f + 0.5f * sinf(g * 3 + i * 1.7f));
+          float x = 120 + i * 22;
+          Rect r = {static_cast<int>(x), static_cast<int>(232 - bars[i]), 18,
+                    static_cast<int>(bars[i])};
+          fill(b, r, rgb(0xFFFFFF));
+          hatch(b, r, 4, rgb(k_ink), 930 + i);
+          pen(b, x, 232, x, 232 - bars[i], 1.5f, rgb(k_ink), 940 + i);
+          pen(b, x, 232 - bars[i], x + 18, 232 - bars[i], 1.5f, rgb(k_ink), 944 + i);
+          pen(b, x + 18, 232 - bars[i], x + 18, 232, 1.5f, rgb(k_ink), 948 + i);
+        }
+        int on = static_cast<int>(g * 1.3f) % 4;
+        k.x = 129 + on * 22;
+        k.y = 232 - bars[on];
+        p.face = FaceScared;
+        p.armU[0] = 2.4f;
+        p.armU[1] = 2.2f;
+        draw(b, k.x, k.y, k_scale, k.dir, p, ink);
+        if (g > 1 && g < end - 1) {
+          bubble(b, "Mon moral en histogramme.", 160, 120, static_cast<int>(k.x),
+                 static_cast<int>(k.y - 30), 950);
+        }
+        break;
+      }
+      case GagDice: {
+        float x = -20 + g * 70, y = 205;
+        if (x > 250) {
+          x = 250;
+        }
+        float a = x / 14.f;
+        float xs[4], ys[4];
+        for (int i = 0; i < 4; i++) {
+          float aa = a + i * 1.5708f + 0.785f;
+          xs[i] = x + cosf(aa) * 22;
+          ys[i] = y + sinf(aa) * 22;
+        }
+        polygon(b, xs, ys, 4, rgb(0xFFFFFF));
+        penPath(b, xs, ys, 4, true, 1.8f, rgb(k_ink), 960);
+        p.face = FaceDizzy;
+        p.lean = a;
+        if (x < 250) {
+          float sa = sinf(a), ca = cosf(a);
+          (void)sa;
+          (void)ca;
+          // Kevin is inside, upside down half of the time
+          draw(b, x, y + 13, 0.7f, 1, p, ink, (static_cast<int>(a / 1.5708f) & 2));
+        } else {
+          for (int i = 0; i < 6; i++) {
+            ellipse(b, x - 8 + (i % 3) * 8, y - 5 + (i / 3) * 10, 2, 2,
+                    rgb(k_ink));
+          }
+          draw(b, x + 34, y + 22, k_scale, -1, p, ink);
+          bubble(b, "Six. Comme mes points de vie.", 220, 150, 284, 196, 961);
+        }
+        k.x = x < 250 ? x : x + 34;
+        k.y = x < 250 ? y + 13 : y + 22;
+        break;
+      }
+      case GagClones: {
+        int n = 1 + static_cast<int>(g * 1.2f);
+        if (n > 5) {
+          n = 5;
+        }
+        float scale = k_scale;
+        float x = k.x;
+        for (int i = 0; i < n; i++) {
+          Pose q = pose(KState::Dance, g + i * 0.3f, 1);
+          draw(b, x, k.y, scale, 1, q, ink);
+          x += 22 * scale + 4;
+          scale *= 0.72f;
+        }
+        if (g > 1.5f) {
+          bubble(b, "u(n+1) = 0,72 u(n). On r\xC3\xA9tr\xC3\xA9\x63it !",
+                 static_cast<int>(k.x + 30), static_cast<int>(k.y + 8),
+                 static_cast<int>(k.x), static_cast<int>(k.y + 1), 970);
+        }
+        break;
+      }
+      case GagLine: {
+        float x0 = 50, y0 = 80, x1 = 290, y1 = 220;
+        pen(b, x0, y0, x1, y1, 2, rgb(k_ink), 980);
+        for (int i = 0; i < 9; i++) {
+          float u = (i + 0.5f) / 9;
+          float px = x0 + (x1 - x0) * u;
+          float py = y0 + (y1 - y0) * u + (i & 1 ? -14 : 12) * clampf(1.6f - g, 0, 1);
+          pen(b, px - 3, py - 3, px + 3, py + 3, 1.3f, rgb(k_ink), 981 + i);
+          pen(b, px + 3, py - 3, px - 3, py + 3, 1.3f, rgb(k_ink), 991 + i);
+        }
+        float u = clampf(g / (end - 1), 0, 1);
+        k.x = x0 + (x1 - x0) * u;
+        k.y = y0 + (y1 - y0) * u - 2;
+        p.lean = 0.5f;
+        p.armU[0] = 1.6f;
+        p.armU[1] = -1.6f;
+        p.face = FaceHappy;
+        draw(b, k.x, k.y, k_scale, 1, p, ink);
+        if (g > 0.6f && g < end - 1.5f) {
+          bubble(b, "r = 1. Je suis LA droite.", 120, 60, static_cast<int>(k.x),
+                 static_cast<int>(k.y - 32), 999);
+        }
+        break;
+      }
+      case GagStamp: {
+        // A giant rubber stamp: H0 is rejected, and so is Kevin
+        float drop = clampf((g - 0.7f) * 6, 0, 1);
+        bool pressed = g > 0.7f + 1 / 6.f;
+        float lift = g > 1.7f ? (g - 1.7f) * 220 : 0;
+        float sy = k.y - 78 + (k.y - (k.y - 78)) * drop * drop - lift;
+        if (pressed) {
+          // flat as a pancake
+          Pose q = pose(KState::Idle, g, k.dir);
+          q.face = FaceDizzy;
+          q.lean = 1.5f;
+          q.legU[0] = q.legU[1] = -1.5f;
+          q.armU[0] = 2.6f;
+          q.armU[1] = 0.6f;
+          draw(b, k.x - 10, k.y, k_scale, 1, q, ink);
+        } else {
+          p.face = FaceScared;
+          p.armU[0] = p.armU[1] = 2.6f;
+          draw(b, k.x, k.y, k_scale, k.dir, p, ink);
+        }
+        if (g > 1.7f) {
+          Rect st = {static_cast<int>(k.x - 44), static_cast<int>(k.y - 24), 88, 22};
+          roundFrame(b, st, 3, rgb(k_red), 210);
+          roundFrame(b, {st.x + 2, st.y + 2, st.w - 4, st.h - 4}, 2, rgb(k_red), 150);
+          hand(b, "H0 REJET\xC3\x89\x45", static_cast<int>(k.x), st.y + 4,
+               rgb(k_red), KDFont::Size::Small, 1001, Align::Center, -1, 220);
+        }
+        if (sy > -40) {
+          int x = static_cast<int>(k.x);
+          int y = static_cast<int>(sy);
+          disc(b, x, y - 34, 8, rgb(0x8A5A32));
+          fill(b, {x - 5, y - 30, 10, 16}, rgb(0x8A5A32));
+          roundFill(b, {x - 40, y - 15, 80, 13}, 3, rgb(0x4A3020));
+          fill(b, {x - 38, y - 3, 76, 3}, rgb(0xB01828));
+        }
+        if (g > 2.4f && g < end - 0.4f) {
+          bubble(b, "Rejet\xC3\xA9. Comme mes devoirs.", static_cast<int>(k.x),
+                 static_cast<int>(k.y - 30), static_cast<int>(k.x),
+                 static_cast<int>(k.y - 24), 1002);
+        }
+        break;
+      }
+      case GagRich: {
+        p.face = FaceCool;
+        p.armU[0] = 1.3f;
+        p.armL[0] = 1.4f;
+        draw(b, k.x, k.y, k_scale, k.dir, p, ink);
+        // top hat
+        float hx = k.x + 2 * k.dir, hy = k.y - 37;
+        fill(b, {static_cast<int>(hx - 5), static_cast<int>(hy - 12), 11, 12}, ink);
+        fill(b, {static_cast<int>(hx - 9), static_cast<int>(hy - 1), 19, 3}, ink);
+        penCircle(b, k.x + 4 * k.dir, k.y - 30, 2.2f, 2.2f, 0.9f, rgb(0xC09000), 1010);
+        if (g > 0.8f && g < end - 0.8f) {
+          bubble(b, "Je suis riche. 2 centimes.", static_cast<int>(k.x),
+                 static_cast<int>(k.y - 54), static_cast<int>(k.x),
+                 static_cast<int>(k.y - 48), 1011);
+        }
+        break;
+      }
+      case GagSnake: {
+        float kx = 20 + g * 75;
+        float sx = kx - 40 - 10 * sinf(g * 3);
+        float y = 214;
+        k.x = kx;
+        k.y = y;
+        Pose q = pose(KState::Jump, 0.4f, 1);
+        float run = sinf(g * 18);
+        q.legU[0] = 0.9f * run;
+        q.legL[0] = -0.6f;
+        q.legU[1] = -0.9f * run;
+        q.legL[1] = -0.6f;
+        q.armU[0] = -0.9f * run;
+        q.armU[1] = 0.9f * run;
+        q.lean = 0.35f;
+        q.face = FaceScared;
+        draw(b, kx, y, k_scale, 1, q, ink);
+        float xs[20], ys[20];
+        for (int i = 0; i < 20; i++) {
+          xs[i] = sx - i * 4.5f;
+          ys[i] = y - 5 + 5 * sinf(g * 10 - i * 0.6f);
+        }
+        penPath(b, xs, ys, 20, false, 4.f, rgb(0x2E8B3A), 1020, 0.3f);
+        disc(b, static_cast<int>(sx + 2), static_cast<int>(ys[0] - 2), 5,
+             rgb(0x2E8B3A));
+        ellipse(b, sx + 4, ys[0] - 4, 1.3f, 1.3f, rgb(0xFFFFFF));
+        pen(b, sx + 7, ys[0], sx + 13, ys[0] + (static_cast<int>(g * 8) & 1 ? -2 : 2),
+            1, rgb(k_red), 1021, 0.2f);
+        if (g < end - 0.5f) {
+          bubble(b, "IL Y A UN VRAI SERPENT DANS PYTHON", 160, 150,
+                 static_cast<int>(kx), static_cast<int>(y - 34), 1022);
+        }
+        break;
+      }
+      case GagBoom: {
+        if (g < 0.5f) {
+          blob(b, k.x, k.y - 15, 10 + g * 70, 0.4f, rgb(0xFFB020), 1030);
+          blob(b, k.x, k.y - 15, 6 + g * 45, 0.4f, rgb(0xFFF0A0), 1031);
+        } else if (g < 1.6f) {
+          blob(b, k.x, k.y - 20 - (g - 0.5f) * 20, 40 - (g - 0.5f) * 25, 0.35f,
+               rgb(0x9A9AA4), 1032, 170);
+        }
+        if (g > 0.4f) {
+          Pose q = pose(KState::Idle, g, k.dir);
+          q.face = FaceDizzy;
+          q.armU[0] = 0.5f;
+          q.armU[1] = -0.5f;
+          draw(b, k.x, k.y, k_scale, k.dir, q, rgb(0x101010));
+          // hair standing up
+          for (int i = -2; i <= 2; i++) {
+            pen(b, k.x + 2 * k.dir + i * 2, k.y - 36, k.x + 2 * k.dir + i * 4,
+                k.y - 44, 1, rgb(0x101010), 1040 + i, 0.6f);
+          }
+          if (g > 1.2f && g < end - 0.5f) {
+            bubble(b, "Na + H2O. Ne faites pas \xC3\xA7\x61 chez vous.",
+                   static_cast<int>(k.x), static_cast<int>(k.y - 54),
+                   static_cast<int>(k.x), static_cast<int>(k.y - 46), 1045);
+          }
+        }
+        break;
+      }
+      case GagUpsideDown: {
+        // He walks on the top of the page, head down
+        k.upsideDown = true;
+        float x = 300 - g * 50;
+        k.x = x;
+        k.y = 24;
+        k.dir = -1;
+        Pose q = pose(KState::Idle, g, -1);
+        float run = sinf(g * 8);
+        q.legU[0] = 0.5f * run;
+        q.legU[1] = -0.5f * run;
+        q.face = FaceDizzy;
+        draw(b, x, 24, k_scale, -1, q, ink, true);
+        if (g > 0.5f && g < end - 0.5f) {
+          bubble(b, "Quelqu'un a r\xC3\xA9gl\xC3\xA9 la gravit\xC3\xA9.",
+                 static_cast<int>(clampf(x, 90, 230)), 92, static_cast<int>(x),
+                 66, 1050);
+        }
+        break;
+      }
+      case GagGamer: {
+        Pose q = pose(KState::Sit, g, k.dir);
+        q.armU[0] = 1.2f;
+        q.armL[0] = 0.8f + 0.3f * sinf(g * 30);
+        q.armU[1] = 1.0f;
+        q.armL[1] = 0.9f + 0.3f * sinf(g * 27);
+        draw(b, k.x, k.y, k_scale, k.dir, q, ink);
+        // headset
+        arc(b, k.x + 1.5f * k.dir, k.y - 33, 5.5f, 1.4f, 1, rgb(0x303038));
+        fill(b, {static_cast<int>(k.x - 5), static_cast<int>(k.y - 33), 3, 5},
+             rgb(0xD02040));
+        // square red eyes
+        fill(b, {static_cast<int>(k.x + 1 * k.dir), static_cast<int>(k.y - 31), 2, 2},
+             rgb(0xFF2020));
+        fill(b, {static_cast<int>(k.x + 4 * k.dir), static_cast<int>(k.y - 31), 2, 2},
+             rgb(0xFF2020));
+        if (g > 0.6f && g < end - 0.5f) {
+          bubble(b, "Encore une partie. Une seule. Promis.",
+                 static_cast<int>(k.x), static_cast<int>(k.y - 50),
+                 static_cast<int>(k.x), static_cast<int>(k.y - 44), 1060);
+        }
+        break;
+      }
+      default:
+        break;
+    }
+    return;
+  }
+
+  // Normal Kevin
+  switch (k.st) {
+    case KState::Jump: {
+      float p = static_cast<float>(s.now - k.t0) / k.jdur;
+      draw(b, k.x, k.y, k_scale, k.dir, pose(KState::Jump, p, k.dir), ink);
+      break;
+    }
+    case KState::Dive: {
+      // Up, then head first into the doodle, shrinking, with an ink splash
+      Rect r = cellRect(s.selected);
+      float cx = r.x + r.w / 2, cy = r.y + 46;
+      float p = clampf(t / 0.62f, 0, 1);
+      float x = k.x + (cx - k.x) * p;
+      float y = k.y + (cy - k.y) * p - 30 * sinf(p * 3.14159f);
+      float sc = k_scale * (1 - 0.85f * p * p);
+      Pose q = pose(KState::Jump, 0.4f, k.dir);
+      q.lean = 3.14159f * p;
+      q.armU[0] = q.armU[1] = 2.9f;
+      q.face = FaceHappy;
+      if (p < 1) {
+        draw(b, x, y, sc, k.dir, q, ink);
+      }
+      if (p > 0.8f) {
+        float r2 = (p - 0.8f) * 60;
+        penCircle(b, cx, cy, r2, r2 * 0.5f, 1.2f, rgb(k_ink), 1100, 1.f, 0.8f,
+                  static_cast<int>(256 * (1 - (p - 0.8f) * 4)));
+      }
+      break;
+    }
+    case KState::Emerge: {
+      float p = clampf(t / 0.65f, 0, 1);
+      float sc = k_scale * easeOut(p);
+      float y = k.y - 20 * easeOut(p);
+      Pose q = pose(KState::Jump, 0.4f, k.dir);
+      draw(b, k.x, y, sc < 0.05f ? 0.05f : sc, k.dir, q, ink);
+      penCircle(b, k.x, k.y, 10 + p * 20, 4 + p * 8, 1.2f, rgb(k_ink), 1110,
+                1.f, 0.8f, static_cast<int>(256 * (1 - p)));
+      if (p >= 1) {
+        k.y = y;
+      }
+      break;
+    }
+    case KState::Erased: {
+      float e;
+      uint32_t ms = s.now - k.t0;
+      if (ms < 1100) {
+        e = 1 - ms / 1100.f;
+      } else if (ms < 1600) {
+        e = 0;
+      } else {
+        e = clampf((ms - 1600) / 1000.f, 0, 1);
+      }
+      if (e > 0) {
+        draw(b, k.x, k.y, k_scale, k.dir,
+             pose(ms < 1100 ? KState::Poked : KState::Idle, 0.9f, k.dir),
+             ms < 1100 ? ink : rgb(k_graphite), false, e);
+      }
+      if (ms < 1300) {
+        // the eraser rubbing him out
+        float ex = k.x + 10 * sinf(ms * 0.03f), ey = k.y - 20 + 10 * sinf(ms * 0.011f);
+        Rect body = {static_cast<int>(ex - 8), static_cast<int>(ey - 14), 16, 26};
+        roundFill(b, body, 3, rgb(0xF4A0B4));
+        fill(b, {body.x, body.y, body.w, 9}, rgb(0x3060C0));
+        roundFrame(b, body, 3, rgb(0x5A2A3A));
+      }
+      if (ms > 1500 && ms < 2600) {
+        // he redraws himself with a pencil
+        float px = k.x + 14 * sinf(ms * 0.02f), py = k.y - 34 * e;
+        pen(b, px, py, px + 10, py - 14, 3, rgb(0xE8B020), 1120, 0.2f);
+        pen(b, px, py, px + 2, py - 3, 1.5f, rgb(k_graphite), 1121, 0.1f);
+      }
+      break;
+    }
+    default:
+      draw(b, k.x, k.y, k_scale, k.dir, pose(k.st, t, k.dir), ink,
+           k.upsideDown);
+      if (k.st == KState::Read) {
+        Rect book = {static_cast<int>(k.x + 7 * k.dir - 6),
+                     static_cast<int>(k.y - 24), 12, 9};
+        fill(b, book, rgb(k_red));
+        line(b, book.x + 6, book.y, book.x + 6, book.bottom(), 1,
+             rgb(0xFFFFFF));
+      }
+      if (k.st == KState::Doodling) {
+        float px = k.x + 12 * k.dir, py = k.y - 8;
+        pen(b, px, py, px + 6 * k.dir, py - 9, 2.5f, rgb(0xE8B020), 1130, 0.2f);
+      }
+      break;
+  }
+  // Speech bubble
+  if (s.now < k.sayUntil && k.gag == GagNone && k.st != KState::Erased &&
+      k.st != KState::Dive) {
+    int bx = clampi(static_cast<int>(k.x), 95, 225);
+    bubble(b, k.say, bx, static_cast<int>(k.y - 38), static_cast<int>(k.x),
+           static_cast<int>(k.y - 32), 1200 + (k.sayStart & 0xFF));
+  }
+}
