+  m.add("N\xC3\xA9on de la classe : ");
+  int bars = v * 8 / Ion::Backlight::MaxBrightness;
+  for (int i = 0; i < 8; i++) {
+    m.add(i < bars ? "|" : ".");
+  }
+  toast(t, 1400);
+}
