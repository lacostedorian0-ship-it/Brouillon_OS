+/* ===================================================== page turn render */
+
+void renderTurn(Band& b) {
+  float p = static_cast<float>(s.now - s.turnStart) / k_turnDuration;
+  if (p > 1) {
+    p = 1;
+  }
+  float e = p * p * (3 - 2 * p);
+  bool forward = s.turnTo > s.turnFrom;
+  Rect area = b.area();
+  Rect saved = b.clip();
+  auto draw = [&](int page, bool live) {
+    if (page < 0) {
+      renderCover(b, k_coverDuration);
+    } else {
+      drawPageContent(b, page, live);
+    }
+  };
+  if (forward) {
+    float f = k_screenWidth * (1 - e);
+    float flapLeft = 2 * f - k_screenWidth;
+    int a = static_cast<int>(flapLeft < 0 ? 0 : flapLeft);
+    int fi = static_cast<int>(f);
+    if (a > 0 && b.setClip({0, area.y, a, area.h})) {
+      draw(s.turnFrom, false);
+    }
+    if (fi < k_screenWidth && b.setClip({fi, area.y, k_screenWidth - fi, area.h})) {
+      draw(s.turnTo, true);
+      for (int i = 0; i < 16; i++) {
+        fill(b, {fi + i, area.y, 1, area.h}, rgb(0x000000), (16 - i) * 6);
+      }
+    }
+    if (fi > a && b.setClip({a, area.y, fi - a, area.h})) {
+      // the back of the page: paper, a little darker
+      paper(b, 0, false);
+      fill(b, {a, area.y, fi - a, area.h}, rgb(0x7080A0), 34);
+      fill(b, {fi - 6, area.y, 6, area.h}, rgb(0x000000), 20);
+      fill(b, {a, area.y, 2, area.h}, rgb(0x5A6070), 120);
+    }
+  } else {
+    float f = k_screenWidth * e;
+    float flapRight = 2 * f;
+    int fi = static_cast<int>(f);
+    int r = static_cast<int>(flapRight > k_screenWidth ? k_screenWidth : flapRight);
+    if (r < k_screenWidth && b.setClip({r, area.y, k_screenWidth - r, area.h})) {
+      draw(s.turnFrom, false);
+    }
+    if (fi > 0 && b.setClip({0, area.y, fi, area.h})) {
+      draw(s.turnTo, true);
+      for (int i = 0; i < 16; i++) {
+        fill(b, {fi - 1 - i, area.y, 1, area.h}, rgb(0x000000), (16 - i) * 6);
+      }
+    }
+    if (r > fi && b.setClip({fi, area.y, r - fi, area.h})) {
+      paper(b, 0, false);
+      fill(b, {fi, area.y, r - fi, area.h}, rgb(0x7080A0), 34);
+      fill(b, {r - 2, area.y, 2, area.h}, rgb(0x5A6070), 120);
+    }
+  }
+  b.setClip(saved);
+  // Kevin hangs on to the edge of the page
+  if (s.k.st == KState::Hang) {
+    float edge = forward ? 2 * k_screenWidth * (1 - e) - k_screenWidth
+                         : 2 * k_screenWidth * e;
+    edge = edge < 8 ? 8 : (edge > 312 ? 312 : edge);
+    Pose q = Kev::pose(KState::Hang, (s.now - s.k.t0) / 1000.f, s.k.dir);
+    Kev::draw(b, edge, 120 + 6 * sinf(p * 9), 0.9f, s.k.dir, q,
+              rgb(k_graphite));
+  }
+}
