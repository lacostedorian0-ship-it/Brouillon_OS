+/* ================================================================ cover */
+
+namespace {
+
+void renderCover(Band& b, uint32_t t) {
+  // Dark blue cardboard
+  const Rect& z = b.clip();
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      uint32_t h = hash(x * 3 + y * 1031);
+      int v = (h & 7);
+      row[x] = KDColor::RGB888(24 + v, 48 + v, 110 + v * 2);
+    }
+  }
+  // Label
+  Rect label = {48, 58, 224, 120};
+  roundFill(b, {label.x + 3, label.y + 3, label.w, label.h}, 10, rgb(0x0A1A40),
+            120);
+  roundFill(b, label, 10, rgb(0xFFFDF4));
+  roundFrame(b, {label.x + 4, label.y + 4, label.w - 8, label.h - 8}, 7,
+             rgb(0x1D3C9A));
+  int written = static_cast<int>(t / 110);
+  bigHand(b, "BROUILLON", 160, 70, 2, rgb(k_ink), 77, Align::Center, written);
+  KDColor gray = rgb(0x6A6A74);
+  hand(b, "Nom :", 62, 120, gray, Small, 3);
