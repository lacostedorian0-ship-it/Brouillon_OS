+/* ======================================================= the crack prank */
+
+void addCrackRay(float x, float y, float angle, int segments, int depth,
+                 float born) {
+  for (int i = 0; i < segments && s.crackCount < k_maxCracks; i++) {
+    float len = (depth ? 9 : 16) + frnd() * (depth ? 14 : 24);
+    angle += (frnd() - 0.5f) * 0.7f;
+    float nx = x + cosf(angle) * len, ny = y + sinf(angle) * len;
+    Crack& c = s.cracks[s.crackCount++];
+    c.x0 = x;
+    c.y0 = y;
+    c.x1 = nx;
+    c.y1 = ny;
+    born += len * 1.4f;
+    c.born = static_cast<uint16_t>(born);
+    c.depth = depth;
+    if (depth < 2 && frnd() < 0.35f) {
+      addCrackRay(nx, ny, angle + (frnd() < 0.5f ? 0.8f : -0.8f),
+                  2 + rnd() % 3, depth + 1, born);
+    }
+    x = nx;
+    y = ny;
+  }
+}
+
+void impact(float x, float y) {
+  if (s.crackCount == 0) {
+    s.impactX = x;
+    s.impactY = y;
+    s.impactAt = s.now;
+  }
+  float base = static_cast<float>(s.now - s.impactAt);
+  int rays = 7 + rnd() % 3;
+  for (int i = 0; i < rays; i++) {
+    float a = i * 6.28318f / rays + frnd() * 0.5f;
+    addCrackRay(x, y, a, 4 + rnd() % 5, 0, base);
+  }
+  // the ring around the point of impact
+  for (int i = 0; i < 8 && s.crackCount < k_maxCracks; i++) {
+    float a0 = i * 0.785f + frnd() * 0.3f, a1 = a0 + 0.6f;
+    float r = 9 + frnd() * 8;
+    Crack& c = s.cracks[s.crackCount++];
+    c.x0 = x + cosf(a0) * r;
+    c.y0 = y + sinf(a0) * r;
+    c.x1 = x + cosf(a1) * r;
+    c.y1 = y + sinf(a1) * r;
+    c.born = static_cast<uint16_t>(base + 20);
+    c.depth = 2;
+  }
+  shake(350);
+}
+
+void renderFissure(Band& b) {
+  uint32_t t = s.now - s.modeStart;
+  // The normal notebook, as if nothing happened
+  drawPageContent(b, s.page, false);
+  Kev::renderGag(b);
+  if (s.crackCount == 0) {
+    if (t < 3500) {
+      stickyNote(b,
+                 "Farce pr\xC3\xAAte : donne la calculatrice \xC3\xA0 ton "
+                 "voisin. Retour x3 pour r\xC3\xA9parer.",
+                 t > 3200 ? static_cast<int>((3500 - t) * 256 / 300) : 256);
+    }
+    return;
+  }
+  uint32_t since = s.now - s.impactAt;
+  // Liquid crystal leaking from the impact
+  float leak = clampf(since / 9000.f, 0, 1);
+  if (since > 600) {
+    blob(b, s.impactX, s.impactY, 8 + 70 * leak, 0.45f, rgb(0x050505),
+         s.leakSeed, 235);
+    blob(b, s.impactX + 18, s.impactY + 10, 4 + 40 * leak, 0.5f, rgb(0x101018),
+         s.leakSeed + 1, 200);
+    blob(b, s.impactX - 10, s.impactY + 24, 2 + 26 * leak, 0.5f,
+         rgb(0x2A0A3A), s.leakSeed + 2, 150);
+  }
+  // Dead columns of pixels
+  if (since > 900) {
+    for (int i = 0; i < 6; i++) {
+      uint32_t h = hash(s.leakSeed * 13 + i);
+      int x = h % 320;
+      uint32_t colors[3] = {0x00FFFF, 0xFF00FF, 0x00FF40};
+      bool flicker = (hash(s.now / 90 + i) & 3) != 0;
+      if (flicker || i < 3) {
+        fill(b, {x, 0, 1 + static_cast<int>((h >> 9) & 1), 240},
+             rgb(colors[i % 3]), 200);
+      }
+    }
+  }
+  // Glitchy rows when someone presses keys
+  if (s.now < s.shakeUntil + 300) {
+    for (int i = 0; i < 5; i++) {
+      int y = static_cast<int>(hash(s.now / 50 + i * 7) % 240);
+      fill(b, {0, y, 320, 2 + i % 3}, rgb(i & 1 ? 0xFFFFFF : 0x000000), 180);
+    }
+  }
+  // The cracks
+  for (int i = 0; i < s.crackCount; i++) {
+    const Crack& c = s.cracks[i];
+    if (c.born > since) {
+      continue;
+    }
+    float th = c.depth == 0 ? 1.4f : 1.f;
+    line(b, c.x0 + 1, c.y0, c.x1 + 1, c.y1, 0.8f, rgb(0xFFFFFF), 170);
+    line(b, c.x0, c.y0, c.x1, c.y1, th, rgb(0x1A1A1A), 230);
+  }
+  // shattered centre
+  disc(b, static_cast<int>(s.impactX), static_cast<int>(s.impactY), 5,
+       rgb(0xFFFFFF));
+  penCircle(b, s.impactX, s.impactY, 6, 6, 1, rgb(0x202020), 3);
+}
