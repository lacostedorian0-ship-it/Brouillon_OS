+/* ============================================================ navigation */
+
+void select(int slot) {
+  if (slot != s.selected) {
+    s.selected = slot;
+    s.selectStart = s.now;
+  }
+  Kev::goToSlot(slot, true);
+}
+
+void turnTo(int page, int slot) {
+  if (page == s.page || page < 0 || page >= s.numberOfPages) {
+    return;
+  }
+  s.turnFrom = s.page;
+  s.turnTo = page;
+  s.turnStart = s.now;
+  s.turning = true;
+  s.page = page;
+  int n = slotsOnPage(page);
+  s.selected = n == 0 ? 0 : (slot < n ? slot : n - 1);
+  s.selectStart = s.now + k_turnDuration;
+  Kev::pageTurned(page > s.turnFrom ? 1 : -1);
+}
+
+void move(int dx, int dy) {
+  int n = slotsOnPage(s.page);
+  int col = s.selected % 3, row = s.selected / 3;
+  if (dy != 0) {
+    int target = (row + dy) * 3 + col;
+    if (row + dy < 0 || row + dy > 1) {
+      return;
+    }
+    if (target >= n) {
+      target = n - 1;
+    }
+    if (target != s.selected && target >= 0) {
+      select(target);
+    }
+    return;
+  }
+  int c = col + dx;
+  if (c < 0) {
+    if (s.page > 0) {
+      turnTo(s.page - 1, row * 3 + 2);
+    } else {
+      Kev::say("C'est la premi\xC3\xA8re page. Derri\xC3\xA8re, c'est la couverture.", 2000);
+    }
+    return;
+  }
+  int target = row * 3 + c;
+  if (c > 2 || target >= n) {
+    if (s.page < s.numberOfPages - 1) {
+      turnTo(s.page + 1, row * 3);
+    } else {
+      Kev::say("Derni\xC3\xA8re page. Apr\xC3\xA8s, il n'y a que le bureau.", 2000);
+    }
+    return;
+  }
+  select(target);
+}
