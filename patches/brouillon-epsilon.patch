+  line(b, 104, 134, 256, 134, 1, gray, 120);
+  line(b, 124, 158, 256, 158, 1, gray, 120);
+  if (t > 1100) {
+    int c = static_cast<int>((t - 1100) / 70);
+    hand(b, "Kevin (le bonhomme)", 110, 119, rgb(k_graphite), Small, 8,
+         Align::Left, c);
