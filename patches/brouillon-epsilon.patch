+    fill(b, {static_cast<int>(hx - 6), static_cast<int>(hy - 9), 12, 10}, rgb(0x6A4020));
+    // pistol (a pencil)
+    float shoulderX = x + 1 * dir * scale, shoulderY = y - 16.5f * scale - 8;
