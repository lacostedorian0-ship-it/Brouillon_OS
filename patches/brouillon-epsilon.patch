+}  // namespace
+
+void drawAppDoodle(Band& b, int name, float cx, float cy, float size,
+                   uint32_t seed, float anim, bool selected) {
+  if (cy + size < b.clip().y || cy - size > b.clip().bottom()) {
+    return;
+  }
+  Pen p{b, cx, cy, size / 56.f, seed, rgb(k_ink), size > 50 ? 1.6f : 1.4f};
+  if (name == MSG(CalculApp)) {
+    calculator(p, anim, selected);
+  } else if (name == MSG(FunctionApp)) {
+    grapher(p, anim, selected);
+  } else if (name == MSG(SolverApp)) {
+    solver(p, anim, selected);
+  } else if (name == MSG(StatsApp)) {
+    stats(p, anim, selected);
+  } else if (name == MSG(DistributionsApp)) {
+    distributions(p, anim, selected);
+  } else if (name == MSG(SequenceApp)) {
+    sequence(p, anim, selected);
+  } else if (name == MSG(RegressionApp)) {
+    regression(p, anim, selected);
+  } else if (name == MSG(InferenceApp)) {
+    inference(p, anim, selected);
+  } else if (name == MSG(FinanceApp)) {
+    finance(p, anim, selected);
+  } else if (name == MSG(CodeApp)) {
+    code(p, anim, selected);
+  } else if (name == MSG(ElementsApp)) {
+    elements(p, anim, selected);
+  } else if (name == MSG(SettingsApp)) {
+    settings(p, anim, selected);
+  } else {
+    unknown(p, anim, selected);
+  }
+}
+
+const char* appNickname(int name) {
+  if (name == MSG(CalculApp)) {
+    return "Calculs. Le classique. Comme moi.";
+  }
+  if (name == MSG(FunctionApp)) {
