+void duelShot(int player) {
+  if (s.duelPhase == 1 || s.duelPhase == 2) {
+    // too early: the other one wins
+    s.duelWinner = 1 - player;
+    s.duelFoul = true;
+    s.duelPhase = 4;
+    s.duelScore[1 - player]++;
+    s.duelAt = s.now;
+    shake(200);
+  } else if (s.duelPhase == 3) {
+    s.duelWinner = player;
+    s.duelReaction = s.now - s.duelAt;
+    s.duelPhase = 4;
+    s.duelScore[player]++;
+    s.duelAt = s.now;
+    shake(300);
+    burst(player == 0 ? 96 : 224, 170, 10, 0xF0A020, 2);
+  }
+}
