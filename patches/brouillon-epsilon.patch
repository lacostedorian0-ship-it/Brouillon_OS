+Str& Str::add(const char* t) {
+  while (t && *t && len < size - 1) {
+    buf[len++] = *t++;
+  }
+  buf[len] = 0;
+  return *this;
+}
+
+Str& Str::addInt(long v) {
+  char tmp[16];
+  int n = 0;
+  bool neg = v < 0;
+  unsigned long u = neg ? -v : v;
+  do {
+    tmp[n++] = '0' + u % 10;
+    u /= 10;
+  } while (u && n < 15);
+  if (neg) {
+    add("-");
+  }
+  while (n > 0 && len < size - 1) {
+    buf[len++] = tmp[--n];
+  }
+  buf[len] = 0;
+  return *this;
+}
