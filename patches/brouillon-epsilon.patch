+  int8_t board[9] = {1, 2, 0, 0, 1, 0, 0, 0, 0};
+  memcpy(s.board, board, 9);
+  s.ttCursor = 8;
+  s.ttPhase = 0;
+  shoot("morpion");
+  int8_t board2[9] = {1, 2, 0, 0, 1, 0, 2, 0, 0};
+  memcpy(s.board, board2, 9);
+  s.ttCursor = 8;
+  press(Events::OK, 200, nullptr, 1);
+  step(400, nullptr, 1);
+  shoot("morpion_table");
+  press(Events::Back, 300, nullptr, 1);
+  // Settings
+  s.tool = 8;
+  press(Events::OK, 300, nullptr, 1);
+  shoot("reglages");
+  press(Events::Back, 200, nullptr, 1);
+  press(Events::Back, 200, nullptr, 1);
+}
+#endif
+
+}  // namespace Trousse
+}  // namespace Doodle
+}  // namespace Home
