+/* ============================================================== render */
+
+namespace {
+
+void graffitiDraw(Band& b, const Graffiti& g) {
+  KDColor c = rgb(0x6A6A74);
+  float x = g.x, y = g.y;
+  uint32_t sd = g.seed;
+  switch (g.kind) {
+    case 0:
+      heart(b, g.x - 9, g.y - 8, 2, rgb(k_red), 160);
+      break;
+    case 1:
+      for (int i = 0; i < 5; i++) {
+        float a = i * 1.2566f;
+        penCircle(b, x + cosf(a) * 4, y - 10 + sinf(a) * 4, 3, 3, 1, c,
+                  sd + i);
+      }
+      pen(b, x, y - 6, x, y + 6, 1, c, sd + 9);
+      break;
+    case 2: {
+      float xs[10], ys[10];
+      for (int i = 0; i < 10; i++) {
+        float a = -1.5708f + i * 0.6283f;
+        float r = (i & 1) ? 3.5f : 8.f;
+        xs[i] = x + cosf(a) * r;
+        ys[i] = y - 4 + sinf(a) * r;
+      }
+      penPath(b, xs, ys, 10, true, 1, c, sd);
+      break;
+    }
+    case 3: {
+      // The S that every pupil in the world draws in their notebook
+      const float k[12][4] = {{0, 0, 0, 6},  {4, 0, 4, 6},  {8, 0, 8, 6},
+                              {0, 10, 0, 16}, {4, 10, 4, 16}, {8, 10, 8, 16},
+                              {0, 6, 8, 10}, {4, 6, 8, 8.5f}, {0, 6, 4, 8},
+                              {0, 10, 4, 7.5f}, {0, 0, 4, -3}, {8, 16, 4, 19}};
+      for (int i = 0; i < 12; i++) {
+        pen(b, x - 4 + k[i][0], y - 18 + k[i][1], x - 4 + k[i][2],
+            y - 18 + k[i][3], 1, c, sd + i, 0.3f);
+      }
+      pen(b, x - 4, y - 18, x, y - 21, 1, c, sd + 20, 0.3f);
+      pen(b, x + 4, y - 18, x, y - 21, 1, c, sd + 21, 0.3f);
+      pen(b, x - 4, y - 2, x, y + 1, 1, c, sd + 22, 0.3f);
+      break;
+    }
+    case 4:
+      penCircle(b, x, y - 8, 7, 7, 1, c, sd);
+      ellipse(b, x - 2.5f, y - 10, 0.9f, 0.9f, c);
+      ellipse(b, x + 2.5f, y - 10, 0.9f, 0.9f, c);
+      arc(b, x, y - 8, 3.5f, 1, 2, c);
+      break;
+    case 5: {
+      float xs[4] = {x - 7, x + 3, x + 3, x - 7}, ys[4] = {y - 12, y - 12, y - 2, y - 2};
+      penPath(b, xs, ys, 4, true, 1, c, sd);
+      for (int i = 0; i < 4; i++) {
+        xs[i] += 4;
+        ys[i] -= 4;
+      }
+      penPath(b, xs, ys, 4, true, 1, c, sd + 1);
+      for (int i = 0; i < 4; i++) {
+        pen(b, xs[i] - 4, ys[i] + 4, xs[i], ys[i], 1, c, sd + 2 + i, 0.3f);
+      }
+      break;
+    }
+    case 6:
+      heart(b, g.x - 14, g.y - 13, 3, rgb(k_red), 90);
+      hand(b, "K+?", g.x, g.y - 12, c, KDFont::Size::Small, sd, Align::Center);
+      break;
+    case 7:
+      penCircle(b, x, y - 8, 4, 4, 1, c, sd);
+      for (int i = 0; i < 8; i++) {
+        float a = i * 0.785f;
+        pen(b, x + cosf(a) * 6, y - 8 + sinf(a) * 6, x + cosf(a) * 9,
+            y - 8 + sinf(a) * 9, 1, c, sd + i, 0.3f);
+      }
+      break;
+    default:
+      hand(b, "Kevin \xC3\xA9tait l\xC3\xA0", g.x, g.y - 12, c,
+           KDFont::Size::Small, sd, Align::Center);
+      break;
+  }
+}
+
+void drawSign(Band& b, float x, float y, const char* t) {
+  int w = textWidth(t) + 10;
+  if (w < 26) {
+    w = 26;
+  }
+  Rect r = {static_cast<int>(x - w / 2), static_cast<int>(y - 18), w, 16};
+  fill(b, r, rgb(0xFFFFFF));
+  pen(b, r.x, r.y, r.right(), r.y, 1.2f, rgb(k_graphite), 501);
+  pen(b, r.right(), r.y, r.right(), r.bottom(), 1.2f, rgb(k_graphite), 502);
+  pen(b, r.right(), r.bottom(), r.x, r.bottom(), 1.2f, rgb(k_graphite), 503);
+  pen(b, r.x, r.bottom(), r.x, r.y, 1.2f, rgb(k_graphite), 504);
+  hand(b, t, static_cast<int>(x), r.y + 1, rgb(k_red), KDFont::Size::Small,
+       505, Align::Center);
+}
