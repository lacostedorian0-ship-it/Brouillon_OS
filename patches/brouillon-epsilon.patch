+
+void diveAndLaunch(int index) {
+  if (s_apps[index].item.kind == Item::Kind::External && examMode()) {
+    toast("Mode examen : les autocollants sont confisqu\xC3\xA9s.", 2500);
+    return;
+  }
+  Kev::dive();
+  s.floodApp = index;
+  uint32_t start = s.now;
+  Band band;
+  while (!s_fake) {
+    s.now = clockMs();
+    g_boil = s.now / 120;
+    uint32_t t = s.now - start;
+    if (t > k_diveDuration && !s.flooding) {
+      s.flooding = true;
+      s.floodStart = s.now;
+    }
+    if (t > k_diveDuration + k_floodDuration + 60) {
+      break;
+    }
+    updateLed();
+    renderFull(band);
+  }
+  s.flooding = false;
+  launchApp(index);
+}
+
+void panic() {
+  s.panics++;
+  if (s_calculationIndex < 0) {
+    return;
+  }
+  s.crumpling = true;
+  s.crumpleStart = s.now;
+  Band band;
+  while (!s_fake) {
+    s.now = clockMs();
+    if (s.now - s.crumpleStart > k_crumpleDuration) {
+      break;
+    }
+    renderFull(band);
+  }
+  s.crumpling = false;
+  s.lastLaunched = -2;  // panic
+  s.detachTime = s.now;
+  s_launch = s_apps[s_calculationIndex].item;
+}
+
+}  // namespace
