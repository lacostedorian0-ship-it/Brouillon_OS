+    big = "...";
+  } else if (s.duelPhase == 2) {
+    big = k_fakes[s.duelFake];
+    bigColor = rgb(0xA07840);
+  } else if (s.duelPhase == 3) {
+    big = "PAN !";
+    bigColor = rgb(k_red);
+  } else {
+    Str r(line, sizeof(line));
+    if (s.duelFoul) {
+      r.add("Faux d\xC3\xA9part de J").addInt(2 - s.duelWinner).add(" !");
+    } else {
+      r.add("J").addInt(s.duelWinner + 1).add(" en ").addInt(s.duelReaction).add(" ms");
+    }
+    hand(b, line, 160, 62, rgb(k_red), Large, 43, Align::Center);
+    if (s.duelScore[0] >= 3 || s.duelScore[1] >= 3) {
+      hand(b, "Champion du Far-Ouest de la classe !", 160, 90, ink, Small, 44,
+           Align::Center);
+      hand(b, "OK : revanche", 160, 108, ink, Small, 45, Align::Center);
+    } else {
+      hand(b, "OK : manche suivante", 160, 90, ink, Small, 46, Align::Center);
+    }
+  }
+  if (big) {
+    int scale = s.duelPhase == 3 ? 3 : 2;
+    bigHand(b, big, 160, 60, scale, bigColor, 47, Align::Center);
+  }
+}
+
+void duelUpdate() {
+  if (s.duelPhase == 1 && s.duelFakeAt && s.now >= s.duelFakeAt) {
+    s.duelPhase = 2;
+  }
+  if (s.duelPhase == 2 && s.now >= s.duelFakeAt + 900) {
+    s.duelPhase = 1;
+    s.duelFakeAt = 0;
+  }
+  if (s.duelPhase == 1 && s.now >= s.duelAt) {
+    s.duelPhase = 3;
+    s.duelAt = s.now;
+  }
+}
+
+bool duelEvent(Event e) {
+  if (e == Events::Zero) {
+    duelShot(0);
+    return true;
+  }
+  if (e == Events::EXE) {
+    duelShot(1);
+    return true;
+  }
+  if (e == Events::OK && (s.duelPhase == 0 || s.duelPhase == 4) &&
+      s.now - s.duelAt > 400) {
+    if (s.duelScore[0] >= 3 || s.duelScore[1] >= 3) {
+      s.duelScore[0] = s.duelScore[1] = 0;
+    }
+    duelNext();
+  }
+  return true;
+}
