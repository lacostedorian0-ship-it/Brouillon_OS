+/* Calls `line(start, length)` for every line of `s` wrapped to `columns`
+ * glyphs; '\n' forces a new line. */
+template <typename F>
+int forEachLine(const char* s, int columns, F line) {
+  int count = 0;
+  const char* p = s;
+  while (*p) {
+    const char* start = p;
+    const char* lastSpace = nullptr;
+    int glyphs = 0;
+    const char* q = p;
+    while (*q && *q != '\n') {
+      if (*q == ' ') {
+        lastSpace = q;
+      }
+      if ((static_cast<uint8_t>(*q) & 0xC0) != 0x80) {
+        glyphs++;
+      }
+      if (glyphs > columns) {
+        break;
+      }
+      q++;
+    }
+    const char* end;
+    if (*q == 0 || *q == '\n') {
+      end = q;
+      p = *q ? q + 1 : q;
+    } else if (lastSpace && lastSpace > start) {
+      end = lastSpace;
+      p = lastSpace + 1;
+    } else {
+      // back to the start of the last whole UTF-8 character
+      end = q;
+      while (end > start && (static_cast<uint8_t>(*end) & 0xC0) == 0x80) {
+        end--;
+      }
+      p = end;
+    }
+    count++;
+    if (!line(start, static_cast<int>(end - start))) {
+      break;
+    }
+  }
+  return count;
+}
+
+}  // namespace
+
+int wrapped(Band& b, const char* str, int x, int y, int width, KDColor c,
+            KDFont::Size font, int lineHeight, Align align, int maxLines,
+            uint32_t seed) {
+  int columns = width / glyphWidth(font);
+  int n = 0;
+  forEachLine(str, columns, [&](const char* start, int len) {
+    if (n >= maxLines) {
+      return false;
+    }
+    char line[96];
+    if (len > 95) {
+      len = 95;
+    }
+    memcpy(line, start, len);
+    line[len] = 0;
+    int yy = y + n * lineHeight;
+    n++;
+    if (yy < b.clip().bottom() + 2 && yy + lineHeight > b.clip().y - 2) {
+      int lx = x;
+      if (align == Align::Center) {
+        lx = x + width / 2;
+      } else if (align == Align::Right) {
+        lx = x + width;
+      }
+      hand(b, line, lx, yy, c, font, seed + n * 13, align);
+    }
+    return true;
+  });
+  return n;
+}
+
+namespace {
+int wrappedCount(const char* str, int width, KDFont::Size font) {
+  int columns = width / glyphWidth(font);
+  int n = 0;
+  forEachLine(str, columns, [&](const char*, int) {
+    n++;
+    return true;
+  });
+  return n;
+}
+
+int longestLine(const char* str, int columns) {
+  int best = 0;
+  forEachLine(str, columns, [&](const char* start, int len) {
+    int g = 0;
+    for (int i = 0; i < len; i++) {
+      if ((static_cast<uint8_t>(start[i]) & 0xC0) != 0x80) {
+        g++;
+      }
+    }
+    if (g > best) {
+      best = g;
+    }
+    return true;
+  });
+  return best;
+}
+}  // namespace
+
+void bubble(Band& b, const char* str, int cx, int bottom, int tx, int ty,
+            uint32_t seed) {
+  int gw = glyphWidth(Small);
+  int columns = 22;
+  int lines = wrappedCount(str, columns * gw, Small);
+  if (lines > 4) {
+    lines = 4;
+  }
+  int w = longestLine(str, columns) * gw + 14;
+  int h = lines * 14 + 8;
+  /* Above the speaker when there is room, otherwise beside him (never on
+   * top of him) */
+  bool below = bottom > ty + 4;
+  bool side = !below && bottom - h < 2;
+  int left, top;
+  float bx0, by0, bx1, by1;  // base of the tail, on the bubble's edge
+  if (below) {
+    top = bottom;
+    left = clampi(cx - w / 2, 2, k_screenWidth - w - 2);
+    float bx = clampi(tx, left + 10, left + w - 10);
+    bx0 = bx - 5;
+    bx1 = bx + 5;
+    by0 = by1 = top + 1.5f;
+  } else if (side) {
+    bool right = tx < k_screenWidth / 2;
+    left = right ? tx + 14 : tx - 14 - w;
+    left = clampi(left, 2, k_screenWidth - w - 2);
+    top = clampi(ty - 4, 2, k_screenHeight - h - 2);
+    float ey = clampi(ty + 4, top + 7, top + h - 7);
+    float ex = right ? left + 1.5f : left + w - 1.5f;
+    bx0 = bx1 = ex;
+    by0 = ey - 5;
+    by1 = ey + 5;
+  } else {
+    top = bottom - h;
+    left = clampi(cx - w / 2, 2, k_screenWidth - w - 2);
+    float bx = clampi(tx, left + 10, left + w - 10);
+    bx0 = bx - 5;
+    bx1 = bx + 5;
+    by0 = by1 = top + h - 1.5f;
+  }
+  if (top > b.clip().bottom() + 10 || top + h + 12 < b.clip().y) {
+    return;
+  }
+  Rect r = {left, top, w, h};
+  KDColor ink = rgb(k_graphite);
+  KDColor white = rgb(0xFFFFFF);
+  roundFill(b, r, 6, white);
+  float l = left, t = top, rr = left + w, bb = top + h;
+  pen(b, l + 4, t, rr - 4, t, 1.2f, ink, seed + 3, 0.5f);
+  pen(b, rr, t + 4, rr, bb - 4, 1.2f, ink, seed + 4, 0.5f);
+  pen(b, l, t + 4, l, bb - 4, 1.2f, ink, seed + 5, 0.5f);
+  pen(b, l + 4, bb, rr - 4, bb, 1.2f, ink, seed + 6, 0.5f);
+  // the tail is drawn last: its white base opens the outline
+  float tipX = side ? (tx < k_screenWidth / 2 ? tx + 4.f : tx - 4.f) : tx;
+  float tipY = side ? ty + 2.f : (below ? ty + 2.f : ty - 2.f);
+  float xs[4] = {bx0, bx1, tipX, tipX};
+  float ys[4] = {by0, by1, tipY, tipY};
+  if (side) {
+    // widen the base inside the bubble so that it covers the border
+    float in = tx < k_screenWidth / 2 ? 2.5f : -2.5f;
+    float px[4] = {bx0 + in, bx1 + in, tipX, bx0 - in * 0.2f};
+    float py[4] = {by0, by1, tipY, by0};
+    polygon(b, px, py, 4, white);
+  } else {
+    float in = below ? 2.5f : -2.5f;
+    float px[4] = {bx0, bx1, tipX, bx0};
+    float py[4] = {by0 + in, by1 + in, tipY, by0 + in};
+    polygon(b, px, py, 4, white);
+  }
+  pen(b, xs[0], ys[0], xs[2], ys[2], 1.2f, ink, seed + 1, 0.4f);
+  pen(b, xs[1], ys[1], xs[3], ys[3], 1.2f, ink, seed + 2, 0.4f);
+  wrapped(b, str, left + 7, top + 4, columns * gw, ink, Small, 14, Align::Left,
+          4, seed);
+}
+
+void stickyNote(Band& b, const char* str, int alpha) {
+  if (alpha <= 0) {
+    return;
+  }
+  int lines = wrappedCount(str, 260, Small);
+  if (lines > 3) {
+    lines = 3;
+  }
+  int h = lines * 14 + 12;
+  int y = k_screenHeight - h - 6;
+  if (y > b.clip().bottom() || y + h + 4 < b.clip().y) {
+    return;
+  }
+  float xs[4] = {26, 296, 294, 28};
+  float ys[4] = {static_cast<float>(y + 2), static_cast<float>(y),
+                 static_cast<float>(y + h), static_cast<float>(y + h + 2)};
+  float sx[4], sy[4];
+  for (int i = 0; i < 4; i++) {
+    sx[i] = xs[i] + 3;
+    sy[i] = ys[i] + 3;
+  }
+  polygon(b, sx, sy, 4, rgb(0x000000), alpha * 50 / 256);
+  polygon(b, xs, ys, 4, rgb(0xFFE96B), alpha);
+  fill(b, {28, y + 1, 266, 5}, rgb(0xF2D640), alpha);
+  wrapped(b, str, 36, y + 7, 252, rgb(0x3A2A10), Small, 14, Align::Center, 3,
+          s.toastStart);
+}
+
+void toast(const char* t, int ms) {
+  strlcpy(s.toast, t, sizeof(s.toast));
+  s.toastStart = s.now;
+  s.toastUntil = s.now + ms;
+}
+
+void shake(int ms) { s.shakeUntil = s.now + ms; }
+
+/* ============================================================ particles */
+
+void burst(float x, float y, int n, uint32_t color, int kind) {
+  for (Particle& p : s.particles) {
+    if (n <= 0) {
+      break;
+    }
+    if (p.life != 0) {
+      continue;
+    }
+    float a = frnd() * 6.28318f;
+    float v = 20 + frnd() * 50;
+    p.x = x;
+    p.y = y;
+    p.vx = cosf(a) * v;
+    p.vy = sinf(a) * v - (kind == 3 ? 10 : 30);
+    if (kind == 3) {
+      p.vx = 8 + frnd() * 6;
+      p.vy = -14;
+    }
+    p.maxLife = p.life = kind == 3 ? 2200 : 500 + rnd() % 400;
+    p.rgb565 = static_cast<uint16_t>(rgb(color));
+    p.size = 1 + rnd() % 2;
+    p.kind = kind;
+    n--;
+  }
+}
+
+namespace {
+
+void updateParticles(float dt) {
+  int ms = static_cast<int>(dt * 1000);
+  for (Particle& p : s.particles) {
+    if (p.life == 0) {
+      continue;
+    }
+    p.x += p.vx * dt;
+    p.y += p.vy * dt;
+    if (p.kind == 0 || p.kind == 2) {
+      p.vy += 160 * dt;
+    }
+    if (p.kind == 1 && p.y > 228) {
+      p.y = 228;
+      p.vy = 0;
+    }
+    p.life = p.life > ms ? p.life - ms : 0;
+  }
+}
+
+void drawParticles(Band& b) {
+  for (const Particle& p : s.particles) {
+    if (p.life == 0) {
+      continue;
+    }
+    int alpha = p.life * 256 / p.maxLife;
+    if (p.kind == 0) {
+      alpha = alpha * 2 > 256 ? 256 : alpha * 2;
+    }
+    KDColor c = KDColor::RGB16(p.rgb565);
+    switch (p.kind) {
+      case 1:  // coin
+        ellipse(b, p.x, p.y, 3.5f, 3.5f, c, 256);
+        ellipse(b, p.x - 1, p.y - 1, 1.2f, 1.2f, rgb(0xFFF4B0), 256);
+        break;
+      case 2: {  // star of a hit
+        line(b, p.x - 3, p.y, p.x + 3, p.y, 1, c, alpha);
+        line(b, p.x, p.y - 3, p.x, p.y + 3, 1, c, alpha);
+        break;
+      }
+      case 3:  // Z of a sleeper
+        hand(b, "z", static_cast<int>(p.x), static_cast<int>(p.y), c, Small,
+             1, Align::Left, -1, alpha);
+        break;
+      default:
+        ellipse(b, p.x, p.y, p.size, p.size, c, alpha);
+        break;
+    }
+  }
+}
