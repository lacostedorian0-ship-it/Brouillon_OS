+#pragma once
+
+/* BROUILLON internals.
+ *
+ * The home screen of the calculator is a scrap notebook ("cahier de
+ * brouillon"): squared Seyès paper, a red margin, everything drawn with a
+ * blue ballpoint pen whose lines "boil" like a hand-drawn cartoon. The apps
+ * are doodles, the games are stickers, and Kevin, a stick figure, lives on
+ * the page: he jumps from doodle to doodle, dives into the apps before you
+ * and comes back out of them with consequences.
+ *
+ *   shell.cpp    the notebook: pages, selection, page turns, the cover,
+ *                the ink flood that opens an app, the panic button, the red
+ *                pen correcting your calculations, the LED and backlight
+ *   kevin.cpp    Kevin: skeleton, poses, behaviour, what he brings back
+ *   doodles.cpp  the doodle of every calculator app
+ *   trousse.cpp  the pencil case (Toolbox): the paper fortune teller, the
+ *                mask, the cracked screen prank, the duel, the punishment
+ *                machine, free drawing (Kevin walks on it), the paper plane,
+ *                tic-tac-toe against a cheater, the settings */
+
+#include <ion/events.h>
+#include <ion/keyboard.h>
+#include <stdint.h>
+
+#include "food.h"
+#include "gfx.h"
+#include "shell.h"
+
+namespace Home {
+namespace Doodle {
+
+constexpr int k_maxApps = 30;
+constexpr int k_maxBuiltin = 16;
+constexpr int k_perPage = 6;
+constexpr int k_maxParticles = 48;
+constexpr int k_maxGraffiti = 14;
+constexpr int k_canvasW = 160;  // free drawing, 2 x 2 px cells
+constexpr int k_canvasH = 108;
+constexpr int k_maxCracks = 90;
+constexpr int k_maxComments = 6;
+
+// Colours of the notebook
