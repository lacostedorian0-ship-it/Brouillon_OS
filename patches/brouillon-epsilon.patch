+/* ============================================================ punition */
+
+const char* const k_sentences[] = {
+    "Je ne dessine pas sur ma calculatrice.",
+    "Je ne dois pas diviser par z\xC3\xA9ro.",
+    "Je ne dois pas appeler le prof maman.",
+    "Je ne lance pas de cocottes en papier.",
+    "Les maths servent \xC3\xA0 quelque chose.",
+    "Je ne dois pas manger ma gomme.",
+    "Je ne dois pas chatouiller Kevin.",
+    "Je ne r\xC3\xA9ponds pas 42 \xC3\xA0 tout.",
+};
+constexpr int k_numberOfSentences = sizeof(k_sentences) / sizeof(k_sentences[0]);
+
+void renderPunition(Band& b) {
+  paper(b, 5);
+  KDColor ink = rgb(k_ink);
+  if (!s.punRunning && s.punDone == 0) {
+    hand(b, "La machine \xC3\xA0 punitions", 44, 4, ink, Large, 1);
+    hand(b, "Kevin l'\xC3\xA9\x63rira 100 fois :", 44, 30,
+         rgb(k_graphite), Small, 2);
+    for (int i = 0; i < k_numberOfSentences; i++) {
+      int y = 52 + i * 21;
+      if (i == s.punSentence) {
+        float xs[4] = {40, 316, 314, 42};
+        float ys[4] = {static_cast<float>(y), static_cast<float>(y - 1),
+                       static_cast<float>(y + 16), static_cast<float>(y + 17)};
+        polygon(b, xs, ys, 4, rgb(k_fluo), 190);
+      }
+      hand(b, k_sentences[i], 44, y + 1, ink, Small, 10 + i);
+    }
+    hand(b, "OK : au travail, Kevin", 300, 224, rgb(k_red), Small, 30,
+         Align::Right);
+    return;
+  }
+  const char* sentence = k_sentences[s.punSentence];
+  int glyphs = glyphCount(sentence);
+  // lines of 16 px, the last 12 are visible
+  float progress = s.punProgress;
+  int done = static_cast<int>(progress / glyphs);
+  if (done > 100) {
+    done = 100;
+  }
+  int partial = static_cast<int>(progress) - done * glyphs;
+  int firstVisible = done > 11 ? done - 11 : 0;
+  for (int i = firstVisible; i <= done && i < 100; i++) {
+    int y = 30 + (i - firstVisible) * 16;
+    int count = i < done ? -1 : partial;
+    // Kevin's handwriting gets worse and worse
+    uint32_t seed = 50 + i * (1 + i / 20);
+    hand(b, sentence, 40, y, ink, Small, seed, Align::Left, count);
+    if (i == done && done < 100) {
+      float px = 40 + partial * glyphWidth(Small), py = y + 12;
+      pen(b, px, py, px + 12, py - 18, 3, rgb(0xE8B020), 60, 0.2f);
+      pen(b, px, py, px + 2, py - 3, 1.5f, rgb(k_graphite), 61, 0.1f);
+    }
+  }
+  char count[16];
+  Str c(count, sizeof(count));
+  c.addInt(done).add("/100");
+  bigHand(b, count, 312, 4, 1, rgb(k_red), 70, Align::Right);
+  // Kevin, at work
+  Pose q = Kev::pose(done >= 100 ? KState::Sleep : KState::Doodling,
+                     (s.now - s.punStart) / 1000.f, -1);
+  if (done >= 100) {
+    q.face = FaceDizzy;
+  } else if (done > 60) {
+    q.face = FaceAngry;
+  }
+  Kev::draw(b, 290, 232, 0.9f, -1, q, rgb(k_graphite));
+  const char* moan = nullptr;
+  if (done >= 100) {
+    moan = "Fini. Je ne sens plus mon bras.";
+  } else if (done > 80) {
+    moan = "Mon crayon fume.";
+  } else if (done > 50) {
+    moan = "Pourquoi c'est MOI qui \xC3\xA9\x63ris ?";
+  } else if (done > 20) {
+    moan = "Je ne dois pas... bla bla bla.";
+  }
+  if (moan) {
+    bubble(b, moan, 230, 196, 286, 204, 80 + done / 20);
+  }
+}
+
+void punitionUpdate(float dt) {
+  if (!s.punRunning) {
+    return;
+  }
+  int glyphs = glyphCount(k_sentences[s.punSentence]);
+  int done = static_cast<int>(s.punProgress / glyphs);
+  float speed = 30 + done * 9.f;  // glyphs per second, faster and faster
+  s.punProgress += speed * dt;
+  if (s.punProgress >= glyphs * 100.f) {
+    s.punProgress = glyphs * 100.f;
+    s.punRunning = false;
+    s.punDone = 100;
+  }
+}
+
+/* ============================================================== dessin */
+
+bool cell(int cx, int cy) {
+  if (cx < 0 || cy < 0 || cx >= k_canvasW || cy >= k_canvasH) {
+    return false;
+  }
+  int i = cy * k_canvasW + cx;
+  return (s.canvas[i >> 3] >> (i & 7)) & 1;
+}
+
+void setCell(int cx, int cy, bool on) {
+  if (cx < 0 || cy < 0 || cx >= k_canvasW || cy >= k_canvasH) {
+    return;
+  }
+  int i = cy * k_canvasW + cx;
+  if (on) {
+    s.canvas[i >> 3] |= 1 << (i & 7);
+  } else {
+    s.canvas[i >> 3] &= ~(1 << (i & 7));
+  }
+}
+
+constexpr int k_canvasTop = 24;
+
+// Is the pixel (x, y) of the screen inked?
+bool solid(float x, float y) {
+  if (y >= 238) {
+    return true;  // the bottom of the page
+  }
+  return cell(static_cast<int>(x) / 2, (static_cast<int>(y) - k_canvasTop) / 2);
+}
+
+void brush(float x, float y, bool on) {
+  int cx = static_cast<int>(x) / 2, cy = (static_cast<int>(y) - k_canvasTop) / 2;
+  int r = on ? 1 : 3;
+  for (int dy = -r; dy <= r; dy++) {
+    for (int dx = -r; dx <= r; dx++) {
+      if (on && dx * dx + dy * dy > 1) {
+        continue;
+      }
+      setCell(cx + dx, cy + dy, on);
+    }
+  }
+}
+
+void renderDessin(Band& b) {
+  paper(b, 6);
+  KDColor ink = rgb(k_ink);
+  hand(b, "Dessine. Kevin s'en sert.", 44, 4, ink, Small, 1);
+  hand(b, s.eraser ? "gomme" : (s.penDown ? "stylo pos\xC3\xA9" : "stylo lev\xC3\xA9"),
+       312, 4, rgb(s.eraser ? 0xD06080 : k_red), Small, 2, Align::Right);
+  // the drawing
+  const Rect& z = b.clip();
+  for (int y = z.y; y < z.bottom(); y++) {
+    if (y < k_canvasTop) {
+      continue;
+    }
+    int cy = (y - k_canvasTop) / 2;
+    if (cy >= k_canvasH) {
+      break;
+    }
+    KDColor* row = b.row(y);
+    const uint8_t* bits = s.canvas + (cy * k_canvasW) / 8;
+    for (int cx = 0; cx < k_canvasW; cx++) {
+      if (bits[cx >> 3] & (1 << (cx & 7))) {
+        row[2 * cx] = ink;
+        row[2 * cx + 1] = ink;
+      }
+    }
+  }
+  // Kevin
+  Kevin& k = s.k;
+  Pose q;
+  float t = (s.now - s.modeStart) / 1000.f;
+  if (!k.grounded) {
+    q = Kev::pose(KState::Jump, 0.4f, k.dir);
+    q.face = FaceScared;
+  } else {
+    q = Kev::pose(KState::Idle, t, k.dir);
+    float run = sinf(t * 10);
+    q.legU[0] = 0.6f * run;
+    q.legU[1] = -0.6f * run;
+    q.armU[0] = -0.5f * run;
+    q.armU[1] = 0.5f * run;
+  }
+  Kev::draw(b, k.x, k.y, 0.8f, k.dir, q, rgb(k_graphite));
+  if (s.now < k.sayUntil) {
+    bubble(b, k.say, clampi(static_cast<int>(k.x), 90, 230),
+           static_cast<int>(k.y - 34), static_cast<int>(k.x),
+           static_cast<int>(k.y - 28), 40);
+  }
+  // the pen
+  float px = s.curX, py = s.curY;
+  if (s.eraser) {
+    roundFill(b, {static_cast<int>(px - 6), static_cast<int>(py - 8), 12, 16}, 3,
+              rgb(0xF4A0B4));
+    roundFrame(b, {static_cast<int>(px - 6), static_cast<int>(py - 8), 12, 16}, 3,
+               rgb(0x5A2A3A));
+  } else {
+    float lift = s.penDown ? 0 : 5;
+    pen(b, px + 2, py - 3 - lift, px + 14, py - 20 - lift, 4, rgb(0x2050C0), 50, 0.1f);
+    pen(b, px, py - lift, px + 3, py - 4 - lift, 1.6f, rgb(0x101828), 51, 0.1f);
+    if (!s.penDown) {
+      ellipse(b, px, py, 1.5f, 1.5f, rgb(0x2050C0), 120);
+    }
+  }
+  if (t < 4) {
+    stickyNote(b,
+               "Fl\xC3\xA8\x63hes : bouger   OK : poser/lever le stylo   "
+               "Var : gomme   0 : tout effacer",
+               t > 3.6f ? static_cast<int>((4 - t) * 640) : 256);
+  }
+}
+
+void dessinUpdate(float dt) {
+  Ion::Keyboard::State st = scanKeys();
+  float dx = 0, dy = 0;
+  if (st.keyDown(Key::Left)) dx -= 1;
+  if (st.keyDown(Key::Right)) dx += 1;
+  if (st.keyDown(Key::Up)) dy -= 1;
+  if (st.keyDown(Key::Down)) dy += 1;
+  if (dx != 0 || dy != 0) {
+    float speed = 85;
+    float nx = clampf(s.curX + dx * speed * dt, 2, 318);
+    float ny = clampf(s.curY + dy * speed * dt, k_canvasTop + 1, 238);
+    if (s.penDown || s.eraser) {
+      // stroke from the old position to the new one
+      float d = sqrtf((nx - s.curX) * (nx - s.curX) + (ny - s.curY) * (ny - s.curY));
+      int steps = static_cast<int>(d) + 1;
+      for (int i = 0; i <= steps; i++) {
+        float u = static_cast<float>(i) / steps;
+        brush(s.curX + (nx - s.curX) * u, s.curY + (ny - s.curY) * u, !s.eraser);
+      }
+    }
+    s.curX = nx;
+    s.curY = ny;
+  }
+  // Kevin's physics: gravity, walking, turning around at walls
+  Kevin& k = s.k;
+  bool ground = solid(k.x, k.y + 1) || solid(k.x - 3, k.y + 1) ||
+                solid(k.x + 3, k.y + 1);
+  if (ground) {
+    if (!k.grounded) {
+      k.grounded = true;
+      burst(k.x, k.y, 3, 0x8A8A90, 0);
+    }
+    k.vy = 0;
+    float nx = k.x + k.dir * 28 * dt;
+    // step up small bumps, turn around at walls
+    int climb = 0;
+    while (climb < 6 && solid(nx + 3 * k.dir, k.y - climb)) {
+      climb++;
+    }
+    bool wall = false;
+    for (int h = 6; h < 22; h += 3) {
+      if (solid(nx + 3 * k.dir, k.y - climb - h)) {
+        wall = true;
+      }
+    }
+    if (nx < 6 || nx > 314) {
+      wall = true;
+    }
+    if (wall) {
+      k.dir = -k.dir;
+      if ((rnd() % 4) == 0 && s.now > k.sayUntil + 2000) {
+        const char* const lines[] = {"Un mur. Bien jou\xC3\xA9.",
+                                     "Laisse-moi sortir !",
+                                     "C'est un labyrinthe ou quoi ?",
+                                     "Demi-tour !"};
+        Kev::say(lines[rnd() % 4], 1800);
+      }
+    } else {
+      k.x = nx;
+      k.y -= climb;
+    }
+    // sink out of the ink if a line was drawn through him
+    int out = 0;
+    while (out < 10 && solid(k.x, k.y)) {
+      k.y -= 1;
+      out++;
+    }
+  } else {
+    if (k.grounded && s.now > k.sayUntil + 1500 && (rnd() % 3) == 0) {
+      Kev::say("Aaaaaah !", 900);
+    }
+    k.grounded = false;
+    k.vy += 420 * dt;
+    if (k.vy > 300) {
+      k.vy = 300;
+    }
+    float ny = k.y + k.vy * dt;
+    // land on the first inked pixel on the way down
+    for (float y = k.y; y <= ny; y += 1) {
+      if (solid(k.x, y + 1)) {
+        ny = y;
+        k.vy = 0;
+        break;
+      }
+    }
+    k.y = ny;
+  }
+  // drawn over by the pen
+  if (s.penDown && !s.eraser && fabsf(s.curX - k.x) < 6 &&
+      s.curY < k.y && s.curY > k.y - 28 && s.now > k.sayUntil) {
+    Kev::say("H\xC3\xA9 ! Pas sur moi !", 1200);
+  }
+}
+
+/* =============================================================== avion */
+
+void planeReset() {
+  s.planeY = 110;
+  s.planeV = 0;
+  s.planeX = 70;
+  s.planeScore = 0;
+  s.planeDead = false;
+  s.planeStarted = false;
+  for (int i = 0; i < 6; i++) {
+    s.obstacles[i][0] = 340 + i * 120;
+    s.obstacles[i][1] = 70 + frnd() * 110;
+    s.obstacles[i][2] = static_cast<float>(rnd() % 3);
+  }
+}
+
+constexpr float k_gap = 78;
+
+void drawPencil(Band& b, float x, float yEnd, bool fromTop, int kind) {
+  // a pencil (or a ruler) sticking out of the top or the bottom of the page
+  float w = kind == 2 ? 20 : 16;
+  float tip = kind == 2 ? 0 : 14;
+  float y0 = fromTop ? -4 : yEnd + tip;
+  float y1 = fromTop ? yEnd - tip : 244;
+  uint32_t body = kind == 0 ? 0xF2B830 : (kind == 1 ? 0x3A7AE8 : 0xD8E4F0);
+  Rect r = {static_cast<int>(x - w / 2), static_cast<int>(y0), static_cast<int>(w),
+            static_cast<int>(y1 - y0)};
+  fill(b, r, rgb(body));
+  fill(b, {r.x, r.y, 4, r.h}, rgb(0xFFFFFF), 60);
+  if (kind == 2) {
+    for (int y = r.y + 4; y < r.bottom(); y += 6) {
+      fill(b, {r.x, y, (y / 6) % 5 == 0 ? 9 : 5, 1}, rgb(0x404860));
+    }
+    frame(b, r, rgb(0x404860));
+    return;
+  }
+  frame(b, r, rgb(0x6A4A10));
+  float tx[3] = {x - w / 2, x + w / 2, x};
+  float ty[3] = {fromTop ? yEnd - tip : yEnd + tip, fromTop ? yEnd - tip : yEnd + tip,
+                 yEnd};
+  polygon(b, tx, ty, 3, rgb(0xE8C9A0));
+  float lx[3] = {x - 3, x + 3, x};
+  float ly[3] = {fromTop ? yEnd - 4 : yEnd + 4, fromTop ? yEnd - 4 : yEnd + 4, yEnd};
+  polygon(b, lx, ly, 3, rgb(kind == 1 ? 0x2050C0 : 0x303030));
+  // eraser at the far end
+  float ey = fromTop ? -4 : 236;
+  fill(b, {r.x, static_cast<int>(ey), r.w, 8}, rgb(0xF4A0B4));
+}
+
+void renderAvion(Band& b) {
+  paper(b, 8, false);
+  KDColor ink = rgb(k_ink);
+  for (int i = 0; i < 6; i++) {
+    float x = s.obstacles[i][0], gap = s.obstacles[i][1];
+    int kind = static_cast<int>(s.obstacles[i][2]);
+    if (x < -30 || x > 350) {
+      continue;
+    }
+    drawPencil(b, x, gap - k_gap / 2, true, kind);
+    drawPencil(b, x, gap + k_gap / 2, false, (kind + 1) % 3);
+  }
+  // the plane
+  float x = s.planeX, y = s.planeY;
+  if (s.planeDead) {
+    float k = clampf((s.now - s.planeDeadAt) / 300.f, 0, 1);
+    blob(b, x, y, 12 - 4 * k, 0.15f + 0.3f * k, rgb(0xFFFFFF), 5);
+    penCircle(b, x, y, 10 - 3 * k, 9 - 3 * k, 1.2f, ink, 6);
+    pen(b, x - 6, y - 3, x + 5, y + 4, 1, rgb(0xB8B2A0), 7, 2);
+  } else {
+    float a = clampf(s.planeV / 260.f, -0.6f, 0.6f);
+    float ca = cosf(a), sa = sinf(a);
+    float px[4] = {16, -12, -8, -12}, py[4] = {0, -8, 0, 7};
+    float xs[4], ys[4];
+    for (int i = 0; i < 4; i++) {
+      xs[i] = x + px[i] * ca - py[i] * sa;
+      ys[i] = y + px[i] * sa + py[i] * ca;
+    }
+    float t1x[3] = {xs[0], xs[1], xs[2]}, t1y[3] = {ys[0], ys[1], ys[2]};
+    float t2x[3] = {xs[0], xs[2], xs[3]}, t2y[3] = {ys[0], ys[2], ys[3]};
+    polygon(b, t1x, t1y, 3, rgb(0xFFFFFF));
+    polygon(b, t2x, t2y, 3, rgb(0xE6E2D8));
+    penPath(b, xs, ys, 4, true, 1.3f, ink, 10, 0.3f);
+    pen(b, xs[0], ys[0], xs[2], ys[2], 1, ink, 11, 0.3f);
+  }
+  char score[24];
+  Str m(score, sizeof(score));
+  m.addInt(s.planeScore).add(" m");
+  bigHand(b, score, 312, 4, 1, rgb(k_red), 20, Align::Right);
+  if (!s.planeStarted) {
+    hand(b, "Garde une touche appuy\xC3\xA9\x65 pour monter.", 160, 200, ink,
+         Small, 21, Align::Center);
+  }
+  if (s.planeDead && s.now - s.planeDeadAt > 500) {
+    Rect r = {60, 74, 200, 74};
+    fill(b, r, rgb(0xFFFDF6));
+    roundFrame(b, r, 3, ink);
+    hand(b, "Atterrissage sur le prof.", 160, 82, rgb(k_red), Small, 22,
+         Align::Center);
+    char line[48];
+    Str l(line, sizeof(line));
+    l.add("Score : ").addInt(s.planeScore).add("   Record : ").addInt(s.planeBest);
+    hand(b, line, 160, 104, ink, Small, 23, Align::Center);
+    hand(b, "OK : relancer", 160, 124, ink, Small, 24, Align::Center);
+  }
+}
+
+void avionUpdate(float dt) {
+  if (s.planeDead) {
+    s.planeY += 120 * dt;
+    if (s.planeY > 232) {
+      s.planeY = 232;
+    }
+    return;
+  }
+  bool up = anyKeyHeld() || held(Key::Up);
+  if (up) {
+    s.planeStarted = true;
+  }
+  if (!s.planeStarted) {
+    s.planeY = 110 + 6 * sinf(s.now / 300.f);
+    return;
+  }
+  s.planeV += (up ? -520.f : 360.f) * dt;
+  s.planeV = clampf(s.planeV, -220, 240);
+  s.planeY += s.planeV * dt;
+  float speed = 70 + s.planeScore * 0.6f;
+  for (int i = 0; i < 6; i++) {
+    float before = s.obstacles[i][0];
+    s.obstacles[i][0] -= speed * dt;
+    if (before >= s.planeX && s.obstacles[i][0] < s.planeX) {
+      s.planeScore += 10;
+    }
+    if (s.obstacles[i][0] < -40) {
+      float far = 0;
+      for (int j = 0; j < 6; j++) {
+        far = s.obstacles[j][0] > far ? s.obstacles[j][0] : far;
+      }
+      s.obstacles[i][0] = far + 110 + frnd() * 40;
+      s.obstacles[i][1] = 64 + frnd() * 120;
+      s.obstacles[i][2] = static_cast<float>(rnd() % 3);
+    }
+    // collision
+    float x = s.obstacles[i][0], gap = s.obstacles[i][1];
+    if (fabsf(x - s.planeX) < 18 &&
+        (s.planeY - 6 < gap - k_gap / 2 || s.planeY + 6 > gap + k_gap / 2)) {
+      s.planeDead = true;
+    }
+  }
+  if (s.planeY < 4 || s.planeY > 236) {
+    s.planeDead = true;
+  }
+  if (s.planeDead) {
+    s.planeDeadAt = s.now;
+    shake(250);
+    if (s.planeScore > s.planeBest) {
+      s.planeBest = s.planeScore;
+    }
+  }
+}
