+
+bool isDigit(char c) { return c >= '0' && c <= '9'; }
+
+// Parses a result as a number; false if it is not a plain number
+bool parseNumber(const char* str, double* out, bool* integer, bool* huge) {
+  const char* p = str;
+  bool neg = false;
+  *huge = false;
+  if (*p == '-') {
+    neg = true;
+    p++;
+  }
+  if (!isDigit(*p)) {
+    return false;
+  }
+  double v = 0;
+  int digits = 0;
+  while (isDigit(*p)) {
+    v = v * 10 + (*p - '0');
+    p++;
+    digits++;
+  }
+  *integer = true;
+  if (*p == '.') {
+    p++;
+    double scale = 0.1;
+    bool nonzero = false;
+    while (isDigit(*p)) {
+      v += (*p - '0') * scale;
+      if (*p != '0') {
+        nonzero = true;
+      }
+      scale *= 0.1;
+      p++;
+    }
+    *integer = !nonzero;
+  }
+  // The small capital E of Epsilon's scientific notation (U+1D07)
+  if (static_cast<uint8_t>(p[0]) == 0xE1 &&
+      static_cast<uint8_t>(p[1]) == 0xB4 && static_cast<uint8_t>(p[2]) == 0x87) {
+    p += 3;
+    bool eneg = false;
+    if (*p == '-') {
+      eneg = true;
+      p++;
+    }
+    int e = 0;
+    while (isDigit(*p)) {
+      e = e * 10 + (*p - '0');
+      p++;
+    }
+    if (eneg) {
+      for (int i = 0; i < e; i++) {
+        v /= 10;
+      }
+      *integer = false;
+    } else {
+      *huge = e >= 9;
+      for (int i = 0; i < e && i < 300; i++) {
+        v *= 10;
+      }
+    }
+  }
+  if (*p != 0) {
+    return false;
+  }
+  if (digits > 9) {
+    *huge = true;
+  }
+  *out = neg ? -v : v;
+  return true;
+}
+
+bool isPrime(long n) {
+  if (n < 2) {
+    return false;
+  }
+  for (long d = 2; d * d <= n; d++) {
+    if (n % d == 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// (the calculator's libc has no strstr nor strncmp)
+bool startsWith(const char* a, const char* b) {
+  while (*b) {
+    if (*a++ != *b++) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool contains(const char* hay, const char* needle) {
+  for (; *hay; hay++) {
+    if (startsWith(hay, needle)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The teacher's comment on one calculation; returns 1 good, -1 bad, 0 meh
+int judge(const Food::Entry& e, char* note, int size, uint32_t seed) {
+  const char* o = e.output;
+  const char* in = e.input;
+  auto set = [&](const char* t) { strlcpy(note, t, size); };
+  if (contains(o, "undef") || contains(o, "nd\xC3\xA9")) {
+    set("Division par 0 : une heure de colle.");
+    return -1;
+  }
+  if (contains(o, "inf") || contains(o, "\xE2\x88\x9E")) {
+    set("L'infini n'est pas une r\xC3\xA9ponse.");
+    return -1;
+  }
+  if (strcmp(in, "1+1") == 0) {
+    set("S\xC3\xA9rieux ? La calculatrice pour \xC3\xA7\x61 ?");
+    return -1;
+  }
+  double v;
+  bool integer, huge;
+  if (!parseNumber(o, &v, &integer, &huge)) {
+    set("Illisible. R\xC3\xA9\x65\x63ris proprement.");
+    return 0;
+  }
+  if (startsWith(o, "3.14159")) {
+    set("\xCF\x80 n'est pas un dessert. Quoique.");
+    return 1;
+  }
+  if (startsWith(o, "2.71828")) {
+    set("e. Joli. Tu frimes ?");
+    return 1;
+  }
+  if (huge) {
+    set("Ton nombre d\xC3\xA9\x62orde de la marge.");
+    return 0;
+  }
+  if (integer) {
+    long n = static_cast<long>(v);
+    if (n == 42) {
+      set("Bonne r\xC3\xA9ponse. Mais quelle question ?");
+      return 1;
+    }
+    if (n == 666) {
+      set("Voir moi apr\xC3\xA8s le cours.");
+      return -1;
+    }
+    if (n == 69) {
+      set("Hmm. Vu.");
+      return 0;
+    }
+    if (n == 1337) {
+      set("Leet. Hors programme.");
+      return 0;
+    }
+    if (n == 404) {
+      set("Note introuvable.");
+      return 0;
+    }
+    if (n == 0) {
+      set("Z\xC3\xA9ro. Comme ta motivation ?");
+      return -1;
+    }
+    if (n == 2026 || n == 2027) {
+      set("L'ann\xC3\xA9\x65 du bac ? Courage.");
+      return 0;
+    }
+    if (n < 0) {
+      set("Pourquoi tant de n\xC3\xA9gativit\xC3\xA9 ?");
+      return -1;
+    }
+    if (n > 1 && n < 1000000 && isPrime(n)) {
+      set("Premier. Seul, comme toi le samedi.");
+      return 1;
+    }
+    long r = static_cast<long>(sqrt(static_cast<double>(n)) + 0.5);
+    if (n > 3 && r * r == n) {
+      set("Carr\xC3\xA9 parfait. Comme ta coupe ?");
+      return 1;
+    }
+    const char* const k_plain[] = {
+        "Bien.",
+        "Justifie.",
+        "Calcul juste, raisonnement absent.",
+        "Tu as copi\xC3\xA9 sur ta calculatrice ?",
+        "Tr\xC3\xA8s bien, mais je ne te crois pas.",
+        "Peu soign\xC3\xA9.",
+        "Bien, mais \xC3\xA9\x63ris plus gros.",
+    };
+    set(k_plain[seed % 7]);
+    return (seed % 7) == 0 || (seed % 7) == 4 ? 1 : 0;
+  }
+  if (v < 0) {
+    set("N\xC3\xA9gatif ET \xC3\xA0 virgule. Courageux.");
+    return -1;
+  }
+  if (v != 0 && v < 0.001) {
+    set("Trop petit. Prends une loupe.");
+    return 0;
+  }
+  const char* const k_decimal[] = {
+      "Arrondis !",
+      "O\xC3\xB9 est l'unit\xC3\xA9 ?",
+      "Les virgules, \xC3\xA7\x61 se m\xC3\xA9rite.",
+      "Trop de d\xC3\xA9\x63imales. Frimeur.",
+  };
+  set(k_decimal[seed % 4]);
+  return 0;
+}
