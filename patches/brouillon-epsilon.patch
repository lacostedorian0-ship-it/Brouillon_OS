+void toolIcon(Band& b, int tool, float cx, float cy, float t, bool sel) {
+  KDColor ink = rgb(k_ink);
+  uint32_t sd = 3000 + tool * 40;
+  switch (tool) {
+    case 0: {  // cocotte
+      uint32_t cols[4] = {0xE84A4A, 0x3A7AE8, 0x3AB85A, 0xF2C230};
+      for (int i = 0; i < 4; i++) {
+        int qx = i & 1, qy = i >> 1;
+        fill(b, {static_cast<int>(cx - 12 + qx * 12), static_cast<int>(cy - 12 + qy * 12),
+                 11, 11},
+             rgb(cols[i]));
+      }
+      pen(b, cx - 12, cy - 12, cx + 11, cy + 11, 1, ink, sd);
+      pen(b, cx + 11, cy - 12, cx - 12, cy + 11, 1, ink, sd + 1);
+      break;
+    }
+    case 1: {  // mask
+      penCircle(b, cx - 6, cy - 3, 4, 3, 1.2f, ink, sd);
+      penCircle(b, cx + 6, cy - 3, 4, 3, 1.2f, ink, sd + 1);
+      float open = sel ? 2 + 2 * sinf(t * 10) : 2;
+      ellipse(b, cx, cy + 7, 7, open, rgb(0x902030));
+      break;
+    }
+    case 2: {  // cracked glass
+      roundFrame(b, {static_cast<int>(cx - 14), static_cast<int>(cy - 11), 28, 22}, 2,
+                 ink);
+      pen(b, cx - 3, cy - 2, cx - 12, cy - 9, 1, ink, sd);
+      pen(b, cx - 3, cy - 2, cx + 10, cy - 8, 1, ink, sd + 1);
+      pen(b, cx - 3, cy - 2, cx + 4, cy + 9, 1, ink, sd + 2);
+      pen(b, cx - 3, cy - 2, cx - 10, cy + 6, 1, ink, sd + 3);
+      break;
+    }
+    case 3: {  // duel: two crossed pencils
+      pen(b, cx - 12, cy + 10, cx + 12, cy - 10, 3, rgb(0xE8B020), sd);
+      pen(b, cx + 12, cy + 10, cx - 12, cy - 10, 3, rgb(0xE8B020), sd + 1);
+      hand(b, "PAN", static_cast<int>(cx), static_cast<int>(cy - 22), rgb(k_red),
+           Small, sd, Align::Center);
+      break;
+    }
+    case 4:  // lines
+      for (int i = 0; i < 4; i++) {
+        pen(b, cx - 13, cy - 9 + i * 6, cx + 13, cy - 9 + i * 6, 1, ink,
+            sd + i);
+      }
+      break;
+    case 5:  // pencil
+      pen(b, cx - 12, cy + 12, cx + 10, cy - 10, 5, rgb(0xE8B020), sd, 0.2f);
+      pen(b, cx - 12, cy + 12, cx - 15, cy + 15, 2, rgb(k_graphite), sd + 1,
+          0.2f);
+      break;
+    case 6: {  // paper plane
+      float bob = sel ? 3 * sinf(t * 6) : 0;
+      float xs[3] = {cx - 14, cx + 14, cx - 6}, ys[3] = {cy + bob, cy - 6 + bob,
+                                                         cy + 8 + bob};
+      polygon(b, xs, ys, 3, rgb(0xFFFFFF));
+      penPath(b, xs, ys, 3, true, 1.2f, ink, sd);
+      pen(b, cx - 6, cy + 8 + bob, cx - 3, cy + 1 + bob, 1, ink, sd + 3);
+      break;
+    }
+    case 7:  // grid
+      pen(b, cx - 4, cy - 13, cx - 4, cy + 13, 1.2f, ink, sd);
+      pen(b, cx + 4, cy - 13, cx + 4, cy + 13, 1.2f, ink, sd + 1);
+      pen(b, cx - 13, cy - 4, cx + 13, cy - 4, 1.2f, ink, sd + 2);
+      pen(b, cx - 13, cy + 4, cx + 13, cy + 4, 1.2f, ink, sd + 3);
+      penCircle(b, cx, cy, 2.5f, 2.5f, 1, rgb(k_graphite), sd + 4);
+      pen(b, cx - 11, cy - 11, cx - 6, cy - 6, 1, ink, sd + 5);
+      pen(b, cx - 6, cy - 11, cx - 11, cy - 6, 1, ink, sd + 6);
+      break;
+    default: {  // sharpener
+      roundFill(b, {static_cast<int>(cx - 10), static_cast<int>(cy - 8), 20, 16}, 3,
+                rgb(0x8090A8));
+      disc(b, static_cast<int>(cx - 2), static_cast<int>(cy), 4, rgb(0x303040));
+      pen(b, cx + 3, cy - 8, cx + 8, cy - 14, 1.2f, ink, sd);
+      break;
+    }
+  }
+}
