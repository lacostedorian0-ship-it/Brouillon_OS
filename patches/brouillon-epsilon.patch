+Key anyHeld(Ion::Keyboard::State st, bool* found) {
+  // Every key but Back and Home (they leave), the arrows have other uses
+  static constexpr Key k_ignored[] = {Key::Back, Key::Home, Key::OnOff,
+                                      Key::Left, Key::Right, Key::Up,
+                                      Key::Down};
+  for (int k = 0; k < Ion::Keyboard::NumberOfKeys; k++) {
+    Key key = static_cast<Key>(k);
+    bool ignored = false;
+    for (Key i : k_ignored) {
+      if (i == key) {
+        ignored = true;
+      }
+    }
+    if (!ignored && st.keyDown(key)) {
+      *found = true;
+      return key;
+    }
+  }
+  *found = false;
+  return Key::None;
+}
+
+bool held(Key k) { return scanKeys().keyDown(k); }
+
+bool anyKeyHeld() {
+  bool found;
+  anyHeld(scanKeys(), &found);
+  return found;
+}
