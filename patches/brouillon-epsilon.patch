+/* ============================================================= morpion */
+
+constexpr int k_lines[8][3] = {{0, 1, 2}, {3, 4, 5}, {6, 7, 8}, {0, 3, 6},
+                               {1, 4, 7}, {2, 5, 8}, {0, 4, 8}, {2, 4, 6}};
+
+int winner() {
+  for (const auto& l : k_lines) {
+    if (s.board[l[0]] && s.board[l[0]] == s.board[l[1]] &&
+        s.board[l[1]] == s.board[l[2]]) {
+      return s.board[l[0]];
+    }
+  }
+  for (int i = 0; i < 9; i++) {
+    if (!s.board[i]) {
+      return 0;
+    }
+  }
+  return 3;  // draw
+}
+
+// A cell that completes a line of `who` (-1 if none)
+int completing(int who) {
+  for (const auto& l : k_lines) {
+    int mine = 0, empty = -1;
+    for (int i = 0; i < 3; i++) {
+      if (s.board[l[i]] == who) {
+        mine++;
+      } else if (s.board[l[i]] == 0) {
+        empty = l[i];
+      }
+    }
+    if (mine == 2 && empty >= 0) {
+      return empty;
+    }
+  }
+  return -1;
+}
+
+void ttReset() {
+  for (int i = 0; i < 9; i++) {
+    s.board[i] = 0;
+  }
+  s.ttPhase = 0;
+  s.ttCursor = 4;
+  s.ttWinner = 0;
+  s.ttCheat = -1;
+}
+
+void ttEnd() {
+  int w = winner();
+  if (!w) {
+    return;
+  }
+  s.ttWinner = w;
+  s.ttAt = s.now;
+  if (w == 1) {
+    s.ttPhase = 3;
+    s.ttWins++;
+    s.ttFlips++;
+    shake(500);
+    Kev::say("C'EST TRUQU\xC3\x89 ! *retourne la table*", 3000);
+  } else {
+    s.ttPhase = 2;
+    if (w == 2) {
+      s.ttLosses++;
+      Kev::say("Trop fort. Comme d'hab.", 3000);
+    } else {
+      Kev::say("Match nul. Comme ta moyenne.", 3000);
+    }
+  }
+}
+
+void kevinPlays() {
+  int cell = completing(2);
+  if (cell < 0) {
+    int threat = completing(1);
+    if (threat >= 0) {
+      // About to lose? Half of the time, the eraser "slips"
+      if ((rnd() & 1) && s.ttCheat < 0) {
+        for (const auto& l : k_lines) {
+          int mine = 0;
+          for (int i = 0; i < 3; i++) {
+            mine += s.board[l[i]] == 1;
+          }
+          bool hasThreat = false;
+          for (int i = 0; i < 3; i++) {
+            hasThreat |= l[i] == threat;
+          }
+          if (mine == 2 && hasThreat) {
+            for (int i = 0; i < 3; i++) {
+              if (s.board[l[i]] == 1) {
+                s.ttCheat = l[i];
+                s.board[l[i]] = 0;
+                Kev::say("Oups. Ma gomme a gliss\xC3\xA9.", 2600);
+                s.ttAt = s.now;
+                break;
+              }
+            }
+            break;
+          }
+        }
+      }
+      cell = threat;
+    }
+  }
+  if (cell < 0 && s.board[4] == 0) {
+    cell = 4;
+  }
+  if (cell < 0) {
+    int corners[4] = {0, 2, 6, 8};
+    for (int i = 0; i < 4 && cell < 0; i++) {
+      int c = corners[(i + rnd()) % 4];
+      if (!s.board[c]) {
+        cell = c;
+      }
+    }
+  }
+  for (int i = 0; i < 9 && cell < 0; i++) {
+    if (!s.board[i]) {
+      cell = i;
+    }
+  }
+  if (cell >= 0) {
+    s.board[cell] = 2;
+  }
+  s.ttPhase = 0;
+  ttEnd();
+}
+
+void renderMorpion(Band& b) {
+  paper(b, 3);
+  KDColor ink = rgb(k_ink);
+  hand(b, "Morpion contre Kevin", 44, 4, ink, Large, 1);
+  char line[48];
+  Str m(line, sizeof(line));
+  m.add("Toi ").addInt(s.ttWins).add(" - ").addInt(s.ttLosses).add(" Kevin");
+  hand(b, line, 312, 28, rgb(0x6A6A74), Small, 2, Align::Right);
+  float x0 = 60, y0 = 44, size = 174, c = size / 3;
+  float ox = 0, oy = 0, fade = 1;
+  if (s.ttPhase == 3) {
+    float k = clampf((s.now - s.ttAt) / 700.f, 0, 1.5f);
+    ox = 40 * k;
+    oy = -260 * k * k;
+    fade = 1 - clampf(k, 0, 1);
+  }
+  int alpha = static_cast<int>(256 * fade);
+  if (alpha > 0) {
+    for (int i = 1; i < 3; i++) {
+      pen(b, x0 + i * c + ox, y0 + 4 + oy, x0 + i * c + ox, y0 + size - 4 + oy, 2,
+          ink, 10 + i, 0.8f, alpha);
+      pen(b, x0 + 4 + ox, y0 + i * c + oy, x0 + size - 4 + ox, y0 + i * c + oy, 2,
+          ink, 20 + i, 0.8f, alpha);
+    }
+    for (int i = 0; i < 9; i++) {
+      float cx = x0 + (i % 3 + 0.5f) * c + ox, cy = y0 + (i / 3 + 0.5f) * c + oy;
+      if (i == s.ttCursor && s.ttPhase == 0) {
+        float xs[4] = {cx - 24, cx + 24, cx + 22, cx - 26};
+        float ys[4] = {cy - 24, cy - 26, cy + 24, cy + 22};
+        polygon(b, xs, ys, 4, rgb(k_fluo), 150);
+      }
+      if (s.board[i] == 1) {
+        pen(b, cx - 16, cy - 16, cx + 16, cy + 16, 3, ink, 30 + i, 0.8f, alpha);
+        pen(b, cx + 16, cy - 16, cx - 16, cy + 16, 3, ink, 40 + i, 0.8f, alpha);
+      } else if (s.board[i] == 2) {
+        penCircle(b, cx, cy, 17, 17, 2.5f, rgb(k_graphite), 50 + i, 1.f, 0.8f,
+                  alpha);
+      }
+      if (i == s.ttCheat && s.now - s.ttAt < 1500) {
+        // eraser crumbs where your X was
+        for (int j = 0; j < 6; j++) {
+          ellipse(b, cx - 12 + (hash(j * 3 + i) % 24), cy - 8 + (hash(j * 5) % 16), 1.5f,
+                  1.2f, rgb(0xF4A0B4));
+        }
+      }
+    }
+  }
+  // Kevin
+  KState st = s.ttPhase == 1 ? KState::Read
+              : (s.ttPhase == 2 && s.ttWinner == 2) ? KState::Dance
+              : s.ttPhase == 3 ? KState::Poked
+                               : KState::Idle;
+  Pose q = Kev::pose(st, (s.now - s.ttAt) / 1000.f, -1);
+  if (s.ttPhase == 3) {
+    q.face = FaceAngry;
+    q.armU[0] = q.armU[1] = 2.8f;
+  }
+  if (s.ttPhase == 1) {
+    q.face = FaceNormal;
+    q.headTilt = 0.3f;
+  }
+  Kev::draw(b, 280, 228, 1.1f, -1, q, rgb(k_graphite));
+  if (s.now < s.k.sayUntil) {
+    bubble(b, s.k.say, 240, 182, 276, 190, 60);
+  }
+  if (s.ttPhase == 2 || (s.ttPhase == 3 && s.now - s.ttAt > 800)) {
+    hand(b, "OK : rejouer", 150, 224, rgb(k_red), Small, 61, Align::Center);
+  }
+}
+
+bool morpionEvent(Event e) {
+  if (s.ttPhase == 2 || s.ttPhase == 3) {
+    if ((e == Events::OK || e == Events::EXE) && s.now - s.ttAt > 600) {
+      ttReset();
+    }
+    return true;
+  }
+  if (s.ttPhase != 0) {
+    return true;
+  }
+  int c = s.ttCursor;
+  if (e == Events::Left) {
+    c = (c / 3) * 3 + (c % 3 + 2) % 3;
+  } else if (e == Events::Right) {
+    c = (c / 3) * 3 + (c % 3 + 1) % 3;
+  } else if (e == Events::Up) {
+    c = (c + 6) % 9;
+  } else if (e == Events::Down) {
+    c = (c + 3) % 9;
+  }
+  s.ttCursor = c;
+  int play = -1;
+  if (e == Events::OK || e == Events::EXE) {
+    play = c;
+  }
+  const char* t = e.text();
+  if (t && t[0] >= '1' && t[0] <= '9' && t[1] == 0) {
+    // numpad layout: 7 8 9 on top
+    int d = t[0] - '1';
+    play = (2 - d / 3) * 3 + d % 3;
+    s.ttCursor = play;
+  }
+  if (play >= 0 && s.board[play] == 0) {
+    s.board[play] = 1;
+    s.ttCheat = -1;
+    if (winner()) {
+      ttEnd();
+    } else {
+      s.ttPhase = 1;
+      s.ttAt = s.now;
+    }
+  }
+  return true;
+}
+
+void morpionUpdate() {
+  if (s.ttPhase == 1 && s.now - s.ttAt > 700) {
+    kevinPlays();
+  }
+}
