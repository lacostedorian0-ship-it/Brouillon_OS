+  bool robot = style == 6;
+  const Rect& z = b.clip();
+  KDColor skin = robot ? rgb(0xB8C4CC) : (style == 3 ? rgb(0xE8E4F0) : rgb(0xF6D2B0));
+  if (style == 9) {
+    skin = rgb(k_paper);
+  }
+  fill(b, z, skin);
+  if (style == 9) {
+    paper(b, 1, false);
+  }
+  KDColor ink = rgb(robot ? 0x202830 : 0x2A1A14);
+  float t = sec();
+  bool blink = s.now > s.blinkAt && s.now < s.blinkAt + 140;
+  // eyes
+  int eyes = style == 5 ? 1 : 2;
+  for (int i = 0; i < eyes; i++) {
+    float ex = eyes == 1 ? 160 : (i == 0 ? 92 : 228), ey = 82;
+    float rx = eyes == 1 ? 58 : 44, ry = eyes == 1 ? 46 : 38;
+    if (style == 9) {
+      rx = 8;
+      ry = 8;
+      ellipse(b, ex + s.eyeX * 4, ey + s.eyeY * 4, rx, ry, ink);
+      continue;
+    }
+    if (robot) {
+      Rect er = {static_cast<int>(ex - rx), static_cast<int>(ey - ry * 0.7f),
+                 static_cast<int>(2 * rx), static_cast<int>(1.4f * ry)};
+      fill(b, er, rgb(0x102030));
+      fill(b, {static_cast<int>(ex - 14 + s.eyeX * 20), static_cast<int>(ey - 10 + s.eyeY * 10),
+               28, 20},
+           rgb(0x40F0FF));
+      frame(b, er, ink);
+      continue;
+    }
+    ellipse(b, ex, ey, rx, ry, rgb(0xFFFFFF));
+    penCircle(b, ex, ey, rx, ry, 2.5f, ink, 10 + i, 1.f, 0.4f);
+    float px = ex + s.eyeX * rx * 0.45f, py = ey + s.eyeY * ry * 0.45f;
+    ellipse(b, px, py, rx * 0.36f, ry * 0.4f, rgb(style == 3 ? 0xC01020 : 0x4A3020));
+    ellipse(b, px, py, rx * 0.18f, ry * 0.2f, rgb(0x000000));
+    ellipse(b, px - rx * 0.1f, py - ry * 0.12f, rx * 0.07f, ry * 0.08f,
+            rgb(0xFFFFFF));
+    if (blink) {
+      ellipse(b, ex, ey, rx + 2, ry + 2, skin);
+      pen(b, ex - rx, ey, ex + rx, ey, 2.5f, ink, 14 + i);
+    }
+    // eyebrows
+    if (style != 7) {
+      float lift = 6 * s.mouth;
+      pen(b, ex - rx * 0.8f, ey - ry - 10 - lift + (i ? 4 : 0),
+          ex + rx * 0.8f, ey - ry - 10 - lift + (i ? 0 : 4), 5, ink, 20 + i,
+          0.4f);
+    }
+    if (style == 2) {
+      penCircle(b, ex, ey, rx + 8, ry + 8, 4, rgb(0x202020), 30 + i, 1.f, 0.3f);
+    }
+  }
+  if (style == 7) {
+    pen(b, 50, 34, 270, 34, 9, ink, 25, 0.8f);
+  }
+  if (style == 2) {
+    pen(b, 128, 82, 192, 82, 4, rgb(0x202020), 32, 0.3f);
+  }
+  // nose
+  if (style == 4) {
+    disc(b, 160, 132, 16, rgb(0xE02020));
+    ellipse(b, 154, 126, 4, 4, rgb(0xFF9090));
+  } else if (style != 9 && !robot) {
+    pen(b, 162, 104, 148, 138, 2.5f, ink, 40, 0.5f);
+    pen(b, 148, 138, 156, 146, 2.5f, ink, 41, 0.5f);
+    pen(b, 156, 146, 170, 142, 2.5f, ink, 42, 0.5f);
+  }
+  // mouth
+  float open = s.mouth;
+  float mw = 64, mh = 5 + 34 * open;
+  float my = 196;
+  if (style == 9) {
+    pen(b, 130, my, 190, my, 2, ink, 50);
+    if (open > 0.05f) {
+      ellipse(b, 160, my, 30, mh * 0.5f, ink);
+    }
+  } else if (robot) {
+    Rect m = {static_cast<int>(160 - mw), static_cast<int>(my - mh / 2),
+              static_cast<int>(2 * mw), static_cast<int>(mh)};
+    fill(b, m, rgb(0x102030));
+    for (int x = m.x + 6; x < m.right(); x += 12) {
+      int h = static_cast<int>(mh * 0.4f * (0.5f + 0.5f * sinf(t * 20 + x)));
+      fill(b, {x, static_cast<int>(my - h / 2), 6, h + 1}, rgb(0x40F0FF));
+    }
+  } else {
+    ellipse(b, 160, my, mw, mh, rgb(0x6A1020));
+    if (open > 0.15f) {
+      ellipse(b, 160, my + mh * 0.5f, mw * 0.5f, mh * 0.4f, rgb(0xE05A70));
+      // teeth
+      for (int i = -3; i <= 3; i++) {
+        if (style == 8 && (i == -1 || i == 2)) {
+          continue;
+        }
+        fill(b, {static_cast<int>(160 + i * 13 - 5), static_cast<int>(my - mh + 2), 10,
+                 static_cast<int>(6 + 4 * open)},
+             rgb(0xFFFFF4));
+      }
+      if (style == 3) {
+        float fy = my - mh + 2;
+        float xs1[3] = {136, 146, 141}, ys1[3] = {fy, fy, fy + 18};
+        float xs2[3] = {174, 184, 179}, ys2[3] = {fy, fy, fy + 18};
+        polygon(b, xs1, ys1, 3, rgb(0xFFFFFF));
+        polygon(b, xs2, ys2, 3, rgb(0xFFFFFF));
+      }
+    }
+    penCircle(b, 160, my, mw, mh, 3, ink, 55, 1.f, 0.3f);
+  }
+  if (style == 1) {
+    // a grand handlebar moustache that dances when you talk
+    float lift = -10 * open;
+    float wave = 4 * sinf(t * 9) * open;
+    float ly[8] = {156 + lift, 150 + lift, 148 + lift, 154 + lift,
+                   140 + lift + wave, 150 + lift, 162 + lift, 164 + lift};
+    float lx[8] = {160, 150, 128, 108, 92, 96, 124, 150};
+    polygon(b, lx, ly, 8, rgb(0x3A2410));
+    float rx[8];
+    for (int i = 0; i < 8; i++) {
+      rx[i] = 320 - lx[i];
+    }
+    float ry[8];
+    for (int i = 0; i < 8; i++) {
+      ry[i] = ly[i] - (i == 4 ? 2 * wave : 0);
+    }
+    polygon(b, rx, ry, 8, rgb(0x3A2410));
+  }
+  if (!robot && style != 9) {
+    ellipse(b, 64, 150, 22, 12, rgb(0xFF6A7A), 70);
+    ellipse(b, 256, 150, 22, 12, rgb(0xFF6A7A), 70);
+  }
+  if (style == 4) {
+    // clown hair
+    for (int i = 0; i < 6; i++) {
+      disc(b, 10 + (i % 2) * 18, 30 + i * 16, 16, rgb(0xFF5020));
+      disc(b, 310 - (i % 2) * 18, 30 + i * 16, 16, rgb(0xFF5020));
+    }
+  }
+  if (sec() < 2.5f) {
+    char line[64];
+    Str m(line, sizeof(line));
+    m.add("Visage : ").add(k_maskNames[style]).add(" (chiffres pour changer)");
+    hand(b, line, 160, 222, ink, Small, 60, Align::Center);
+  }
+}
+
+void maskUpdate(float dt) {
+  float target = anyKeyHeld() ? 1.f : 0.f;
+  // a jaw is not a switch: it opens fast and closes a bit slower
+  float speed = target > s.mouth ? 14.f : 9.f;
+  s.mouth += (target - s.mouth) * clampf(speed * dt, 0, 1);
+  float tx = 0, ty = 0;
+  Ion::Keyboard::State st = scanKeys();
+  if (st.keyDown(Key::Left)) tx = -1;
+  if (st.keyDown(Key::Right)) tx = 1;
+  if (st.keyDown(Key::Up)) ty = -1;
+  if (st.keyDown(Key::Down)) ty = 1;
+  if (tx == 0 && ty == 0) {
+    // wander a little on their own
+    tx = 0.3f * sinf(s.now / 1300.f);
+    ty = 0.2f * sinf(s.now / 1700.f);
+  }
+  s.eyeX += (tx - s.eyeX) * clampf(10 * dt, 0, 1);
+  s.eyeY += (ty - s.eyeY) * clampf(10 * dt, 0, 1);
+  if (s.now > s.blinkAt + 140) {
+    s.blinkAt = s.now + 1500 + rnd() % 3500;
+  }
+}
