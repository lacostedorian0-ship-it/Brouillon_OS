+/* ========================================================== crumpling */
+
+void renderCrumple(Band& b, float k) {
+  // k = 0: flat page, 1: a small ball of paper on the desk
+  const Rect& z = b.clip();
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      uint32_t h = hash((x / 3) * 7 + y * 977) & 15;
+      row[x] = KDColor::RGB888(150 + h, 112 + h, 72 + h / 2);
+    }
+  }
+  float r = 230 * (1 - k) + 22 * k;
+  float rough = 0.05f + 0.3f * k;
+  blob(b, 160, 120, r, rough, rgb(0xE9E4D6), 600);
+  blob(b, 160 - r * 0.15f, 120 - r * 0.1f, r * 0.75f, rough, rgb(k_paper),
+       601);
+  for (int i = 0; i < 14; i++) {
+    float a = i * 0.45f + 0.3f;
+    float l = r * (0.4f + 0.5f * ((hash(i) & 255) / 255.f));
+    pen(b, 160, 120, 160 + cosf(a) * l, 120 + sinf(a) * l, 1, rgb(0xB8B2A0),
+        610 + i, 2.f * k);
+  }
+  for (int i = 0; i < 4; i++) {
+    float yy = 120 - r * 0.6f + i * r * 0.35f;
+    pen(b, 160 - r * 0.6f, yy, 160 + r * 0.6f, yy + r * 0.1f, 1,
+        rgb(0x93AEDD), 620 + i, 3.f * k);
+  }
+}
