+void collectComments() {
+  uint32_t produced = Food::produced();
+  uint32_t first = produced > k_maxComments ? produced - k_maxComments : 0;
+  if (first < s.foodSeen && produced - s.foodSeen < k_maxComments) {
+    // Show the new ones, and older ones to fill the page
+  }
+  s.commentCount = 0;
+  int score = 10;
+  bool fortyTwo = false;
+  for (uint32_t i = first; i < produced; i++) {
+    const Food::Entry* e = Food::at(i);
+    if (!e) {
+      continue;
+    }
+    Comment& c = s.comments[s.commentCount++];
+    strlcpy(c.input, e->input, sizeof(c.input));
+    strlcpy(c.output, e->output, sizeof(c.output));
+    int verdict = judge(*e, c.note, sizeof(c.note), hash(i * 31 + s.random));
+    c.good = verdict > 0;
+    score += verdict > 0 ? 2 : (verdict < 0 ? -3 : 0);
+    if (strcmp(e->output, "42") == 0) {
+      fortyTwo = true;
+    }
+  }
+  score += static_cast<int>(hash(produced * 77) % 5) - 2;
+  s.grade = fortyTwo ? 20 : clampi(score, 0, 19);
+  s.foodSeen = produced;
+}
+
+void renderCopie(Band& b) {
+  paper(b, 9);
+  float t = (s.now - s.copieStart) / 1000.f;
+  KDColor ink = rgb(k_ink), red = rgb(k_red);
+  hand(b, "Contr\xC3\xB4le surprise", 44, 4, ink, Large, 70);
+  hand(b, "Nom : moi", 44, 26, ink, Small, 71);
+  int n = s.commentCount;
+  float lineTime = 0.45f;
+  float correctionsAt = 0.4f + n * lineTime + 0.2f;
+  for (int i = 0; i < n; i++) {
+    const Comment& c = s.comments[i];
+    int y = 46 + i * 29;
+    float start = 0.3f + i * lineTime;
+    if (t < start) {
+      break;
+    }
+    char lineText[64];
+    Str l(lineText, sizeof(lineText));
+    l.add(c.input).add(" = ").add(c.output);
+    int count = static_cast<int>((t - start) * 45);
+    hand(b, lineText, 46, y, ink, Small, 80 + i, Align::Left, count);
+    float ct = t - (correctionsAt + i * 0.55f);
+    if (ct > 0) {
+      int count2 = static_cast<int>(ct * 50);
+      hand(b, c.note, 50, y + 13, red, Small, 90 + i, Align::Left, count2);
+      // tick or cross in the margin
+      float k = ct * 4 > 1 ? 1 : ct * 4;
+      if (c.good) {
+        pen(b, 18, y + 8, 18 + 4 * k, y + 12 * k, 2, red, 100 + i);
+        if (k >= 1) {
+          pen(b, 22, y + 12, 30, y - 2, 2, red, 110 + i);
+        }
+      } else {
+        pen(b, 17, y, 17 + 12 * k, y + 12 * k, 2, red, 120 + i);
+        if (k >= 1) {
+          pen(b, 29, y, 17, y + 12, 2, red, 130 + i);
+        }
+      }
+    }
+  }
+  float gt = t - (correctionsAt + n * 0.55f + 0.2f);
+  if (gt > 0) {
+    char grade[16];
+    Str g(grade, sizeof(grade));
+    g.addInt(s.grade).add("/20");
+    bigHand(b, grade, 270, 14, 1, red, 140, Align::Center);
+    penCircle(b, 270, 24, 34, 15, 2, red, 141, gt * 2.5f, 1.2f);
+    if (gt > 0.6f) {
+      const char* verdict =
+          s.grade < 8    ? "Catastrophe. Sign\xC3\xA9 : le prof."
+          : s.grade < 12 ? "Peut mieux faire. Kevin aussi."
+          : s.grade < 16 ? "Bien. Mais je te surveille."
+          : s.grade < 20 ? "Excellent. Trop excellent. Suspect."
+                         : "20/20 pour la r\xC3\xA9\x66\xC3\xA9rence. Bravo.";
+      int c2 = static_cast<int>((gt - 0.6f) * 40);
+      hand(b, verdict, 300, 226, red, Small, 142, Align::Right, c2);
+    }
+  }
+  if (n == 0) {
+    hand(b, "Copie blanche.", 160, 100, ink, Large, 150, Align::Center);
+    if (t > 0.8f) {
+      bigHand(b, "0/20", 160, 140, 2, red, 151, Align::Center);
+    }
+    if (t > 1.4f) {
+      hand(b, "Fais des calculs dans Calculs, je corrige.", 160, 196, red,
+           Small, 152, Align::Center);
+    }
+  }
+}
