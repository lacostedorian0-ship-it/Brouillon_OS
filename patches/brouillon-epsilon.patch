+void brightness(int dir) {
+  constexpr int k_step = Ion::Backlight::MaxBrightness /
+                         GlobalPreferences::NumberOfBrightnessStates;
+  int v = s.userBrightness + dir * k_step;
+  v = clampi(v, k_step, Ion::Backlight::MaxBrightness);
